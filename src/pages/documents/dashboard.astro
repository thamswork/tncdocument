import { getDocumentIndex, getDocumentTypes, getDocumentSearchText } from '../../lib/documents';
const user = Astro.locals.user;
const [rows, allDocTypes, searchText] = await Promise.all([getDocumentIndex(), getDocumentTypes(), getDocumentSearchText()]);

// ── Build a compact, fully-linked index of every active document ──────────
// Documents form chains: Quotation → installment Invoice → (sometimes another
// Invoice) → Tax Invoice. Every doc is its own row and knows its parent, its
// tax invoice(s), its inherited job name and its line-item text for search.
const byId: Record<string, any> = {};
for (const d of rows) byId[d.id] = d;
const kids: Record<string, any[]> = {};
for (const d of rows) {
  if (d.source_document_id && byId[d.source_document_id]) (kids[d.source_document_id] ||= []).push(d);
}
function ancestors(d: any) {
  const out: any[] = [];
  let cur = d; let guard = 0;
  while (cur?.source_document_id && byId[cur.source_document_id] && guard++ < 10) {
    cur = byId[cur.source_document_id];
    out.push(cur);
  }
  return out; // nearest parent first
}
// True if a tax invoice exists anywhere below this doc (IV → re-issued IV → TX).
function hasTxBelow(d: any, guard = 0): boolean {
  if (guard > 10) return false;
  return (kids[d.id] || []).some((k: any) => k.document_types?.code === 'TAX_INVOICE' || hasTxBelow(k, guard + 1));
}

// One plain-language state per document:
//   todo    – invoice with no tax invoice yet (money not received)
//   partial – quotation billed for some installments, amount left to bill
//   open    – still being worked on
//   done    – tax invoice issued / invoice paid / quotation fully billed and paid
function workflow(d: any, code: string, bill: number) {
  if (code === 'TAX_INVOICE') return d.status === 'draft' ? { ws: 'open', wl: 'ร่าง ยังไม่ออก' } : { ws: 'done', wl: 'ออกแล้ว' };
  if (code === 'INVOICE') return hasTxBelow(d) ? { ws: 'done', wl: 'ออกใบกำกับแล้ว' } : { ws: 'todo', wl: 'ค้างรับเงิน' };
  const invs = (kids[d.id] || []).filter((k: any) => k.document_types?.code === 'INVOICE');
  const total = Number(d.total_amount || 0);
  const pct = total > 0 ? Math.min(100, Math.floor(bill / total * 100)) : 0;
  if (invs.length && total - bill <= 1) {
    return invs.every((k: any) => hasTxBelow(k)) ? { ws: 'done', wl: 'เก็บเงินครบ', bp: 100 } : { ws: 'open', wl: 'วางบิลครบ รอรับเงิน', bp: 100 };
  }
  if (invs.length) return { ws: 'partial', wl: `วางบิลแล้ว ${pct}%`, bp: pct };
  return { ws: 'open', wl: 'ยังไม่วางบิล', bp: 0 };
}

const today = new Date(); today.setHours(0, 0, 0, 0);
const index = rows.map((d: any) => {
  const code = d.document_types?.code || '';
  const anc = ancestors(d);
  const parent = anc[0];
  const job = d.jobs?.name || anc.map((a: any) => a.jobs?.name).find(Boolean) || '';
  const txKids = (kids[d.id] || []).filter((k: any) => k.document_types?.code === 'TAX_INVOICE');
  const invKids = (kids[d.id] || []).filter((k: any) => k.document_types?.code === 'INVOICE');
  const bill = invKids.reduce((s: number, k: any) => s + Number(k.total_amount || 0), 0);
  const act = d.last_activity_at || d.updated_at;
  const idle = act ? Math.max(0, Math.floor((today.getTime() - new Date(act).getTime()) / 86400000)) : 0;
  return {
    id: d.id,
    n: d.document_number || '',
    t: code,
    tn: d.document_types?.name_th || code,
    s: d.status,
    st: d.status === 'stale' ? idle : 0,
    d: d.issue_date || '',
    ca: d.created_at || '',
    a: Number(d.total_amount || 0),
    pbv: Number(d.price_before_vat || 0),
    wht: d.apply_wht !== false,
    bill,
    cid: d.customer_id || 'none',
    c: d.customers?.company_name || 'ไม่ระบุลูกค้า',
    cc: d.customers?.customer_code || '',
    tid: d.customers?.tax_id || '',
    j: job,
    pc: (d.payment_condition || '').split('\n')[0].trim(),
    po: d.reference_po || '',
    no: (d.notes || '').slice(0, 300),
    by: d.tnc_users?.full_name || '',
    it: (searchText[d.id] || '').slice(0, 2000),
    p: parent ? { id: parent.id, n: parent.document_number } : null,
    tx: txKids.map((k: any) => ({ id: k.id, n: k.document_number })),
    ...workflow(d, code, bill),
  };
});

const typeCodes = allDocTypes.map((t: any) => ({ code: t.code, name: t.name_th }));
for (const d of index) if (d.t && !typeCodes.some((t: any) => t.code === d.t)) typeCodes.push({ code: d.t, name: d.tn });

// Escape "<" so document text can never break out of the JSON <script> block.
const dataJson = JSON.stringify({ docs: index, types: typeCodes }).replace(/</g, '\\u003c');
