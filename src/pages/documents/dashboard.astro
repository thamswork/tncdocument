import { getDocumentIndex, getDocumentTypes } from '../../lib/documents';
const user = Astro.locals.user;
const [rows, allDocTypes] = await Promise.all([getDocumentIndex(), getDocumentTypes()]);

// ── Build a compact, fully-linked index of EVERY active document ──────────
// Documents form chains: Quotation → installment Invoice → (sometimes another
// Invoice) → Tax Invoice. The old dashboard only nested ONE level under a
// top-level doc and only loaded 50 rows, so tax invoices issued from an
// installment invoice never appeared anywhere. Here every doc is its own row,
// and knows its parent, its root, its tax invoice(s) and its inherited job name.
const byId: Record<string, any> = {};
for (const d of rows) byId[d.id] = d;
const kids: Record<string, any[]> = {};
for (const d of rows) {
  if (d.source_document_id && byId[d.source_document_id]) {
    (kids[d.source_document_id] ||= []).push(d);
  }
}
function ancestors(d: any) {
  const out: any[] = [];
  let cur = d; let guard = 0;
  while (cur?.source_document_id && byId[cur.source_document_id] && guard++ < 10) {
    cur = byId[cur.source_document_id];
    out.push(cur);
  }
  return out; // nearest parent first
}

// Depth-first order (roots newest first, children oldest first) — used by the
// "by customer" view so a quotation is always followed by its own installments
// and tax invoices, correctly indented.
const order: Record<string, number> = {};
let ordN = 0;
const roots = rows.filter((d: any) => !d.source_document_id || !byId[d.source_document_id]);
function walk(d: any, guard = 0) {
  if (order[d.id] !== undefined || guard > 10) return;
  order[d.id] = ordN++;
  const ch = (kids[d.id] || []).slice().sort((a: any, b: any) => (a.created_at || '').localeCompare(b.created_at || ''));
  for (const c of ch) walk(c, guard + 1);
}
for (const r of roots) walk(r);
for (const d of rows) if (order[d.id] === undefined) order[d.id] = ordN++;

// True if a tax invoice exists anywhere below this doc (e.g. IV → re-issued IV → TX),
// so an invoice that was superseded by a re-issue isn't flagged "needs TX" too.
function hasTxBelow(d: any, guard = 0): boolean {
  if (guard > 10) return false;
  return (kids[d.id] || []).some((k: any) => k.document_types?.code === 'TAX_INVOICE' || hasTxBelow(k, guard + 1));
}

function statusGroup(s: string) {
  if (s === 'published') return 'published';
  if (s === 'stale') return 'stale';
  return 'active';
}

// One plain-language "where is this job at" state per document, replacing the
// technical draft/published/in_progress labels on the dashboard:
//   todo  – invoice with no tax invoice yet (needs action)
//   open  – quotation still being billed / document still being worked on
//   stale – untouched 5+ days and not finished
//   done  – tax invoice issued, invoice paid (has TX), or quotation fully billed & taxed
function workflow(d: any, code: string) {
  if (code === 'TAX_INVOICE') {
    return d.status === 'draft' ? { ws: 'open', wl: 'ร่าง ยังไม่ออก' } : { ws: 'done', wl: 'ออกใบกำกับแล้ว' };
  }
  if (code === 'INVOICE') {
    return hasTxBelow(d) ? { ws: 'done', wl: 'ออกใบกำกับแล้ว' } : { ws: 'todo', wl: 'รอออกใบกำกับภาษี' };
  }
  const invs = (kids[d.id] || []).filter((k: any) => k.document_types?.code === 'INVOICE');
  const total = Number(d.total_amount || 0);
  const billed = invs.reduce((s: number, k: any) => s + Number(k.total_amount || 0), 0);
  const pct = total > 0 ? Math.min(100, Math.round(billed / total * 100)) : 0;
  if (invs.length && pct >= 100 && invs.every((k: any) => hasTxBelow(k))) return { ws: 'done', wl: 'เก็บเงินครบแล้ว', bp: 100 };
  if (invs.length) return { ws: d.status === 'stale' && pct < 100 ? 'stale' : 'open', wl: `เรียกเก็บแล้ว ${pct}%`, bp: pct };
  if (d.status === 'stale') return { ws: 'stale', wl: 'ค้างนาน', bp: 0 };
  return { ws: 'open', wl: 'กำลังดำเนินการ', bp: 0 };
}

const index = rows.map((d: any) => {
  const code = d.document_types?.code || '';
  const anc = ancestors(d);
  const parent = anc[0];
  const root = anc.length ? anc[anc.length - 1] : d;
  const job = d.jobs?.name || anc.map((a: any) => a.jobs?.name).find(Boolean) || '';
  const txKids = (kids[d.id] || []).filter((k: any) => k.document_types?.code === 'TAX_INVOICE');
  const invKids = (kids[d.id] || []).filter((k: any) => k.document_types?.code !== 'TAX_INVOICE');
  return {
    id: d.id,
    n: d.document_number || '',
    t: code,
    tn: d.document_types?.name_th || code,
    s: d.status,
    sg: statusGroup(d.status),
    d: d.issue_date || '',
    ca: d.created_at || '',
    a: Number(d.total_amount || 0),
    cid: d.customer_id || 'none',
    c: d.customers?.company_name || 'ไม่ระบุลูกค้า',
    cc: d.customers?.customer_code || '',
    j: job,
    pc: (d.payment_condition || '').split('\n')[0].trim(),
    by: d.tnc_users?.full_name || '',
    p: parent ? { id: parent.id, n: parent.document_number } : null,
    r: root.id,
    dep: anc.length,
    tx: txKids.map((k: any) => ({ id: k.id, n: k.document_number })),
    ni: invKids.length,
    needTx: code === 'INVOICE' && !hasTxBelow(d),
    o: order[d.id],
    ...workflow(d, code),
  };
});

const typeCodes = allDocTypes.map((t: any) => ({ code: t.code, name: t.name_th }));
for (const d of index) if (d.t && !typeCodes.some((t: any) => t.code === d.t)) typeCodes.push({ code: d.t, name: d.tn });

// Escape "<" so document text can never break out of the JSON <script> block.
const dataJson = JSON.stringify({ docs: index, types: typeCodes }).replace(/</g, '\\u003c');
