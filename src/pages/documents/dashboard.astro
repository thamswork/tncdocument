---
import { getDocuments, getDocumentTypes } from '../../lib/documents';
import { Fragment } from 'astro/jsx-runtime'; // v2
const user = Astro.locals.user;
const { data: documents, count: totalCount } = await getDocuments({ limit: 50 });
const allDocTypes = await getDocumentTypes();
const linkedMap: Record<string, any[]> = {};
for (const doc of documents) {
  if (doc.source_document_id) {
    if (!linkedMap[doc.source_document_id]) linkedMap[doc.source_document_id] = [];
    linkedMap[doc.source_document_id].push(doc);
  }
}

const visibleDocs = documents.filter((d: any) => !d.source_document_id);
const total = visibleDocs.length;
// 'draft' (legacy) and 'in_progress' (current) are the same working state from the
// user's point of view — no more separate draft/publish gate as of this session's
// lifecycle change. Grouped together everywhere so old and new documents behave
// identically instead of old ones silently falling into an unrecognized bucket.
const active = visibleDocs.filter((d: any) => d.status === 'draft' || d.status === 'in_progress').length;
const published = visibleDocs.filter((d: any) => d.status === 'published').length;
const stale = visibleDocs.filter((d: any) => d.status === 'stale').length;
const pendingAmt = documents
  .filter((d: any) => d.status === 'draft' || d.status === 'in_progress')
  .reduce((s: number, d: any) => s + (Number(d.total_amount)||0), 0);
const pendingFmt = pendingAmt.toLocaleString('th-TH', {minimumFractionDigits:0, maximumFractionDigits:0});

// Single source of truth for status label/styling — used by both server-rendered
// rows below AND mirrored in the client-side loadMore() JS. If you add a new
// status value, update BOTH this function and its JS twin near loadMore().
function statusInfo(status: string) {
  if (status === 'published') return { label: 'เผยแพร่แล้ว', cls: 'published' };
  if (status === 'stale') return { label: 'ค้างนาน', cls: 'stale' };
  return { label: 'กำลังดำเนินการ', cls: 'active' }; // draft, in_progress, or anything unrecognized
}
function statusGroup(status: string) {
  if (status === 'published') return 'published';
  if (status === 'stale') return 'stale';
  return 'active';
}
const docTypes = [...new Set(documents.map((d: any) => d.document_types?.code).filter(Boolean))];
const hasMore = (totalCount || 0) > documents.length;
const typeLabels: Record<string,string> = {QUOTATION:'ใบเสนอราคา',INVOICE:'ใบแจ้งหนี้',TAX_INVOICE:'ใบกำกับภาษี',BOQ:'BOQ'};

// Group top-level documents by customer — documents already arrive sorted by
// date desc, so the first doc encountered per customer is their most recent,
// which we use to order the customer groups themselves (most active first).
const customerGroups: Record<string, any> = {};
for (const doc of visibleDocs) {
  const cid = doc.customer_id || 'unknown';
  if (!customerGroups[cid]) {
    customerGroups[cid] = {
      id: cid,
      name: doc.customers?.company_name || 'ไม่ระบุลูกค้า',
      code: doc.customers?.customer_code || '',
      docs: [] as any[],
      total: 0,
      latestDate: doc.issue_date || '',
    };
  }
  customerGroups[cid].docs.push(doc);
  customerGroups[cid].total += Number(doc.total_amount || 0);
  if ((doc.issue_date || '') > customerGroups[cid].latestDate) customerGroups[cid].latestDate = doc.issue_date;
}
const groupList = Object.values(customerGroups).sort((a: any, b: any) => (b.latestDate||'').localeCompare(a.latestDate||''));
---
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
  <title>Dashboard — TNC Build Studio</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#F7F6F3;--white:#fff;--border:#E0DDD7;--b2:#ECEAE5;
      --text:#1A1814;--t2:#6B6860;--t3:#AEABA4;
      --gold:#C9A96E;--gbg:#FAF5EC;--gborder:#E8D5A8;
      --green:#2D7A4F;--red:#B94040;--blue:#2D5A9E;
      --sb:220px;
    }
    html{height:100%;}
    body{font-family:'Plus Jakarta Sans','Noto Sans Thai',sans-serif;background:var(--bg);color:var(--text);min-height:100%;display:flex;flex-direction:row;}

    /* ── Sidebar ── */
    .sidebar{width:var(--sb);background:var(--white);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100%;height:100dvh;z-index:200;transition:transform .25s cubic-bezier(.4,0,.2,1);}
    .sb-brand{padding:20px 20px 16px;border-bottom:1px solid var(--b2);}
    .sb-brand-name{font-size:13px;font-weight:700;letter-spacing:.04em;}
    .sb-brand-sub{font-size:10px;color:var(--t3);letter-spacing:.06em;text-transform:uppercase;margin-top:1px;}
    .sb-user{padding:14px 20px;border-bottom:1px solid var(--b2);}
    .sb-user-name{font-size:12.5px;font-weight:600;}
    .sb-user-role{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-top:1px;}
    .sb-nav{padding:12px 0;flex:1;overflow-y:auto;}
    .sb-section{font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--t3);padding:8px 20px 4px;}
    .sb-link{display:flex;align-items:center;gap:10px;padding:11px 20px;font-size:13px;color:var(--t2);text-decoration:none;transition:background .12s;border-left:2px solid transparent;-webkit-tap-highlight-color:transparent;}
    .sb-link:hover,.sb-link:active{background:var(--bg);color:var(--text);}
    .sb-link.active{background:var(--gbg);color:var(--text);font-weight:600;border-left-color:var(--gold);}
    .sb-icon{font-size:15px;width:18px;text-align:center;flex-shrink:0;}
    .sb-bottom{padding:16px 20px;border-top:1px solid var(--b2);}
    .sb-logout{width:100%;padding:10px 12px;background:transparent;border:1px solid var(--border);border-radius:4px;font-size:12px;font-family:inherit;color:var(--t2);cursor:pointer;transition:all .15s;text-align:center;-webkit-tap-highlight-color:transparent;}
    .sb-logout:hover{border-color:var(--red);color:var(--red);}

    /* ── Overlay ── */
    .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:190;-webkit-tap-highlight-color:transparent;}
    .overlay.show{display:block;}

    /* ── Main ── */
    .main{margin-left:var(--sb);flex:1;display:flex;flex-direction:column;min-width:0;min-height:100dvh;}

    /* ── Topbar ── */
    .topbar{background:var(--white);border-bottom:1px solid var(--border);padding:0 24px;height:56px;display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:100;}
    .hamburger{display:none;background:none;border:none;cursor:pointer;padding:8px;margin:-8px;flex-direction:column;justify-content:center;gap:5px;-webkit-tap-highlight-color:transparent;}
    .hamburger span{display:block;width:22px;height:2px;background:var(--text);border-radius:2px;transition:transform .2s,opacity .2s;}
    .tb-title{font-size:15px;font-weight:700;flex:1;}
    .btn{padding:9px 16px;border-radius:5px;font-size:12px;font-weight:700;font-family:inherit;cursor:pointer;border:none;letter-spacing:.04em;text-transform:uppercase;transition:all .15s;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:6px;-webkit-tap-highlight-color:transparent;min-height:40px;}
    .btn-solid{background:var(--text);color:var(--bg);}
    .btn-solid:active{opacity:.8;}
    .btn-ol{background:transparent;border:1px solid var(--border);color:var(--t2);}
    .btn-ol:active{background:var(--bg);}

    /* ── Content ── */
    .content{padding:24px;display:flex;flex-direction:column;gap:20px;flex:1;}

    /* ── Stats ── */
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
    .quick-cta-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;}
    .quick-cta{padding:10px 18px;background:var(--white);border:1.5px dashed var(--border);border-radius:8px;font-size:13px;font-weight:600;color:var(--text);text-decoration:none;transition:border-color .15s,background .15s;-webkit-tap-highlight-color:transparent;}
    .quick-cta:hover,.quick-cta:active{border-color:var(--gold);background:var(--gbg);}
    .stat-card{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:18px 20px;cursor:pointer;transition:border-color .15s,transform .15s;-webkit-tap-highlight-color:transparent;}
    .stat-card:active{transform:scale(.98);}
    .stat-card.active{background:var(--gbg);border-color:var(--gold);}
    .stat-n{font-size:32px;font-weight:300;letter-spacing:-.03em;line-height:1;}
    .stat-n.gold{color:var(--gold);}
    .stat-label{font-size:10.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--t3);margin-top:6px;}
    .stat-sub{font-size:11px;color:var(--t3);margin-top:2px;}
    .stat-pending{font-size:11px;color:var(--gold);margin-top:5px;font-weight:600;}

    /* ── Table card ── */
    .table-card{background:var(--white);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
    .table-toolbar{padding:14px 18px;border-bottom:1px solid var(--b2);display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    .tb-info{flex:1;min-width:120px;}
    .tb-info-title{font-size:13px;font-weight:600;}
    .tb-info-sub{font-size:11px;color:var(--t3);margin-top:1px;}

    /* Search */
    .search-wrap{position:relative;}
    .search-ico{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--t3);font-size:13px;pointer-events:none;}
    .search-inp{padding:8px 10px 8px 32px;background:var(--bg);border:1.5px solid var(--border);border-radius:5px;font-size:13px;font-family:inherit;color:var(--text);outline:none;transition:border-color .2s;width:200px;}
    .search-inp:focus{border-color:var(--text);}
    .search-inp::placeholder{color:var(--t3);}

    /* Filters */
    .filters{display:flex;gap:6px;align-items:center;}
    .filter-pill{padding:6px 14px;border-radius:20px;font-size:11.5px;font-weight:600;font-family:inherit;cursor:pointer;border:1.5px solid var(--border);background:transparent;color:var(--t2);transition:all .12s;white-space:nowrap;-webkit-tap-highlight-color:transparent;min-height:36px;}
    .filter-pill:active{opacity:.7;}
    .filter-pill.active{background:var(--text);border-color:var(--text);color:var(--bg);}
    .filter-pill.draft.active{background:#6B5B2E;border-color:#6B5B2E;color:#fff;}
    .filter-pill.published.active{background:var(--green);border-color:var(--green);color:#fff;}

    /* Table */
    .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .tbl{width:100%;border-collapse:collapse;min-width:600px;}
    .tbl thead th{padding:10px 14px;font-size:9.5px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.09em;text-align:left;border-bottom:1px solid var(--b2);background:var(--bg);white-space:nowrap;cursor:pointer;user-select:none;}
    .tbl thead th.num{text-align:right;}
    .tbl tbody tr{border-bottom:1px solid var(--b2);cursor:pointer;transition:background .1s;-webkit-tap-highlight-color:transparent;}
    .tbl tbody tr:last-child{border-bottom:none;}
    .tbl tbody tr:hover,.tbl tbody tr:active{background:var(--gbg);}
    .tbl tbody tr.hidden{display:none;}
    .tbl td{padding:13px 14px;font-size:13px;vertical-align:middle;}
    .tbl td.num{text-align:right;font-variant-numeric:tabular-nums;}

    .doc-num{font-weight:700;font-size:13px;letter-spacing:.01em;}
    .badge{display:inline-flex;padding:3px 8px;border-radius:4px;font-size:9.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
    .badge-SV,.badge-QUOTATION{background:#EBF0FA;color:#2D5A9E;}
    .badge-IV,.badge-INVOICE{background:#EBF5EE;color:#2D7A4F;}
    .badge-TX,.badge-TAX_INVOICE{background:#F5EBEB;color:#B94040;}
    .badge-BQ,.badge-BOQ{background:var(--gbg);color:#8B6914;}
    .badge-default{background:var(--b2);color:var(--t2);}

    .status{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;}
    .sdot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
    .status-active .sdot{background:var(--t3);}
    .status-active{color:var(--t2);}
    .status-published .sdot{background:var(--green);}
    .status-published{color:var(--green);}
    .status-stale .sdot{background:#C9822D;}
    .status-stale{color:#C9822D;}

    .amt{font-weight:600;font-variant-numeric:tabular-nums;}
    .open-btn{color:var(--t3);font-size:12px;text-decoration:none;padding:6px 10px;border-radius:4px;transition:all .15s;white-space:nowrap;display:inline-block;-webkit-tap-highlight-color:transparent;}
    .open-btn:hover,.open-btn:active{color:var(--text);background:var(--b2);}

    .empty-row td{padding:48px 20px;text-align:center;color:var(--t3);}
    .empty-row-title{font-size:14px;font-weight:600;color:var(--t2);margin-bottom:4px;}
    .result-count{font-size:11px;color:var(--t3);padding:8px 18px;border-top:1px solid var(--b2);text-align:right;}
    .kbd{display:inline-block;background:var(--b2);border:1px solid var(--border);border-radius:3px;padding:1px 5px;font-size:9.5px;color:var(--t2);font-family:monospace;}

    /* ── Customer group headers ── */
    .cust-header{background:var(--bg);cursor:pointer;-webkit-tap-highlight-color:transparent;}
    .cust-header:hover{background:var(--b2);}
    .cust-header td{padding:11px 18px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
    .cust-header-inner{display:flex;align-items:center;gap:10px;}
    .cust-chevron{font-size:11px;color:var(--t3);width:12px;flex-shrink:0;transition:transform .15s;}
    .cust-avatar{width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,#C9A96E,#a8824f);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;}
    .cust-name{font-size:13px;font-weight:700;color:var(--text);}
    .cust-code{font-size:10.5px;font-family:monospace;color:var(--t3);background:var(--white);border:1px solid var(--border);border-radius:4px;padding:1px 6px;}
    .cust-meta{font-size:11px;color:var(--t2);margin-left:auto;}
    .cust-total{font-size:12.5px;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums;min-width:110px;text-align:right;}
    .expand-all-btn{padding:7px 14px;background:transparent;border:1px solid var(--border);border-radius:6px;font-size:11.5px;font-family:inherit;color:var(--t2);cursor:pointer;white-space:nowrap;}
    .expand-all-btn:hover{border-color:var(--text);color:var(--text);}

    /* ── Mobile ── */
    @media(max-width:768px){
      body{display:block;}
      .sidebar{transform:translateX(-100%);}
      .sidebar.open{transform:translateX(0);}
      .main{margin-left:0;}
      .hamburger{display:flex;}
      .topbar{padding:0 16px;gap:8px;}
      .tb-title{font-size:14px;}
      .btn{padding:8px 12px;font-size:11px;}
      .content{padding:16px;}
      .stats{grid-template-columns:1fr 1fr;}
      .stat-card{padding:14px 16px;}
      .stat-card:first-child{grid-column:1/-1;}
      .stat-n{font-size:26px;}
      .table-toolbar{flex-direction:column;align-items:stretch;gap:8px;padding:12px 14px;}
      .search-inp{width:100%!important;}
      .filters{overflow-x:auto;flex-wrap:nowrap;padding-bottom:2px;-webkit-overflow-scrolling:touch;}
      .tbl td{padding:12px 10px;font-size:12px;}
      .tbl thead th{padding:8px 10px;font-size:9px;}
      .tbl th:nth-child(7),.tbl td:nth-child(7){display:none;}
      .result-count{padding:6px 14px;}
      .kbd-hint{display:none;}
    }
    @media(max-width:480px){
      .stats{grid-template-columns:1fr;}
      .stat-card:first-child{grid-column:auto;}
      .tbl th:nth-child(2),.tbl td:nth-child(2){display:none;}
      .tbl th:nth-child(6),.tbl td:nth-child(6){display:none;}
      .tbl th:nth-child(5),.tbl td:nth-child(5){display:none;}
      /* make rows more tappable */
      .tbl td{padding:14px 10px;}
      .tbl tr{cursor:pointer;}
      .content{padding:12px;}
    }
  </style>
</head>
<body>

<div class="overlay" id="overlay"></div>

<nav class="sidebar" id="sidebar">
  <div class="sb-brand">
    <div class="sb-brand-name">TNC BUILD STUDIO</div>
    <div class="sb-brand-sub">ระบบเอกสาร</div>
  </div>
  <div class="sb-user">
    <div class="sb-user-name">{user.full_name}</div>
    <div class="sb-user-role">{user.role}</div>
  </div>
  <div class="sb-nav">
    <div class="sb-section">เมนูหลัก</div>
    <a href="/documents/dashboard" class="sb-link active"><span class="sb-icon">⊞</span> หน้าหลัก</a>
    <a href="/documents/new" class="sb-link"><span class="sb-icon">✦</span> สร้างเอกสารใหม่</a>
    <a href="/documents/customers" class="sb-link"><span class="sb-icon">◎</span> รายชื่อลูกค้า</a>
    <a href="/documents/jobs" class="sb-link"><span class="sb-icon">▤</span> จัดการงาน</a>
    {user.role === 'superadmin' && <a href="/documents/users" class="sb-link"><span class="sb-icon">◈</span> จัดการผู้ใช้งาน</a>}
    <a href="/documents/logs" class="sb-link"><span class="sb-icon">≡</span> ประวัติการส่งออก</a>
  </div>
  <div class="sb-bottom">
    <form method="POST" action="/documents/logout">
      <button type="submit" class="sb-logout">ออกจากระบบ</button>
    </form>
  </div>
</nav>

<div class="main">
  <div class="topbar">
    <button class="hamburger" id="hamburger" aria-label="เมนู">
      <span></span><span></span><span></span>
    </button>
    <div class="tb-title">ภาพรวมเอกสาร</div>
    <span class="kbd-hint" style="font-size:11px;color:var(--t3);">กด <span class="kbd">/</span> ค้นหา</span>
    <a href="/documents/customers/new" class="btn btn-ol">+ ลูกค้าใหม่</a>
    <a href="/documents/new" class="btn btn-solid">+ สร้างเอกสาร</a>
  </div>

  <div class="content">
    <div class="quick-cta-row">
      {allDocTypes.map((dt: any) => (
        <a href={`/documents/new?type=${dt.code}`} class="quick-cta">+ {dt.name_th}</a>
      ))}
    </div>

    <div class="stats">
      <div class="stat-card active" id="stat-all" onclick="window.filterStatus('')">
        <div class="stat-n gold">{total}</div>
        <div class="stat-label">ทั้งหมด</div>
        <div class="stat-sub">ในระบบ</div>
      </div>
      <div class="stat-card" id="stat-active" onclick="window.filterStatus('active')">
        <div class="stat-n">{active}</div>
        <div class="stat-label">กำลังดำเนินการ</div>
        <div class="stat-sub">ยังไม่เผยแพร่</div>
        {pendingAmt > 0 && <div class="stat-pending">฿{pendingFmt} รอยืนยัน</div>}
      </div>
      <div class="stat-card" id="stat-published" onclick="window.filterStatus('published')">
        <div class="stat-n">{published}</div>
        <div class="stat-label">เผยแพร่แล้ว</div>
        <div class="stat-sub">ออกเอกสารแล้ว</div>
      </div>
      <div class="stat-card" id="stat-stale" onclick="window.filterStatus('stale')">
        <div class="stat-n" style="color:#C9822D;">{stale}</div>
        <div class="stat-label">ค้างนาน</div>
        <div class="stat-sub">ไม่มีความเคลื่อนไหว 5+ วัน</div>
      </div>
    </div>

    <div class="table-card">
      <div class="table-toolbar">
        <div class="tb-info">
          <div class="tb-info-title">เอกสารทั้งหมด</div>
          <div class="tb-info-sub">แตะที่แถวเพื่อเปิดเอกสาร</div>
        </div>
        <div class="search-wrap">
          <span class="search-ico">🔍</span>
          <input type="text" class="search-inp" id="searchInp"
            placeholder="ค้นหา..."
            oninput="window.doSearch(this.value)"
            autocomplete="off"/>
        </div>
        <div class="filters" id="typeFilters">
          <button class="filter-pill active" data-type="" onclick="window.filterType(this,'')">ทั้งหมด</button>
          {docTypes.map((code: any) => <button class="filter-pill" data-type={code} onclick={`window.filterType(this,'${code}')`}>{typeLabels[code]||code}</button>)}
        </div>
        <div class="filters" id="statusFilters">
          <button class="filter-pill active" data-status="" onclick="window.filterStatus('')">ทุกสถานะ</button>
          <button class="filter-pill draft" data-status="active" onclick="window.filterStatus('active')">กำลังดำเนินการ</button>
          <button class="filter-pill published" data-status="published" onclick="window.filterStatus('published')">เผยแพร่แล้ว</button>
          <button class="filter-pill" data-status="stale" onclick="window.filterStatus('stale')" style="color:#C9822D;border-color:#E8C99B;">ค้างนาน</button>
        </div>
        <button class="expand-all-btn" id="expandAllBtn" onclick="window.toggleAllGroups()">ยุบทั้งหมด</button>
      </div>

      <div class="tbl-wrap">
        <table class="tbl" id="docTable">
          <thead>
            <tr>
              <th onclick="window.sortBy('num')">เลขที่เอกสาร <span id="sort-num"></span></th>
              <th>ประเภท</th>
              <th onclick="window.sortBy('cust')">ชื่อลูกค้า <span id="sort-cust"></span></th>
              <th onclick="window.sortBy('date')">วันที่ออก <span id="sort-date">↓</span></th>
              <th class="num" onclick="window.sortBy('amt')">ยอดรวม (บาท) <span id="sort-amt"></span></th>
              <th>สถานะ</th>
              <th>ผู้สร้าง</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="docTbody">
            {groupList.map((g: any) => {
              const totalFmt = g.total.toLocaleString('th-TH', {minimumFractionDigits:2, maximumFractionDigits:2});
              return (
                <Fragment>
                  <tr class="cust-header" data-cust-id={g.id} data-cust-name={g.name} onclick={`toggleCustomerGroup('${g.id}')`}>
                    <td colspan="8">
                      <div class="cust-header-inner">
                        <span class="cust-chevron" id={`chev-${g.id}`}>▾</span>
                        <span class="cust-avatar">{(g.name||'?').charAt(0).toUpperCase()}</span>
                        <span class="cust-name">{g.name}</span>
                        {g.code && <span class="cust-code">{g.code}</span>}
                        <span class="cust-meta">{g.docs.length} เอกสาร</span>
                        <span class="cust-total" id={`tot-${g.id}`} data-total={g.total}>฿{totalFmt}</span>
                      </div>
                    </td>
                  </tr>
                  {g.docs.map((doc: any) => {
                    const typeCode = doc.document_types?.code || '';
                    const custName = doc.customers?.company_name || '-';
                    const issueDate = doc.issue_date ? new Date(doc.issue_date).toLocaleDateString('th-TH', {day:'numeric',month:'short',year:'numeric'}) : '-';
                    const amt = Number(doc.total_amount||0).toLocaleString('th-TH', {minimumFractionDigits:2, maximumFractionDigits:2});
                    const rawAmt = Number(doc.total_amount||0);
                    const issuedBy = doc.tnc_users?.full_name || '-';
                    const hasLinked = linkedMap[doc.id]?.length > 0;
                    return (
                      <Fragment>
                        <tr onclick={`window.location.href='/documents/${doc.id}'`}
                          data-group={g.id}
                          data-num={doc.document_number}
                          data-cust={custName}
                          data-type={typeCode}
                          data-status={doc.status}
                          data-statusgroup={statusGroup(doc.status)}
                          data-date={doc.issue_date||''}
                          data-amt={rawAmt}>
                          <td>
                            <div style="display:flex;align-items:center;gap:6px;">
                              {hasLinked && (
                                <button onclick={`event.stopPropagation();toggleLinked('${doc.id}')`}
                                  id={`exp-${doc.id}`}
                                  style="background:var(--gbg);border:1px solid var(--gborder);border-radius:3px;padding:1px 5px;font-size:10px;font-weight:700;color:#8B6914;cursor:pointer;font-family:inherit;flex-shrink:0;">
                                  {linkedMap[doc.id].length}งวด▾
                                </button>
                              )}
                              <span class="doc-num">{doc.document_number}</span>
                            </div>
                          </td>
                          <td><span class={`badge badge-${typeCode||'default'}`}>{doc.document_types?.name_th || typeCode}</span></td>
                          <td>{custName}</td>
                          <td>{issueDate}</td>
                          <td class="num"><span class="amt">{amt}</span></td>
                          <td><span class={`status status-${statusInfo(doc.status).cls}`}><span class="sdot"></span>{statusInfo(doc.status).label}</span></td>
                          <td style="font-size:11.5px;color:var(--t2);">{issuedBy}</td>
                          <td><a href={`/documents/${doc.id}`} class="open-btn" onclick="event.stopPropagation()">เปิด →</a></td>
                        </tr>
                        {hasLinked && linkedMap[doc.id].map((inv: any) => (
                          <tr id={`linked-${doc.id}`}
                            data-group={g.id}
                            style="display:none;background:#FAF5EC;cursor:pointer;"
                            onclick={`window.location.href='/documents/${inv.id}'`}>
                            <td style="padding-left:32px;"><span style="color:var(--gold);margin-right:4px;font-size:11px;">↳</span><span class="doc-num" style="font-size:11.5px;">{inv.document_number}</span></td>
                            <td><span class="badge badge-INVOICE" style="font-size:10px;opacity:.8;">งวด</span></td>
                            <td style="font-size:11.5px;color:var(--t2);">{inv.payment_condition||'—'}</td>
                            <td style="font-size:11.5px;">{inv.issue_date ? new Date(inv.issue_date).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'numeric'}) : '-'}</td>
                            <td class="num"><span class="amt" style="font-size:12px;">{Number(inv.total_amount||0).toLocaleString('th-TH',{minimumFractionDigits:2})}</span></td>
                            <td><span class={`status status-${statusInfo(inv.status).cls}`}><span class="sdot"></span>{statusInfo(inv.status).label}</span></td>
                            <td></td>
                            <td><a href={`/documents/${inv.id}`} class="open-btn" onclick="event.stopPropagation()">เปิด →</a></td>
                          </tr>
                        ))}
                      </Fragment>
                    );
                  })}
                </Fragment>
              );
            })}
          </tbody>
        </table>
      </div>
      <div class="result-count" id="resultCount"></div>
      {hasMore && (
        <div style="text-align:center;padding:16px 0;" id="loadMoreWrap">
          <button onclick="loadMore()" id="loadMoreBtn"
            style="padding:9px 24px;background:var(--bg);border:1.5px solid var(--border);border-radius:6px;font-size:12.5px;font-weight:600;font-family:inherit;cursor:pointer;color:var(--t2);">
            โหลดเพิ่มเติม ({totalCount} รายการทั้งหมด)
          </button>
        </div>
      )}
    </div>
  </div>
</div>

<script is:inline>
var currentOffset = 50;
var collapsedGroups = {};

function ensureGroup(doc, tbody) {
  var gid = doc.customer_id || 'unknown';
  var header = document.querySelector('tr.cust-header[data-cust-id="'+gid+'"]');
  if (header) return { gid: gid, header: header, isNew: false };
  var custName = doc.customers?.company_name || 'ไม่ระบุลูกค้า';
  var custCode = doc.customers?.customer_code || '';
  header = document.createElement('tr');
  header.className = 'cust-header';
  header.setAttribute('data-cust-id', gid);
  header.setAttribute('data-cust-name', custName);
  header.setAttribute('onclick', "toggleCustomerGroup('"+gid+"')");
  header.innerHTML = '<td colspan="8"><div class="cust-header-inner">'+
    '<span class="cust-chevron" id="chev-'+gid+'">▾</span>'+
    '<span class="cust-avatar">'+(custName.charAt(0).toUpperCase())+'</span>'+
    '<span class="cust-name">'+custName+'</span>'+
    (custCode ? '<span class="cust-code">'+custCode+'</span>' : '')+
    '<span class="cust-meta" id="cnt-'+gid+'">0 เอกสาร</span>'+
    '<span class="cust-total" id="tot-'+gid+'" data-total="0">฿0.00</span>'+
    '</div></td>';
  tbody.appendChild(header);
  return { gid: gid, header: header, isNew: true };
}

function bumpGroupTotals(gid, amount) {
  var totEl = document.getElementById('tot-'+gid);
  var cntEl = document.getElementById('cnt-'+gid);
  if (totEl) {
    var newTotal = (parseFloat(totEl.dataset.total)||0) + amount;
    totEl.dataset.total = String(newTotal);
    totEl.textContent = '฿'+newTotal.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});
  }
  if (cntEl) {
    var n = (parseInt(cntEl.dataset.n||cntEl.textContent)||0) + 1;
    cntEl.dataset.n = String(n);
    cntEl.textContent = n+' เอกสาร';
  }
}

window.loadMore = async function() {
  var btn = document.getElementById('loadMoreBtn');
  if (btn) { btn.textContent = 'กำลังโหลด...'; btn.disabled = true; }
  try {
    var res = await fetch('/documents/api/load-more?offset='+currentOffset+'&limit=50');
    var json = await res.json();
    var tbody = document.getElementById('docTbody');
    var labelMap = {QUOTATION:'ใบเสนอราคา',INVOICE:'ใบแจ้งหนี้',TAX_INVOICE:'ใบกำกับภาษี',BOQ:'BOQ'};
    json.data.forEach(function(doc) {
      if (doc.source_document_id) return;
      var g = ensureGroup(doc, tbody);
      var typeCode = doc.document_types?.code || '';
      var custName = doc.customers?.company_name || '-';
      var issueDate = doc.issue_date ? new Date(doc.issue_date).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'numeric'}) : '-';
      var amt = Number(doc.total_amount||0).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});
      var tr = document.createElement('tr');
      tr.setAttribute('onclick',"window.location.href='/documents/"+doc.id+"'");
      tr.setAttribute('data-group', g.gid);
      tr.setAttribute('data-num',doc.document_number);
      tr.setAttribute('data-cust',custName);
      tr.setAttribute('data-type',typeCode);
      tr.setAttribute('data-status',doc.status);
      // Mirrors statusInfo()/statusGroup() in the frontmatter above — keep both in
      // sync if a new status value is ever added (see comment near those functions).
      var sGroup = doc.status==='published' ? 'published' : (doc.status==='stale' ? 'stale' : 'active');
      var sLabel = doc.status==='published' ? 'เผยแพร่แล้ว' : (doc.status==='stale' ? 'ค้างนาน' : 'กำลังดำเนินการ');
      tr.setAttribute('data-statusgroup', sGroup);
      tr.setAttribute('data-date',doc.issue_date||'');
      tr.setAttribute('data-amt',String(Number(doc.total_amount||0)));
      tr.innerHTML='<td><span class="doc-num">'+doc.document_number+'</span></td>'+
        '<td><span class="badge badge-'+typeCode+'">'+(labelMap[typeCode]||typeCode)+'</span></td>'+
        '<td>'+custName+'</td><td>'+issueDate+'</td>'+
        '<td class="num"><span class="amt">'+amt+'</span></td>'+
        '<td><span class="status status-'+sGroup+'"><span class="sdot"></span>'+sLabel+'</span></td>'+
        '<td style="font-size:11.5px;color:var(--t2);">'+(doc.tnc_users?.full_name||'-')+'</td>'+
        '<td><a href="/documents/'+doc.id+'" class="open-btn" onclick="event.stopPropagation()">เปิด →</a></td>';
      tbody.appendChild(tr);
      bumpGroupTotals(g.gid, Number(doc.total_amount||0));
    });
    currentOffset += 50;
    var wrap = document.getElementById('loadMoreWrap');
    if (currentOffset >= json.count) {
      if (wrap) wrap.style.display = 'none';
    } else {
      if (btn) { btn.textContent='โหลดเพิ่มเติม (เหลือ '+(json.count-currentOffset)+' รายการ)'; btn.disabled=false; }
    }
    applyFilters();
  } catch(e) {
    if (btn) { btn.textContent='โหลดไม่สำเร็จ — ลองอีกครั้ง'; btn.disabled=false; }
  }
};

function toggleLinked(docId) {
  var rows = document.querySelectorAll('[id="linked-'+docId+'"]');
  var btn = document.getElementById('exp-'+docId);
  var isHidden = rows.length > 0 && rows[0].style.display === 'none';
  rows.forEach(function(r) { r.style.display = isHidden ? '' : 'none'; });
  if (btn) btn.innerHTML = isHidden ? btn.innerHTML.replace('▾','▴') : btn.innerHTML.replace('▴','▾');
}

window.toggleCustomerGroup = function(gid) {
  if (collapsedGroups[gid]) delete collapsedGroups[gid]; else collapsedGroups[gid] = true;
  renderGroups();
};

window.toggleAllGroups = function() {
  var headers = document.querySelectorAll('tr.cust-header');
  var anyCollapsed = false;
  headers.forEach(function(h){ if (collapsedGroups[h.dataset.custId]) anyCollapsed = true; });
  collapsedGroups = {};
  if (!anyCollapsed) {
    headers.forEach(function(h){ collapsedGroups[h.dataset.custId] = true; });
  }
  renderGroups();
};

function renderGroups() {
  var filtering = !!(window.__searchVal || window.__typeVal || window.__statusVal);
  var anyCollapsed = false;
  document.querySelectorAll('tr.cust-header').forEach(function(header){
    var gid = header.dataset.custId;
    var groupRows = document.querySelectorAll('tr[data-group="'+gid+'"]');
    var docRows = Array.from(groupRows).filter(function(r){ return r.hasAttribute('data-num'); });
    var visibleDocRows = docRows.filter(function(r){ return !r.classList.contains('hidden'); });
    var hasMatch = visibleDocRows.length > 0;
    header.style.display = hasMatch ? '' : 'none';
    if (!hasMatch) {
      groupRows.forEach(function(r){ r.style.display = 'none'; });
      return;
    }
    var expanded = filtering ? true : !collapsedGroups[gid];
    if (!expanded) anyCollapsed = true;
    var chev = document.getElementById('chev-'+gid);
    if (chev) chev.textContent = expanded ? '▾' : '▸';
    docRows.forEach(function(r){
      r.style.display = (expanded && !r.classList.contains('hidden')) ? '' : 'none';
    });
    groupRows.forEach(function(r){
      if (r.hasAttribute('data-num')) return;
      if (!expanded) r.style.display = 'none';
    });
  });
  var expandAllBtn = document.getElementById('expandAllBtn');
  if (expandAllBtn) expandAllBtn.textContent = anyCollapsed ? 'ขยายทั้งหมด' : 'ยุบทั้งหมด';

  var totalRows = document.querySelectorAll('#docTbody tr[data-num]').length;
  var shownRows = document.querySelectorAll('#docTbody tr[data-num]:not(.hidden)').length;
  var resultEl = document.getElementById('resultCount');
  if (resultEl) resultEl.textContent = shownRows === totalRows ? 'แสดง '+totalRows+' รายการ' : 'แสดง '+shownRows+' จาก '+totalRows+' รายการ';

  var empty = document.getElementById('emptyRow');
  if (!shownRows) {
    if (!empty) {
      empty = document.createElement('tr');
      empty.id = 'emptyRow';
      empty.className = 'empty-row';
      empty.innerHTML = '<td colspan="8"><div class="empty-row-title">ไม่พบเอกสาร</div><div>ลองเปลี่ยนเงื่อนไขการค้นหา</div></td>';
      document.getElementById('docTbody').appendChild(empty);
    }
    empty.style.display = '';
  } else if (empty) {
    empty.style.display = 'none';
  }
}

// ── Sidebar toggle (must be on window scope) ──
window.toggleSidebar = function() {
  var sb = document.getElementById('sidebar');
  var ov = document.getElementById('overlay');
  sb.classList.toggle('open');
  ov.classList.toggle('show');
};
document.getElementById('hamburger').addEventListener('click', window.toggleSidebar);
document.getElementById('overlay').addEventListener('click', window.toggleSidebar);
document.querySelectorAll('.sb-link').forEach(function(l){
  l.addEventListener('click', function(){
    if(window.innerWidth <= 768) window.toggleSidebar();
  });
});

// ── Table logic ──
var searchVal='', typeVal='', statusVal='', sortCol='date', sortDir='desc';

function applyFilters(){
  window.__searchVal = searchVal; window.__typeVal = typeVal; window.__statusVal = statusVal;
  var rows = Array.from(document.querySelectorAll('#docTbody tr[data-num]'));
  var q = searchVal.toLowerCase().trim();
  rows.forEach(function(row){
    var match = (!q || (row.dataset.num||'').toLowerCase().includes(q) || (row.dataset.cust||'').toLowerCase().includes(q) || (row.dataset.type||'').toLowerCase().includes(q))
      && (!typeVal || row.dataset.type === typeVal)
      && (!statusVal || row.dataset.statusgroup === statusVal);
    row.classList.toggle('hidden', !match);
  });
  renderGroups();
}

function sortRows(){
  var tbody = document.getElementById('docTbody');
  if (sortCol === 'cust') {
    var headers = Array.from(tbody.querySelectorAll('tr.cust-header'));
    headers.sort(function(a,b){
      var va = a.dataset.custName||'', vb = b.dataset.custName||'';
      return sortDir==='asc' ? va.localeCompare(vb,'th') : vb.localeCompare(va,'th');
    });
    headers.forEach(function(h){
      tbody.appendChild(h);
      var gid = h.dataset.custId;
      document.querySelectorAll('tr[data-group="'+gid+'"]').forEach(function(r){ tbody.appendChild(r); });
    });
  } else {
    var headers2 = Array.from(tbody.querySelectorAll('tr.cust-header'));
    headers2.forEach(function(h){
      tbody.appendChild(h);
      var gid = h.dataset.custId;
      var docRows = Array.from(tbody.querySelectorAll('tr[data-group="'+gid+'"][data-num]'));
      docRows.sort(function(a,b){
        if(sortCol==='amt'){ var d=(parseFloat(a.dataset.amt)||0)-(parseFloat(b.dataset.amt)||0); return sortDir==='asc'?d:-d; }
        var va='', vb='';
        if(sortCol==='date'){va=a.dataset.date||'';vb=b.dataset.date||'';}
        else if(sortCol==='num'){va=a.dataset.num||'';vb=b.dataset.num||'';}
        return sortDir==='asc'?va.localeCompare(vb,'th'):vb.localeCompare(va,'th');
      });
      docRows.forEach(function(r){
        tbody.appendChild(r);
        var m = (r.getAttribute('onclick')||'').match(/\/documents\/([^']+)/);
        if (m) {
          document.querySelectorAll('[id="linked-'+m[1]+'"]').forEach(function(lr){ tbody.appendChild(lr); });
        }
      });
    });
  }
  ['num','cust','date','amt'].forEach(function(c){
    var el=document.getElementById('sort-'+c);
    if(!el) return;
    el.textContent = c===sortCol?(sortDir==='asc'?'↑':'↓'):'';
  });
}

window.doSearch = function(v){ searchVal=v; applyFilters(); };

window.filterType = function(el, type){
  typeVal=type;
  document.querySelectorAll('#typeFilters .filter-pill').forEach(function(b){b.classList.remove('active');});
  el.classList.add('active');
  applyFilters();
};

window.filterStatus = function(status){
  statusVal=status;
  ['all','active','published','stale'].forEach(function(s){
    var el=document.getElementById('stat-'+s);
    if(el) el.classList.toggle('active',(s==='all'&&!status)||s===status);
  });
  document.querySelectorAll('#statusFilters .filter-pill').forEach(function(b){
    b.classList.toggle('active',(b.dataset.status||'')===status);
  });
  applyFilters();
};

window.sortBy = function(col){
  if(sortCol===col){sortDir=sortDir==='asc'?'desc':'asc';}
  else{sortCol=col;sortDir=col==='amt'?'desc':'asc';}
  sortRows(); applyFilters();
};

document.addEventListener('keydown', function(e){
  var inp=document.getElementById('searchInp');
  if(e.key==='/'&&document.activeElement!==inp){e.preventDefault();inp.focus();inp.select();}
  if(e.key==='Escape'){inp.value='';inp.blur();window.doSearch('');}
});

sortRows(); applyFilters();
</script>
</body>
</html>
