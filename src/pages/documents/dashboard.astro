<!DOCTYPE html>
<html lang="th">
<head>
  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dynjnftnu/image/upload/v1781103809/LOGO_TNC-02_xhpu0t.png"/>
  <link rel="apple-touch-icon" href="https://res.cloudinary.com/dynjnftnu/image/upload/v1781103809/LOGO_TNC-02_xhpu0t.png"/>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>เอกสาร — TNC Build Studio</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#F6F5F2;--white:#fff;--border:#E3E0DA;--line:#EEECE7;
      --text:#1A1814;--t2:#66635C;--t3:#A9A69F;
      --gold:#B8955A;--gbg:#FAF6EE;
      --green:#2D7A4F;--red:#B23B3B;--amber:#B97A26;--blue:#2D5A9E;
      --sb:216px;
    }
    html{height:100%;}
    body{font-family:'Plus Jakarta Sans','Noto Sans Thai',sans-serif;background:var(--bg);color:var(--text);min-height:100%;font-size:14px;-webkit-font-smoothing:antialiased;}
    a{color:inherit;}
    button,select,input{font-family:inherit;}
    .ic{width:16px;height:16px;flex-shrink:0;}

    /* Sidebar */
    .sidebar{width:var(--sb);background:var(--white);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100dvh;z-index:200;transition:transform .25s cubic-bezier(.4,0,.2,1);}
    .sb-brand{padding:22px 22px 18px;}
    .sb-brand-name{font-size:13px;font-weight:700;letter-spacing:.06em;}
    .sb-brand-sub{font-size:11px;color:var(--t3);margin-top:2px;}
    .sb-nav{padding:6px 12px;flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:2px;}
    .sb-link{display:block;padding:9px 12px;border-radius:6px;font-size:13.5px;color:var(--t2);text-decoration:none;}
    .sb-link:hover{background:var(--bg);color:var(--text);}
    .sb-link.active{background:var(--bg);color:var(--text);font-weight:600;}
    .sb-foot{padding:16px 22px;border-top:1px solid var(--line);}
    .sb-user{font-size:13px;font-weight:600;}
    .sb-role{font-size:11px;color:var(--t3);margin-top:1px;text-transform:capitalize;}
    .sb-logout{margin-top:10px;background:none;border:none;padding:0;font-size:12.5px;color:var(--t2);cursor:pointer;text-decoration:underline;text-underline-offset:3px;}
    .sb-logout:hover{color:var(--red);}
    .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:190;}
    .overlay.show{display:block;}

    /* Page */
    .main{margin-left:var(--sb);min-height:100dvh;}
    .page{max-width:1180px;margin:0 auto;padding:28px 32px 48px;display:flex;flex-direction:column;gap:20px;}
    .head{display:flex;align-items:center;gap:12px;}
    .hamburger{display:none;background:none;border:none;cursor:pointer;padding:6px;margin-left:-6px;color:var(--text);}
    .h1{font-size:22px;font-weight:700;letter-spacing:-.01em;flex:1;}
    .btn{display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 16px;border-radius:7px;font-size:13px;font-weight:600;text-decoration:none;cursor:pointer;border:1px solid var(--border);background:var(--white);color:var(--text);white-space:nowrap;}
    .btn:hover{border-color:var(--text);}
    .btn-dark{background:var(--text);border-color:var(--text);color:var(--white);}
    .btn-dark:hover{opacity:.88;}

    /* Summary */
    .summary{display:grid;grid-template-columns:repeat(3,1fr);background:var(--white);border:1px solid var(--border);border-radius:10px;}
    .sum{padding:16px 20px;text-align:left;background:none;border:none;border-left:1px solid var(--line);cursor:pointer;color:inherit;}
    .sum:first-child{border-left:none;}
    .sum:hover .sum-v{text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px;}
    .sum-l{font-size:12px;color:var(--t2);font-weight:500;}
    .sum-v{font-size:20px;font-weight:700;margin-top:4px;font-variant-numeric:tabular-nums;letter-spacing:-.01em;}
    .sum-s{font-size:12px;color:var(--t3);margin-top:2px;}
    .sum.hot .sum-v{color:var(--red);}

    /* Search + filters */
    button:focus{outline:none;}
    button:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--text);outline-offset:2px;}
    .panel{background:var(--white);border:1px solid var(--border);border-radius:12px;position:relative;z-index:20;}
    .search{position:relative;padding:14px 14px 12px;}
    .sbox{display:flex;align-items:center;gap:8px;min-height:50px;padding:6px 8px 6px 14px;background:var(--bg);border:1px solid transparent;border-radius:10px;transition:border-color .15s,background .15s;flex-wrap:wrap;}
    .sbox:focus-within{background:var(--white);border-color:var(--text);}
    .sbox > .ic{color:var(--t3);width:18px;height:18px;}
    .q{flex:1;min-width:150px;border:none;outline:none;font-size:15.5px;color:var(--text);background:none;padding:6px 2px;}
    .q::placeholder{color:var(--t3);}
    .q::-webkit-search-cancel-button{display:none;}
    #chips{display:contents;}
    .chip{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 5px 0 11px;border-radius:15px;background:var(--text);color:var(--white);font-size:12.5px;font-weight:600;max-width:300px;}
    .chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .chip small{font-weight:400;opacity:.65;font-size:11.5px;}
    .chip button{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;flex-shrink:0;border-radius:50%;border:none;background:rgba(255,255,255,.2);color:var(--white);cursor:pointer;}
    .chip button .ic{width:10px;height:10px;}
    .icon-btn{display:none;align-items:center;justify-content:center;width:28px;height:28px;border:none;border-radius:50%;background:var(--line);color:var(--t2);cursor:pointer;flex-shrink:0;}
    .icon-btn.show{display:inline-flex;}
    .icon-btn .ic{width:12px;height:12px;}
    .sugg{display:none;position:absolute;z-index:60;left:14px;right:14px;top:calc(100% - 8px);background:var(--white);border:1px solid var(--border);border-radius:10px;box-shadow:0 14px 36px rgba(26,24,20,.13);max-height:min(460px,70vh);overflow-y:auto;padding:6px;}
    .sugg.show{display:block;}
    .sg-h{font-size:11px;font-weight:600;color:var(--t3);padding:9px 10px 4px;letter-spacing:.02em;}
    .sg{display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:7px;cursor:pointer;}
    .sg.on,.sg:hover{background:var(--bg);}
    .sg-main{flex:1;min-width:0;}
    .sg-t{font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .sg-t.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;}
    .sg-s{font-size:12px;color:var(--t3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px;}
    .sg-r{font-size:12.5px;color:var(--t2);font-variant-numeric:tabular-nums;white-space:nowrap;text-align:right;}
    .sg-r.red{color:var(--red);}
    .sg-empty{padding:14px 10px;font-size:12.5px;color:var(--t3);}
    .toolbar{display:flex;align-items:center;gap:10px;padding:0 14px 14px;flex-wrap:wrap;}
    .seg{display:inline-flex;background:var(--bg);border-radius:8px;padding:3px;gap:2px;max-width:100%;overflow-x:auto;}
    .seg button{height:30px;padding:0 12px;border:none;border-radius:6px;background:none;font-size:12.5px;font-weight:500;color:var(--t2);cursor:pointer;white-space:nowrap;}
    .seg button:hover{color:var(--text);}
    .seg button.on{background:var(--white);color:var(--text);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08);}
    .monthnav{display:inline-flex;align-items:center;background:var(--bg);border-radius:8px;height:36px;padding:3px;gap:2px;}
    .monthnav button{height:30px;width:30px;border:none;border-radius:6px;background:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;color:var(--t2);}
    .monthnav button:hover:not(:disabled){background:var(--white);color:var(--text);}
    .monthnav button:disabled{color:var(--border);cursor:default;}
    .monthnav select{height:30px;border:none;border-radius:6px;padding:0 12px;font-size:12.5px;font-weight:600;color:var(--text);background:var(--white);appearance:none;-webkit-appearance:none;cursor:pointer;text-align:center;text-align-last:center;min-width:140px;box-shadow:0 1px 2px rgba(0,0,0,.08);}
    .spacer{flex:1;}
    .reset{border:none;background:none;font-size:12.5px;color:var(--t2);cursor:pointer;text-decoration:underline;text-underline-offset:3px;display:none;}
    .reset.show{display:inline;}
    .tabs{display:flex;gap:4px;padding:0 10px;border-top:1px solid var(--line);overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .tab{position:relative;border:none;background:none;padding:13px 10px;font-size:13px;font-weight:500;color:var(--t2);cursor:pointer;white-space:nowrap;}
    .tab:hover{color:var(--text);}
    .tab.on{color:var(--text);font-weight:700;}
    .tab.on::after{content:'';position:absolute;left:10px;right:10px;bottom:-1px;height:2px;background:var(--text);border-radius:2px;}
    .tab .n{margin-left:5px;font-size:11.5px;color:var(--t3);font-weight:600;font-variant-numeric:tabular-nums;}

    /* Results */
    .results{background:var(--white);border:1px solid var(--border);border-radius:10px;overflow:hidden;}
    .res-head{display:flex;align-items:baseline;gap:14px;padding:14px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap;}
    .res-title{font-size:14px;font-weight:700;}
    .res-meta{font-size:12.5px;color:var(--t2);font-variant-numeric:tabular-nums;}
    .res-meta b{color:var(--text);font-weight:600;}
    .res-meta .sep{color:var(--line);margin:0 6px;}
    .cols,.row{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,2.1fr) 104px 130px 190px;gap:16px;align-items:start;padding:0 18px;}
    .cols{height:36px;align-items:center;border-bottom:1px solid var(--line);background:#FBFAF8;}
    .cols button,.cols span{border:none;background:none;padding:0;font-size:11.5px;font-weight:600;color:var(--t3);cursor:pointer;text-align:left;white-space:nowrap;}
    .cols .r{text-align:right;}
    .cols button.on{color:var(--text);}
    .row{padding-top:13px;padding-bottom:13px;border-bottom:1px solid var(--line);cursor:pointer;}
    .row:last-child{border-bottom:none;}
    .row:hover,.row.kb{background:#FBFAF8;}
    .row.kb{box-shadow:inset 3px 0 0 var(--text);}
    .num{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13.5px;font-weight:600;text-decoration:none;letter-spacing:-.01em;}
    .num:hover{text-decoration:underline;}
    .sub{font-size:12px;color:var(--t3);margin-top:3px;line-height:1.5;}
    .sub a{color:var(--t2);text-decoration:none;border-bottom:1px solid var(--line);}
    .sub a:hover{color:var(--text);border-color:var(--text);}
    .t-QUOTATION{color:var(--blue);} .t-INVOICE{color:var(--green);} .t-TAX_INVOICE{color:var(--red);}
    .cust{font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .job{font-size:12.5px;color:var(--t2);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .hit{font-size:12px;color:var(--t2);margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .hit i{font-style:normal;color:var(--t3);}
    .date{font-size:13px;color:var(--t2);white-space:nowrap;}
    .amt{text-align:right;font-size:14px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;}
    .amt .sub{font-weight:400;}
    .stat{display:flex;flex-direction:column;align-items:flex-start;gap:5px;}
    .sl{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:500;white-space:nowrap;}
    .dot{width:7px;height:7px;border-radius:50%;background:var(--t3);flex-shrink:0;}
    .ws-todo .dot{background:var(--red);} .ws-partial .dot{background:var(--gold);} .ws-open .dot{background:var(--t3);} .ws-done .dot{background:var(--green);}
    .ws-done .sl{color:var(--t2);}
    .age{font-size:12px;color:var(--t2);}
    .age.mid{color:var(--amber);} .age.old{color:var(--red);}
    .bar{width:120px;height:3px;background:var(--line);border-radius:2px;overflow:hidden;}
    .bar i{display:block;height:100%;background:var(--gold);}
    .act{display:inline-flex;align-items:center;height:28px;padding:0 10px;border-radius:6px;border:1px solid var(--text);font-size:12px;font-weight:600;text-decoration:none;white-space:nowrap;}
    .act:hover{background:var(--text);color:var(--white);}
    mark{background:#F6E3B0;color:inherit;border-radius:2px;padding:0 1px;}
    .empty{padding:56px 20px;text-align:center;color:var(--t2);}
    .empty-t{font-size:15px;font-weight:600;color:var(--text);margin-bottom:6px;}
    .empty .btn{margin-top:14px;}

    /* Pager */
    .pager{display:flex;align-items:center;gap:12px;padding:12px 18px;border-top:1px solid var(--line);flex-wrap:wrap;}
    .pg-info{font-size:12.5px;color:var(--t2);flex:1;font-variant-numeric:tabular-nums;}
    .pg{display:flex;gap:4px;}
    .pg button{min-width:34px;height:32px;padding:0 10px;border:1px solid var(--border);border-radius:6px;background:var(--white);font-size:12.5px;cursor:pointer;color:var(--text);font-variant-numeric:tabular-nums;}
    .pg button:hover:not(:disabled){border-color:var(--text);}
    .pg button.on{background:var(--text);border-color:var(--text);color:var(--white);font-weight:600;}
    .pg button:disabled{color:var(--t3);cursor:default;}
    .pg .gap{padding:0 4px;color:var(--t3);align-self:center;}

    /* Grouped by customer */
    .grp{border-bottom:1px solid var(--line);}
    .grp:last-child{border-bottom:none;}
    .grp-h{display:flex;align-items:center;gap:14px;padding:14px 18px;cursor:pointer;}
    .grp-h:hover{background:#FBFAF8;}
    .grp-chev{color:var(--t3);transition:transform .15s;display:inline-flex;}
    .grp.open .grp-chev{transform:rotate(90deg);color:var(--text);}
    .grp-main{flex:1;min-width:0;}
    .grp-name{font-size:14px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .grp-sub{font-size:12px;color:var(--t3);margin-top:2px;}
    .grp-fig{text-align:right;font-size:12px;color:var(--t3);white-space:nowrap;font-variant-numeric:tabular-nums;}
    .grp-fig b{display:block;font-size:14px;color:var(--text);font-weight:600;}
    .grp-fig.red b{color:var(--red);}
    .grp-body{display:none;border-top:1px solid var(--line);background:#FDFCFA;}
    .grp.open .grp-body{display:block;}
    .grp-body .row,.grp-body .cols{padding-left:46px;}
    .grp-body .cols{background:transparent;}

    @media(max-width:1100px){
      .cols,.row{grid-template-columns:minmax(0,1.2fr) minmax(0,1.8fr) 124px 170px;}
      .date,.h-date{display:none;}
    }
    @media(max-width:768px){
      .sidebar{transform:translateX(-100%);}
      .sidebar.open{transform:translateX(0);}
      .main{margin-left:0;}
      .hamburger{display:inline-flex;}
      .page{padding:16px 12px 32px;gap:14px;}
      .h1{font-size:19px;}
      .summary{grid-template-columns:1fr;}
      .sum{border-left:none;border-top:1px solid var(--line);padding:12px 16px;display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:0 12px;}
      .sum:first-child{border-top:none;}
      .sum-v{font-size:16px;margin-top:0;grid-row:1 / span 2;grid-column:2;align-self:center;}
      .sum-s{margin-top:1px;}
      .search{padding:10px;}
      .sugg{left:10px;right:10px;}
      .toolbar{padding:0 10px 10px;gap:8px;}
      #typeSeg{width:100%;} #typeSeg button{flex:1 0 auto;}
      .monthnav{flex:1;} .monthnav select{flex:1;min-width:0;}
      .spacer{display:none;}
      .cols{display:none;}
      .row{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"doc amt" "cust cust" "stat stat";gap:8px 12px;padding:14px;}
      .c-doc{grid-area:doc;} .amt{grid-area:amt;} .c-cust{grid-area:cust;} .stat{grid-area:stat;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 12px;}
      .stat .act{margin-left:auto;}
      .grp-h{padding:12px;gap:10px;}
      .grp-body .row{padding-left:14px;}
      .pager{padding:12px;}
      .pg-info{flex:1 1 100%;}
      .pg .num-btn{display:none;} .pg .num-btn.on{display:inline-block;}
      .pg .gap{display:none;}
    }
  </style>
</head>
<body>

<div class="overlay" id="overlay"></div>

<nav class="sidebar" id="sidebar">
  <div class="sb-brand">
    <div class="sb-brand-name">TNC BUILD STUDIO</div>
    <div class="sb-brand-sub">ระบบเอกสาร</div>
  </div>
  <div class="sb-nav">
    <a href="/documents/dashboard" class="sb-link active">เอกสาร</a>
    <a href="/documents/new" class="sb-link">สร้างเอกสารใหม่</a>
    <a href="/documents/customers" class="sb-link">ลูกค้า</a>
    <a href="/documents/jobs" class="sb-link">งาน</a>
    {user.role === 'superadmin' && <a href="/documents/users" class="sb-link">ผู้ใช้งาน</a>}
    <a href="/documents/logs" class="sb-link">ประวัติการใช้งาน</a>
  </div>
  <div class="sb-foot">
    <div class="sb-user">{user.full_name}</div>
    <div class="sb-role">{user.role}</div>
    <form method="POST" action="/documents/logout"><button type="submit" class="sb-logout">ออกจากระบบ</button></form>
  </div>
</nav>

<div class="main">
  <div class="page">
    <div class="head">
      <button class="hamburger" id="hamburger" aria-label="เมนู"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="width:22px;height:22px"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      <h1 class="h1">เอกสาร</h1>
      <a href="/documents/new" class="btn btn-dark">สร้างเอกสาร</a>
    </div>

    <div class="summary" id="summary">
      <button class="sum hot" data-go="todo">
        <div class="sum-l">ค้างรับเงิน</div>
        <div class="sum-v" id="sv-todo">—</div>
        <div class="sum-s" id="ss-todo"></div>
      </button>
      <button class="sum" data-go="partial">
        <div class="sum-l">ยังวางบิลไม่ครบ</div>
        <div class="sum-v" id="sv-partial">—</div>
        <div class="sum-s" id="ss-partial"></div>
      </button>
      <button class="sum" data-go="taxmonth">
        <div class="sum-l" id="sl-tax">ใบกำกับภาษีเดือนนี้</div>
        <div class="sum-v" id="sv-tax">—</div>
        <div class="sum-s" id="ss-tax"></div>
      </button>
    </div>

    <div class="panel" id="panel">
      <div class="search">
        <div class="sbox" id="sbox">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <span id="chips"></span>
          <input type="search" class="q" id="q" autocomplete="off" enterkeyhint="search" spellcheck="false"
            placeholder="ค้นหาเลขที่ ลูกค้า งาน หรือของในรายการ"/>
          <button class="icon-btn" id="qClear" aria-label="ล้างคำค้นหา"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <div class="sugg" id="sugg"></div>
      </div>
      <div class="toolbar">
        <div class="seg" id="typeSeg"></div>
        <div class="monthnav" id="monthNav">
          <button id="mPrev" aria-label="เดือนก่อนหน้า"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
          <select id="monthSel" aria-label="เดือน"></select>
          <button id="mNext" aria-label="เดือนถัดไป"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
        <span class="spacer"></span>
        <button class="reset" id="resetBtn">ล้างตัวกรอง</button>
        <div class="seg" id="viewSeg">
          <button data-v="list">รายการ</button>
          <button data-v="cust">ตามลูกค้า</button>
        </div>
      </div>
      <div class="tabs" id="tabs">
        <button class="tab" data-ws="">ทั้งหมด<span class="n"></span></button>
        <button class="tab" data-ws="todo">ค้างรับเงิน<span class="n"></span></button>
        <button class="tab" data-ws="partial">วางบิลไม่ครบ<span class="n"></span></button>
        <button class="tab" data-ws="open">ดำเนินการอยู่<span class="n"></span></button>
        <button class="tab" data-ws="done">เสร็จแล้ว<span class="n"></span></button>
      </div>
    </div>

    <div class="results" id="results">
      <div class="res-head">
        <div class="res-title" id="resTitle"></div>
        <div class="res-meta" id="resMeta"></div>
      </div>
      <div id="resBody"></div>
      <div class="pager" id="pager"></div>
    </div>
  </div>
</div>

<script type="application/json" id="docData" set:html={dataJson}></script>

<script is:inline>
(function(){
  var DATA = JSON.parse(document.getElementById('docData').textContent);
  var DOCS = DATA.docs, TYPES = DATA.types;
  var TH_M = ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
  var TH_MF = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
  var EN_M = ['jan january','feb february','mar march','apr april','may','jun june','jul july','aug august','sep sept september','oct october','nov november','dec december'];
  var TYPE_WORDS = { QUOTATION:'sv qt quotation quote ใบเสนอราคา เสนอราคา', INVOICE:'iv invoice ใบแจ้งหนี้ แจ้งหนี้ วางบิล', TAX_INVOICE:'tx tax receipt ใบกำกับ ใบกำกับภาษี ใบเสร็จ' };
  var WS_WORDS = { todo:'ค้าง ค้างรับเงิน ค้างชำระ ยังไม่จ่าย unpaid', partial:'ค้าง วางบิลไม่ครบ บางงวด partial', open:'ดำเนินการ กำลังทำ open', done:'เสร็จ เสร็จแล้ว จ่ายแล้ว paid done' };
  var PAGE = 25, GPAGE = 15;
  var SHORT = { QUOTATION:'ใบเสนอราคา', INVOICE:'ใบแจ้งหนี้', TAX_INVOICE:'ใบกำกับภาษี' };
  var X_ICON = '<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
  var CHEV = '<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>';

  // ── helpers ──────────────────────────────────────────────
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function money(n){ return Number(n||0).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function money0(n){ return Number(n||0).toLocaleString('th-TH',{maximumFractionDigits:0}); }
  function r2(n){ return Math.round(n*100+(n>=0?1:-1)*1e-9)/100; }
  function thDate(s){ if(!s) return '—'; var p=s.split('-'); if(p.length<3) return s; return (+p[2])+' '+TH_M[(+p[1])-1]+' '+((+p[0])+543); }
  function monthKey(s){ return s ? s.slice(0,7) : ''; }
  function monthLabel(k){ var p=k.split('-'); return TH_MF[(+p[1])-1]+' '+((+p[0])+543); }
  function norm(s){ return String(s||'').toLowerCase().replace(/[\u200b-\u200d\ufeff]/g,'').replace(/\s+/g,' ').trim(); }
  // spacing/punctuation/Thai-tone-mark insensitive form: "วี ฟีลด์" = "วีฟิลด" = "วีฟีลด์"
  function squash(s){ return s.replace(/[\s.,\-\/()"']+/g,'').replace(/[\u0e47-\u0e4e]/g,'').replace(/\u0e35/g,'\u0e34').replace(/\u0e37/g,'\u0e36'); }
  function ageDays(s){ if(!s) return 0; var p=s.split('-'); var t=new Date(+p[0],(+p[1])-1,+p[2]); var n=new Date(); n.setHours(0,0,0,0); return Math.max(0,Math.round((n-t)/86400000)); }
  function netOf(d){ return d.wht ? r2(d.a - r2(d.pbv*0.03)) : d.a; }
  function numAliases(n){
    var out=[]; var m=String(n||'').match(/^([A-Za-z-]+?)(\d+)(?:-(\d+))?/);
    if(m){ var num=String(parseInt(m[2],10)); out.push(m[1]+num, m[1]+' '+num, m[2]); if(m[3]) out.push(m[1]+num+'-'+m[3]); }
    return out.join(' ');
  }
  function dateWords(s){
    if(!s) return '';
    var p=s.split('-'), y=+p[0], m=+p[1], d=+p[2], be=y+543, mm=p[1], dd=p[2];
    return [s, p[0]+'-'+mm, d+'/'+m+'/'+be, dd+'/'+mm+'/'+be, d+'/'+m+'/'+String(be).slice(2), d+'/'+m, dd+'/'+mm, m+'/'+be, mm+'/'+be,
      d+' '+TH_M[m-1]+' '+be, d+' '+TH_MF[m-1]+' '+be, TH_M[m-1]+' '+be, TH_MF[m-1]+' '+be, TH_M[m-1].replace(/\./g,''), EN_M[m-1], String(be), String(y)].join(' ');
  }
  // fuzzy similarity (0..1): best bigram overlap of the query against any same-length window of the text
  function bigr(s){ var o={}, n=0; for(var i=0;i<s.length-1;i++){ var b=s.substr(i,2); o[b]=(o[b]||0)+1; n++; } return { m:o, n:n }; }
  function fuzzy(q, text){
    q = squash(norm(q)); text = squash(norm(text));
    if(q.length<3 || !text) return 0;
    var Q = bigr(q), best = 0, w = Math.min(text.length, q.length+2);
    for(var i=0;i<=Math.max(0,text.length-w);i++){
      var T = bigr(text.substr(i,w)), hit = 0;
      for(var k in Q.m){ if(T.m[k]) hit += Math.min(Q.m[k], T.m[k]); }
      var sc = Q.n+T.n ? 2*hit/(Q.n+T.n) : 0;
      if(sc>best) best = sc;
    }
    return best;
  }

  // ── search fields, built once per document ───────────────
  DOCS.forEach(function(d){
    d.age = d.ws==='todo' ? ageDays(d.d) : 0;
    d.net = netOf(d);
    var f = {
      num: norm([d.n, numAliases(d.n), d.p ? d.p.n+' '+numAliases(d.p.n) : '', d.tx.map(function(t){ return t.n+' '+numAliases(t.n); }).join(' '), d.po].join(' ')),
      cust: norm([d.c, d.cc, d.tid].join(' ')),
      job: norm([d.j, d.pc].join(' ')),
      type: norm([d.tn, d.t, TYPE_WORDS[d.t]||''].join(' ')),
      date: norm(dateWords(d.d)),
      amt: norm([money(d.a), d.a.toFixed(2), String(Math.round(d.a)), money(d.net), String(Math.round(d.net))].join(' ')),
      stat: norm([d.wl, WS_WORDS[d.ws]||'', d.s==='draft'?'ร่าง draft':'', d.st?'ไม่เคลื่อนไหว stale':'', d.by].join(' ')),
      note: norm(d.no),
      items: norm(d.it)
    };
    for(var k in f){ f[k+'_s'] = squash(f[k]); }
    d._f = f;
    d._own = norm(d.n+' '+numAliases(d.n));
  });
  var FIELD_ALIAS = { 'ลูกค้า':'cust','c':'cust','customer':'cust', 'งาน':'job','j':'job','job':'job', 'เลข':'num','เลขที่':'num','n':'num','no':'num',
    'รายการ':'items','i':'items','item':'items', 'ประเภท':'type','t':'type','type':'type', 'หมายเหตุ':'note','note':'note', 'วันที่':'date','date':'date','d':'date' };
  var MAIN_FIELDS = ['num','cust','job','type','date','amt','stat'];
  var WEIGHT = { num:6, cust:4, job:3, type:1, date:1, amt:2, stat:1, note:1, items:1 };

  // customers and jobs, for suggestions, chips and grouping
  var CUST = {}, JOBS = {};
  DOCS.forEach(function(d){
    var c = CUST[d.cid] || (CUST[d.cid] = { id:d.cid, name:d.c, code:d.cc, tid:d.tid, n:0, latest:'', todo:0, todoAmt:0 });
    c.n++; if((d.d||'') > c.latest) c.latest = d.d||'';
    if(d.ws==='todo'){ c.todo++; c.todoAmt += d.net; }
    if(d.j){
      var jk = d.j+'|'+d.cid, j = JOBS[jk] || (JOBS[jk] = { name:d.j, cid:d.cid, c:d.c, n:0, latest:'' });
      j.n++; if((d.d||'') > j.latest) j.latest = d.d||'';
    }
  });
  var CUST_L = Object.keys(CUST).map(function(k){ var c=CUST[k]; c._n = norm([c.name,c.code,c.tid].join(' ')); c._s = squash(c._n); return c; });
  var JOB_L = Object.keys(JOBS).map(function(k){ var j=JOBS[k]; j._n = norm(j.name); j._s = squash(j._n); return j; });

  function parseAmount(s){
    var m = String(s).replace(/[฿,\s]/g,'').match(/^(\d+(?:\.\d+)?)(k|m|พัน|หมื่น|แสน|ล้าน)?$/i);
    if(!m) return null;
    var mul = { k:1e3, 'พัน':1e3, 'หมื่น':1e4, 'แสน':1e5, m:1e6, 'ล้าน':1e6 }[(m[2]||'').toLowerCase()] || 1;
    return parseFloat(m[1]) * mul;
  }
  function parseQuery(q){
    var out = [], re = /(-?)(?:([^\s:"]+):)?(?:"([^"]*)"|(\S+))/g, m;
    while((m = re.exec(q))){
      var neg = m[1]==='-', field = m[2] ? FIELD_ALIAS[m[2].toLowerCase()] : null, raw = m[3]!=null ? m[3] : m[4];
      if(m[2] && !field){ raw = m[2]+':'+raw; }
      if(!raw) continue;
      var cmp = raw.match(/^([<>]=?)(.+)$/), rng = raw.match(/^(.+?)\.\.(.+)$/);
      if(cmp && parseAmount(cmp[2])!=null){ out.push({ kind:'amt', op:cmp[1], v:parseAmount(cmp[2]), neg:neg }); continue; }
      if(rng && parseAmount(rng[1])!=null && parseAmount(rng[2])!=null){ out.push({ kind:'rng', lo:parseAmount(rng[1]), hi:parseAmount(rng[2]), neg:neg }); continue; }
      var t = norm(raw).replace(/,(?=\d{3})/g,'');
      if(!t) continue;
      // squashed matching only for words, not bare numbers/dates
      out.push({ kind:'text', t:t, ts:/[^\d\s.,\-\/]/.test(t) ? squash(t) : '', field:field, neg:neg });
    }
    return out;
  }
  function inStr(v, vs, tok){
    if(!v) return false;
    if(v.indexOf(tok.t)!==-1) return true;
    if(tok.ts && tok.ts.length>1 && vs.indexOf(tok.ts)!==-1) return true;
    return v.replace(/,/g,'').indexOf(tok.t)!==-1;
  }
  function inField(d, k, tok){ return inStr(d._f[k], d._f[k+'_s'], tok); }
  // Returns null (no match) or { score, snip } for one document.
  function matchDoc(d, toks){
    var score = 0, snip = null;
    for(var i=0;i<toks.length;i++){
      var tk = toks[i], ok = false, where = null;
      if(tk.kind==='amt'){
        ok = tk.op==='>' ? d.a>tk.v : tk.op==='>=' ? d.a>=tk.v : tk.op==='<' ? d.a<tk.v : d.a<=tk.v;
      } else if(tk.kind==='rng'){
        ok = d.a>=Math.min(tk.lo,tk.hi) && d.a<=Math.max(tk.lo,tk.hi);
      } else if(tk.field){
        ok = inField(d, tk.field, tk); where = tk.field;
      } else {
        for(var j=0;j<MAIN_FIELDS.length && !ok;j++){ if(inField(d, MAIN_FIELDS[j], tk)){ ok = true; where = MAIN_FIELDS[j]; } }
        if(!ok && inField(d,'note',tk)){ ok = true; where = 'note'; }
        if(!ok && inField(d,'items',tk)){ ok = true; where = 'items'; }
      }
      if(tk.neg){ if(ok) return null; continue; }
      if(!ok) return null;
      if(where){
        score += WEIGHT[where] || 1;
        if(where==='num' && (' '+d._own).indexOf(' '+tk.t)!==-1) score += 10;
        if((where==='items' || where==='note') && !snip) snip = { from: where, t: tk.t };
      } else score += 1;
    }
    return { score: score, snip: snip };
  }
  function snippet(d, sn){
    var src = sn.from==='items' ? d.it : d.no, low = src.toLowerCase(), at = low.indexOf(sn.t);
    if(at<0) return '';
    var a = Math.max(0, at-30), b = Math.min(src.length, at+sn.t.length+50);
    return (a>0?'…':'') + src.slice(a,b) + (b<src.length?'…':'');
  }

  // ── state (mirrored in the URL so Back returns to the same view) ──
  var months = {}; DOCS.forEach(function(d){ var k=monthKey(d.d); if(k) months[k]=(months[k]||0)+1; });
  var MONTHS = Object.keys(months).sort().reverse();
  var now = new Date(), THIS_M = now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');
  var DEFAULT_M = months[THIS_M] ? THIS_M : (MONTHS[0] || 'all');
  var params = new URLSearchParams(location.search);
  var S = { q:'', type:'', ws:'', month:'', cust:'', job:'', view:'list', sort:'', dir:'desc', page:1 };
  S.q = params.get('q') || '';
  S.type = params.get('type') || '';
  S.cust = params.get('cust') || '';
  if(S.cust && !CUST[S.cust]) S.cust = '';
  S.job = params.get('job') || '';
  S.view = params.get('view')==='cust' ? 'cust' : 'list';
  S.ws = ({needtx:'todo', active:'open', published:'done', stale:'open'})[params.get('status')] || params.get('ws') || params.get('status') || '';
  if(['','todo','partial','open','done'].indexOf(S.ws)<0) S.ws='';
  S.sort = params.get('sort') || '';
  S.dir = params.get('dir') || 'desc';
  S.page = Math.max(1, parseInt(params.get('page')||'1',10) || 1);
  S.month = params.get('month') || ((S.q || S.cust || S.job || S.view==='cust' || S.ws==='todo' || S.ws==='partial') ? 'all' : DEFAULT_M);
  var monthBeforeSearch = null, openGroups = {};

  function syncUrl(){
    var p = new URLSearchParams();
    if(S.q) p.set('q',S.q);
    if(S.type) p.set('type',S.type);
    if(S.cust) p.set('cust',S.cust);
    if(S.job) p.set('job',S.job);
    if(S.ws) p.set('ws',S.ws);
    if(S.view!=='list') p.set('view',S.view);
    if(S.month!==DEFAULT_M) p.set('month',S.month);
    if(S.sort){ p.set('sort',S.sort); p.set('dir',S.dir); }
    if(S.page>1) p.set('page',S.page);
    var qs = p.toString(), url = location.pathname + (qs ? '?'+qs : '');
    history.replaceState(null,'',url);
    try{ sessionStorage.setItem('tnc_dash_url', url); }catch(e){}
  }

  // ── filtering ────────────────────────────────────────────
  function base(ignoreWs){
    var toks = parseQuery(S.q), out = [];
    for(var i=0;i<DOCS.length;i++){
      var d = DOCS[i];
      if(S.cust && d.cid!==S.cust) continue;
      if(S.job && d.j!==S.job) continue;
      if(S.type && d.t!==S.type) continue;
      if(S.month!=='all' && monthKey(d.d)!==S.month) continue;
      if(!ignoreWs && S.ws && d.ws!==S.ws) continue;
      var m = toks.length ? matchDoc(d, toks) : { score:0, snip:null };
      if(!m) continue;
      d._score = m.score; d._snip = m.snip;
      out.push(d);
    }
    return out;
  }
  function byDate(a,b){ return (a.d||'').localeCompare(b.d||'') || (a.ca||'').localeCompare(b.ca||''); }
  function sortList(list){
    var sort = S.sort || (S.q ? 'rel' : 'date');
    var dir = S.sort ? (S.dir==='asc'?1:-1) : (S.ws==='todo' ? 1 : -1);
    return list.slice().sort(function(a,b){
      if(sort==='rel') return (b._score-a._score) || -byDate(a,b);
      var r = 0;
      if(sort==='amt') r = a.a-b.a;
      else if(sort==='num') r = a.n.localeCompare(b.n,'th',{numeric:true});
      else if(sort==='cust') r = a.c.localeCompare(b.c,'th');
      else if(sort==='status') r = (a.ws+a.wl).localeCompare(b.ws+b.wl,'th');
      else r = byDate(a,b);
      return r*dir;
    });
  }

  // ── highlight ────────────────────────────────────────────
  function hl(text){
    var s = esc(text), toks = parseQuery(S.q).filter(function(t){ return t.kind==='text' && !t.neg; });
    if(!toks.length || !s) return s;
    toks.map(function(t){ return t.t; }).sort(function(a,b){ return b.length-a.length; }).forEach(function(t){
      var re = new RegExp('('+esc(t).replace(/[.*+?^${}()|[\]\\\/]/g,'\\$&')+')','gi');
      s = s.replace(/(<[^>]*>)|([^<]+)/g, function(m, tag, txt){ return tag ? tag : txt.replace(re,'<mark>$1</mark>'); });
    });
    return s;
  }

  // ── rendering ────────────────────────────────────────────
  function rowHtml(d, inGroup){
    var rel = [];
    if(d.p) rel.push('จาก <a href="/documents/'+d.p.id+'">'+hl(d.p.n)+'</a>');
    var status = '<span class="sl"><span class="dot"></span>'+esc(d.wl)+'</span>', extra = '';
    if(d.ws==='todo'){
      extra = '<span class="age '+(d.age>60?'old':d.age>30?'mid':'')+'">ค้าง '+d.age+' วัน · โอนสุทธิ ฿'+money(d.net)+'</span>'+
        '<a class="act" href="/documents/'+d.id+'?tx=1">ออกใบกำกับภาษี</a>';
    } else if(d.ws==='partial'){
      extra = '<span class="bar"><i style="width:'+d.bp+'%"></i></span><span class="age">คงเหลือ ฿'+money(r2(d.a-d.bill))+'</span>';
    } else if(d.st){
      extra = '<span class="age mid">ไม่เคลื่อนไหว '+d.st+' วัน</span>';
    }
    if(d.tx.length) extra += '<span class="age sub">'+d.tx.map(function(t){ return '<a href="/documents/'+t.id+'">'+hl(t.n)+'</a>'; }).join(', ')+'</span>';
    var hit = d._snip ? '<div class="hit"><i>'+(d._snip.from==='items'?'รายการ':'หมายเหตุ')+':</i> '+hl(snippet(d, d._snip))+'</div>' : '';
    var who = inGroup
      ? '<div class="cust">'+(d.j ? hl(d.j) : '<span style="color:var(--t3);font-weight:400">ไม่ระบุงาน</span>')+'</div>'+(d.pc?'<div class="job">'+hl(d.pc)+'</div>':'')
      : '<div class="cust">'+hl(d.c)+'</div>'+(d.j?'<div class="job">'+hl(d.j)+'</div>':'');
    return '<div class="row ws-'+d.ws+'" data-id="'+d.id+'">'+
      '<div class="c-doc"><a class="num" href="/documents/'+d.id+'">'+hl(d.n)+'</a>'+
        '<div class="sub"><span class="t-'+esc(d.t)+'">'+esc(SHORT[d.t]||d.tn)+'</span>'+(rel.length?' · '+rel.join(' · '):'')+'</div></div>'+
      '<div class="c-cust">'+who+hit+'</div>'+
      '<div class="date">'+thDate(d.d)+'</div>'+
      '<div class="amt">฿'+hl(money(d.a))+'</div>'+
      '<div class="stat">'+status+extra+'</div>'+
    '</div>';
  }
  function colsHtml(inGroup){
    var cur = S.sort || (S.q ? 'rel' : 'date');
    function b(key,label,cls){ var on = cur===key; return '<button class="'+(cls||'')+(on?' on':'')+'" data-sort="'+key+'">'+label+'</button>'; }
    return '<div class="cols">'+b('num','เลขที่เอกสาร')+(inGroup ? '<span>งาน</span>' : b('cust','ลูกค้า / งาน'))+'<span class="h-date">'+b('date','วันที่')+'</span>'+b('amt','ยอดเงิน','r')+b('status','สถานะ')+'</div>';
  }
  function pagerHtml(total, per, unit){
    var pages = Math.max(1, Math.ceil(total/per));
    if(total <= per) return '';
    var from = (S.page-1)*per+1, to = Math.min(total, S.page*per), nums = [], p;
    for(p=1;p<=pages;p++){
      if(p===1 || p===pages || Math.abs(p-S.page)<=1) nums.push(p);
      else if(nums[nums.length-1]!=='gap') nums.push('gap');
    }
    return '<div class="pg-info">แสดง '+from+'–'+to+' จาก '+total+' '+unit+'</div><div class="pg">'+
      '<button data-page="'+(S.page-1)+'"'+(S.page<=1?' disabled':'')+'>ก่อนหน้า</button>'+
      nums.map(function(n){ return n==='gap' ? '<span class="gap">…</span>' : '<button class="num-btn'+(n===S.page?' on':'')+'" data-page="'+n+'">'+n+'</button>'; }).join('')+
      '<button data-page="'+(S.page+1)+'"'+(S.page>=pages?' disabled':'')+'>ถัดไป</button></div>';
  }
  function groupsOf(list){
    var g = {}, arr = [];
    list.forEach(function(d){
      var x = g[d.cid];
      if(!x){ x = g[d.cid] = { cid:d.cid, name:d.c, code:d.cc, docs:[], latest:'', todo:0, todoAmt:0, part:0, score:0 }; arr.push(x); }
      x.docs.push(d);
      if((d.d||'') > x.latest) x.latest = d.d||'';
      if(d.ws==='todo'){ x.todo++; x.todoAmt += d.net; }
      if(d.ws==='partial') x.part += d.a - d.bill;
      if(d._score > x.score) x.score = d._score;
    });
    var dir = S.dir==='asc' ? 1 : -1;
    arr.sort(function(a,b){
      if(S.sort==='cust') return a.name.localeCompare(b.name,'th')*dir;
      if(S.sort==='amt') return (a.todoAmt-b.todoAmt)*dir;
      if(!S.sort && S.q) return (b.score-a.score) || b.latest.localeCompare(a.latest);
      return b.latest.localeCompare(a.latest);
    });
    return arr;
  }
  var lastList = [];
  function render(){
    var list = sortList(base(false));
    lastList = list;
    var body = document.getElementById('resBody'), pg = document.getElementById('pager');
    kbIndex = -1;

    // header
    var title = S.month==='all' ? 'ทุกเดือน' : monthLabel(S.month);
    if(S.q) title = 'ผลการค้นหา' + (S.month==='all' ? '' : ' ใน '+monthLabel(S.month));
    document.getElementById('resTitle').textContent = title;
    var sums = { QUOTATION:[0,0], INVOICE:[0,0], TAX_INVOICE:[0,0] };
    list.forEach(function(d){ if(sums[d.t] && !(d.t==='TAX_INVOICE' && d.s==='draft')){ sums[d.t][0]++; sums[d.t][1]+=d.a; } });
    var meta = [list.length+' เอกสาร'];
    if(S.view==='cust') meta.push(groupsOf(list).length+' ลูกค้า');
    [['QUOTATION','ใบเสนอราคา'],['INVOICE','ใบแจ้งหนี้'],['TAX_INVOICE','ใบกำกับภาษี']].forEach(function(t){
      if(sums[t[0]][0]) meta.push(t[1]+' '+sums[t[0]][0]+' <b>฿'+money(sums[t[0]][1])+'</b>');
    });
    document.getElementById('resMeta').innerHTML = meta.join('<span class="sep">|</span>');

    if(!list.length){
      var filtered = !!(S.q||S.type||S.ws||S.cust||S.job||S.month!==DEFAULT_M);
      var hint = didYouMean();
      body.innerHTML = '<div class="empty"><div class="empty-t">ไม่พบเอกสาร</div><div>'+
        (hint ? 'หมายถึง <a href="#" data-dym="'+hint.i+'" style="font-weight:600">'+esc(hint.label)+'</a> ใช่ไหม' :
          (S.q && S.month!=='all' ? 'ลองค้นหาในทุกเดือน หรือพิมพ์ให้สั้นลง' : 'ลองพิมพ์ให้สั้นลง เช่น "tx5" หรือชื่อลูกค้าบางส่วน'))+'</div>'+
        (filtered ? '<button class="btn" data-reset>ล้างตัวกรองทั้งหมด</button>' : '')+'</div>';
      pg.innerHTML = ''; pg.style.display = 'none';
    } else if(S.view==='cust'){
      var groups = groupsOf(list), gp = Math.max(1, Math.ceil(groups.length/GPAGE));
      if(S.page > gp) S.page = gp;
      var shown = groups.slice((S.page-1)*GPAGE, S.page*GPAGE);
      var autoOpen = shown.length<=2 || !!(S.q||S.cust||S.job);
      body.innerHTML = shown.map(function(g){
        var open = g.cid in openGroups ? openGroups[g.cid] : autoOpen;
        var fig = g.todo ? '<div class="grp-fig red">ค้างรับเงิน '+g.todo+' ใบ<b>฿'+money(g.todoAmt)+'</b></div>'
          : (g.part>1 ? '<div class="grp-fig">ยังไม่วางบิล<b>฿'+money(g.part)+'</b></div>' : '<div class="grp-fig">ล่าสุด<b>'+thDate(g.latest)+'</b></div>');
        return '<div class="grp'+(open?' open':'')+'" data-grp="'+esc(g.cid)+'">'+
          '<div class="grp-h"><span class="grp-chev">'+CHEV+'</span>'+
            '<div class="grp-main"><div class="grp-name">'+hl(g.name)+'</div><div class="grp-sub">'+(g.code?esc(g.code)+' · ':'')+g.docs.length+' เอกสาร</div></div>'+fig+'</div>'+
          (open ? '<div class="grp-body">'+colsHtml(true)+g.docs.map(function(d){ return rowHtml(d, true); }).join('')+'</div>' : '')+
        '</div>';
      }).join('');
      pg.innerHTML = pagerHtml(groups.length, GPAGE, 'ลูกค้า'); pg.style.display = pg.innerHTML ? '' : 'none';
    } else {
      var pages = Math.max(1, Math.ceil(list.length / PAGE));
      if(S.page > pages) S.page = pages;
      body.innerHTML = colsHtml(false) + list.slice((S.page-1)*PAGE, S.page*PAGE).map(function(d){ return rowHtml(d, false); }).join('');
      pg.innerHTML = pagerHtml(list.length, PAGE, 'เอกสาร'); pg.style.display = pg.innerHTML ? '' : 'none';
    }
    renderControls();
    syncUrl();
  }

  function renderControls(){
    // tab counts respect every filter except the tab itself
    var b = base(true), cnt = { '':b.length, todo:0, partial:0, open:0, done:0 };
    b.forEach(function(d){ cnt[d.ws]++; });
    document.querySelectorAll('#tabs .tab').forEach(function(t){
      t.classList.toggle('on', t.dataset.ws===S.ws);
      t.querySelector('.n').textContent = cnt[t.dataset.ws];
    });
    document.querySelectorAll('#typeSeg button').forEach(function(x){ x.classList.toggle('on', x.dataset.t===S.type); });
    document.querySelectorAll('#viewSeg button').forEach(function(x){ x.classList.toggle('on', x.dataset.v===S.view); });
    document.getElementById('monthSel').value = S.month;
    var mi = MONTHS.indexOf(S.month);
    document.getElementById('mPrev').disabled = S.month==='all' ? !MONTHS.length : mi>=MONTHS.length-1;
    document.getElementById('mNext').disabled = S.month==='all' || mi<=0;
    var chips = '';
    if(S.cust && CUST[S.cust]) chips += '<span class="chip"><span><small>ลูกค้า</small> '+esc(CUST[S.cust].name)+'</span><button data-unchip="cust" aria-label="เอาออก">'+X_ICON+'</button></span>';
    if(S.job) chips += '<span class="chip"><span><small>งาน</small> '+esc(S.job)+'</span><button data-unchip="job" aria-label="เอาออก">'+X_ICON+'</button></span>';
    document.getElementById('chips').innerHTML = chips;
    document.getElementById('qClear').classList.toggle('show', !!S.q);
    document.getElementById('resetBtn').classList.toggle('show', !!(S.q||S.type||S.ws||S.cust||S.job||S.month!==DEFAULT_M||S.sort));
  }

  function renderSummary(){
    var todo = DOCS.filter(function(d){ return d.ws==='todo'; });
    var tNet = todo.reduce(function(s,d){ return s+d.net; },0), oldest = todo.reduce(function(m,d){ return Math.max(m,d.age); },0);
    document.getElementById('sv-todo').textContent = '฿'+money0(tNet);
    document.getElementById('ss-todo').textContent = todo.length ? todo.length+' ใบ · ค้างนานสุด '+oldest+' วัน' : 'ไม่มีรายการค้าง';
    var part = DOCS.filter(function(d){ return d.ws==='partial'; });
    var rem = part.reduce(function(s,d){ return s+(d.a-d.bill); },0);
    document.getElementById('sv-partial').textContent = '฿'+money0(rem);
    document.getElementById('ss-partial').textContent = part.length ? part.length+' งาน ยังเหลือยอดที่ต้องวางบิล' : 'ไม่มีรายการ';
    var tx = DOCS.filter(function(d){ return d.t==='TAX_INVOICE' && d.s!=='draft' && monthKey(d.d)===THIS_M; });
    document.getElementById('sl-tax').textContent = 'ใบกำกับภาษี '+monthLabel(THIS_M);
    document.getElementById('sv-tax').textContent = '฿'+money0(tx.reduce(function(s,d){ return s+d.a; },0));
    document.getElementById('ss-tax').textContent = tx.length+' ใบ (รวม VAT)';
  }

  // ── suggestions (customers, jobs, documents) ─────────────
  var SUG = [], sIdx = -1, suggOpen = false;
  var suggEl = document.getElementById('sugg');
  function textToks(q){ return parseQuery(q).filter(function(t){ return t.kind==='text' && !t.neg && !t.field; }); }
  function allIn(o, toks){ for(var i=0;i<toks.length;i++){ if(!inStr(o._n, o._s, toks[i])) return false; } return toks.length>0; }
  function buildSugg(){
    var q = qInp.value.trim(), out = [];
    if(!q){
      CUST_L.slice().sort(function(a,b){ return b.latest.localeCompare(a.latest); }).slice(0,8).forEach(function(c){ out.push({ k:'cust', h:'ลูกค้าล่าสุด', o:c }); });
      return out;
    }
    var toks = textToks(q);
    var cs = CUST_L.filter(function(c){ return allIn(c, toks); }).sort(function(a,b){ return b.n-a.n; }).slice(0,4);
    var fuzzyHead = false;
    if(!cs.length && toks.length){
      cs = CUST_L.map(function(c){ return { c:c, s:fuzzy(q, c.name) }; }).filter(function(x){ return x.s>=0.5; })
        .sort(function(a,b){ return b.s-a.s; }).slice(0,3).map(function(x){ return x.c; });
      fuzzyHead = cs.length>0;
    }
    cs.forEach(function(c){ out.push({ k:'cust', h: fuzzyHead ? 'ลูกค้า (ใกล้เคียง)' : 'ลูกค้า', o:c }); });
    JOB_L.filter(function(j){ return allIn(j, toks); }).sort(function(a,b){ return b.latest.localeCompare(a.latest); }).slice(0,3)
      .forEach(function(j){ out.push({ k:'job', h:'งาน', o:j }); });
    var all = parseQuery(q), docs = [];
    if(all.length){
      DOCS.forEach(function(d){ var m = matchDoc(d, all); if(m) docs.push({ d:d, s:m.score }); });
      docs.sort(function(a,b){ return (b.s-a.s) || -byDate(a.d,b.d); }).slice(0,5).forEach(function(x){ out.push({ k:'doc', h:'เอกสาร', o:x.d }); });
    }
    return out;
  }
  function renderSugg(){
    SUG = buildSugg();
    if(!SUG.length){
      suggEl.innerHTML = qInp.value.trim() ? '<div class="sg-empty">ไม่พบลูกค้า งาน หรือเอกสารที่ตรงกัน</div>' : '';
    } else {
      var html = '', lastH = '';
      SUG.forEach(function(s, i){
        if(s.h !== lastH){ html += '<div class="sg-h">'+esc(s.h)+'</div>'; lastH = s.h; }
        var o = s.o, t, sub, r = '', rc = '';
        if(s.k==='cust'){ t = '<div class="sg-t">'+hlQ(o.name)+'</div>'; sub = (o.code?esc(o.code)+' · ':'')+o.n+' เอกสาร'; if(o.todo){ r = 'ค้าง ฿'+money0(o.todoAmt); rc = ' red'; } }
        else if(s.k==='job'){ t = '<div class="sg-t">'+hlQ(o.name)+'</div>'; sub = esc(o.c)+' · '+o.n+' เอกสาร'; }
        else { t = '<div class="sg-t mono">'+esc(o.n)+'</div>'; sub = esc(SHORT[o.t]||o.tn)+' · '+esc(o.c); r = '฿'+money(o.a); }
        html += '<div class="sg'+(i===sIdx?' on':'')+'" data-s="'+i+'"><div class="sg-main">'+t+'<div class="sg-s">'+sub+'</div></div>'+(r?'<div class="sg-r'+rc+'">'+r+'</div>':'')+'</div>';
      });
      suggEl.innerHTML = html;
    }
    suggEl.classList.toggle('show', suggOpen && !!suggEl.innerHTML);
  }
  function hlQ(text){ var keep = S.q; S.q = qInp.value.trim(); var h = hl(text); S.q = keep; return h; }
  function openSugg(){ suggOpen = true; sIdx = -1; renderSugg(); }
  function closeSugg(){ suggOpen = false; sIdx = -1; suggEl.classList.remove('show'); }
  function pickSugg(i){
    var s = SUG[i]; if(!s) return;
    if(s.k==='doc'){ location.href = '/documents/'+s.o.id; return; }
    if(s.k==='cust'){ S.cust = s.o.id; S.job = ''; }
    else { S.job = s.o.name; S.cust = s.o.cid; }
    qInp.value = ''; S.q = ''; monthBeforeSearch = null; S.month = 'all';
    closeSugg(); go(); qInp.blur();
  }
  function didYouMean(){
    var q = S.q.trim(); if(!q || q.length<3) return null;
    var best = null;
    CUST_L.forEach(function(c){ var s = fuzzy(q, c.name); if(s>=0.5 && (!best || s>best.s)) best = { s:s, k:'cust', o:c, label:c.name }; });
    JOB_L.forEach(function(j){ var s = fuzzy(q, j.name); if(s>=0.5 && (!best || s>best.s)) best = { s:s, k:'job', o:j, label:j.name }; });
    if(best){ SUG = [best]; best.i = 0; }
    return best;
  }

  // ── build controls ───────────────────────────────────────
  var typeSeg = document.getElementById('typeSeg');
  typeSeg.innerHTML = '<button data-t="">ทุกประเภท</button>' + TYPES.filter(function(t){ return DOCS.some(function(d){ return d.t===t.code; }); })
    .map(function(t){ return '<button data-t="'+esc(t.code)+'">'+esc(SHORT[t.code]||t.name)+'</button>'; }).join('');
  var monthSel = document.getElementById('monthSel');
  monthSel.innerHTML = '<option value="all">ทุกเดือน</option>' + MONTHS.map(function(k){ return '<option value="'+k+'">'+monthLabel(k)+'</option>'; }).join('');

  // ── events ───────────────────────────────────────────────
  function go(){ S.page = 1; render(); }
  var qInp = document.getElementById('q');
  qInp.value = S.q;
  var timer = null, kbIndex = -1;
  qInp.addEventListener('focus', openSugg);
  qInp.addEventListener('input', function(){
    sIdx = -1; suggOpen = true; renderSugg();
    clearTimeout(timer);
    timer = setTimeout(function(){
      var v = qInp.value.trim();
      if(v && !S.q && S.month!=='all'){ monthBeforeSearch = S.month; S.month = 'all'; }
      if(!v && S.q && monthBeforeSearch){ S.month = monthBeforeSearch; monthBeforeSearch = null; }
      S.q = v; go();
    }, 90);
  });
  function setKb(i){
    var rows = document.querySelectorAll('#resBody .row');
    if(!rows.length) return;
    kbIndex = Math.max(0, Math.min(rows.length-1, i));
    rows.forEach(function(r,j){ r.classList.toggle('kb', j===kbIndex); });
    rows[kbIndex].scrollIntoView({ block:'nearest' });
  }
  qInp.addEventListener('keydown', function(e){
    var sOn = suggOpen && SUG.length;
    if(e.key==='ArrowDown'){ e.preventDefault(); if(sOn){ sIdx = Math.min(SUG.length-1, sIdx+1); renderSugg(); } else setKb(kbIndex+1); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); if(sOn){ sIdx = Math.max(-1, sIdx-1); renderSugg(); } else setKb(kbIndex-1); }
    else if(e.key==='Enter'){
      e.preventDefault();
      if(sOn && sIdx>=0) return pickSugg(sIdx);
      if(!suggOpen || !SUG.length){
        var rows = document.querySelectorAll('#resBody .row');
        if(kbIndex>=0 && rows[kbIndex]) { location.href = '/documents/'+rows[kbIndex].dataset.id; return; }
        if(lastList.length===1){ location.href = '/documents/'+lastList[0].id; return; }
      }
      closeSugg();
    } else if(e.key==='Escape'){
      if(suggOpen){ closeSugg(); } else { qInp.value=''; qInp.dispatchEvent(new Event('input')); closeSugg(); }
    } else if(e.key==='Backspace' && !qInp.value){
      if(S.job){ S.job=''; go(); } else if(S.cust){ S.cust=''; go(); }
    }
  });
  suggEl.addEventListener('mousedown', function(e){ e.preventDefault(); var s = e.target.closest('[data-s]'); if(s) pickSugg(+s.dataset.s); });
  document.addEventListener('mousedown', function(e){ if(!e.target.closest('.search')) closeSugg(); });
  document.getElementById('sbox').addEventListener('click', function(e){
    var u = e.target.closest('[data-unchip]');
    if(u){ if(u.dataset.unchip==='cust'){ S.cust=''; S.job=''; } else S.job=''; go(); return; }
    if(!e.target.closest('button')) qInp.focus();
  });
  document.getElementById('qClear').addEventListener('click', function(){ qInp.value=''; qInp.dispatchEvent(new Event('input')); qInp.focus(); });
  typeSeg.addEventListener('click', function(e){ var b = e.target.closest('button'); if(!b) return; S.type = b.dataset.t; go(); });
  document.getElementById('viewSeg').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b || b.dataset.v===S.view) return;
    S.view = b.dataset.v;
    if(S.view==='cust' && S.month!=='all'){ S.month = 'all'; }
    go();
  });
  monthSel.addEventListener('change', function(){ S.month = monthSel.value; monthBeforeSearch = null; go(); });
  document.getElementById('mPrev').addEventListener('click', function(){ var i = MONTHS.indexOf(S.month); S.month = S.month==='all' ? MONTHS[0] : MONTHS[Math.min(MONTHS.length-1,i+1)]; go(); });
  document.getElementById('mNext').addEventListener('click', function(){ var i = MONTHS.indexOf(S.month); if(i>0){ S.month = MONTHS[i-1]; go(); } });
  document.getElementById('tabs').addEventListener('click', function(e){
    var t = e.target.closest('.tab'); if(!t) return;
    S.ws = t.dataset.ws;
    if((S.ws==='todo' || S.ws==='partial') && S.month!=='all'){ S.month = 'all'; }
    S.sort = ''; go();
  });
  document.getElementById('summary').addEventListener('click', function(e){
    var b = e.target.closest('.sum'); if(!b) return;
    S.q=''; qInp.value=''; S.type=''; S.cust=''; S.job=''; S.sort='';
    if(b.dataset.go==='taxmonth'){ S.ws=''; S.type='TAX_INVOICE'; S.month=THIS_M; }
    else { S.ws=b.dataset.go; S.month='all'; }
    go();
    document.getElementById('results').scrollIntoView({ behavior:'smooth', block:'start' });
  });
  function resetAll(){ S.q=''; S.type=''; S.ws=''; S.cust=''; S.job=''; S.sort=''; S.dir='desc'; S.month = S.view==='cust' ? 'all' : DEFAULT_M; monthBeforeSearch=null; qInp.value=''; openGroups={}; go(); }
  document.getElementById('resetBtn').addEventListener('click', resetAll);
  document.getElementById('resBody').addEventListener('click', function(e){
    if(e.target.closest('[data-reset]')) return resetAll();
    var dym = e.target.closest('[data-dym]');
    if(dym){ e.preventDefault(); return pickSugg(0); }
    var sb = e.target.closest('[data-sort]');
    if(sb){ var k = sb.dataset.sort; if(S.sort===k) S.dir = S.dir==='asc'?'desc':'asc'; else { S.sort=k; S.dir = (k==='amt'||k==='date')?'desc':'asc'; } return go(); }
    var gh = e.target.closest('.grp-h');
    if(gh){ var g = gh.parentNode, id = g.dataset.grp; openGroups[id] = !g.classList.contains('open'); return render(); }
    if(e.target.closest('a,button')) return;
    var row = e.target.closest('.row');
    if(row){ if(e.metaKey||e.ctrlKey) window.open('/documents/'+row.dataset.id); else location.href='/documents/'+row.dataset.id; }
  });
  document.getElementById('pager').addEventListener('click', function(e){
    var b = e.target.closest('[data-page]'); if(!b || b.disabled) return;
    S.page = parseInt(b.dataset.page,10); render();
    document.getElementById('results').scrollIntoView({ block:'start' });
  });
  document.addEventListener('keydown', function(e){
    if(e.key==='/' && document.activeElement!==qInp && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){ e.preventDefault(); qInp.focus(); qInp.select(); }
  });
  function toggleSidebar(){ document.getElementById('sidebar').classList.toggle('open'); document.getElementById('overlay').classList.toggle('show'); }
  document.getElementById('hamburger').addEventListener('click', toggleSidebar);
  document.getElementById('overlay').addEventListener('click', toggleSidebar);

  renderSummary();
  render();
})();
</script>
</body>
</html>
