---
import { getDocument, logAction, publishDocument, removeDocument, updateJob, whtInfo } from '../../../lib/documents';
import { canPublish, canDelete, canEdit } from '../../../lib/auth';
const user = Astro.locals.user;
const { id } = Astro.params;
const doc = await getDocument(id!);
if (!doc) return Astro.redirect('/documents/dashboard');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action') as string;
  if (action === 'publish' && canPublish(user)) {
    await publishDocument(id!, user.id);
    return Astro.redirect(`/documents/${id}`);
  }
  if (action === 'delete' && canDelete(user)) {
    await removeDocument(id!, user.id);
    return Astro.redirect('/documents/dashboard');
  }
  if (action === 'rename_job') {
    const jobId = (doc as any).jobs?.id;
    const name = (form.get('job_name') as string || '').trim();
    const description = (form.get('job_description') as string || '').trim();
    if (jobId && name) {
      await updateJob(jobId, name, description);
    }
    return Astro.redirect(`/documents/${id}`);
  }
}

await logAction(id!, 'view', user.id);

const TH_M = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
function thaiDate(s: string) {
  if (!s) return '—';
  const d = new Date(s);
  return `${d.getDate()} ${TH_M[d.getMonth()]} ${d.getFullYear()+543}`;
}
function money(n: number) {
  return Number(n||0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const itemsByCategory: Record<string, any[]> = {};
doc.categories.forEach((cat: any) => {
  itemsByCategory[cat.id] = doc.items.filter((i: any) => i.category_id === cat.id);
});
const hasMatLab = doc.items.some((i: any) => (i.material_cost||0) > 0 || (i.labor_cost||0) > 0);
const itemCols = hasMatLab ? 10 : 7;

function parseInstallments(cond: string, total: number) {
  if (!cond) return [];
  const lines = cond.split('\n').map((l: string) => l.trim()).filter(Boolean);
  const result: {pct: number, label: string, amount: number}[] = [];
  for (const line of lines) {
    const m = line.match(/^(\d+(?:\.\d+)?)%\s*(.*)/);
    if (m) {
      const pct = parseFloat(m[1]);
      result.push({ pct, label: m[2] || line, amount: Math.round(total * pct / 100 * 100) / 100 });
    }
  }
  const totalPct = result.reduce((s, r) => s + r.pct, 0);
  return totalPct > 0 && totalPct <= 100 && result.length > 1 ? result : [];
}

const code = doc.document_types?.code || '';
const SHORT: Record<string, string> = { QUOTATION: 'ใบเสนอราคา', INVOICE: 'ใบแจ้งหนี้', TAX_INVOICE: 'ใบกำกับภาษี' };
const typeLabel = SHORT[code] || doc.document_types?.name_th || code;
const installments = parseInstallments(doc.payment_condition || '', doc.total_amount || 0);
const linked = ((doc as any).linked_invoices || []) as any[];
const existingTx = linked.filter((i: any) => i.document_types?.code === 'TAX_INVOICE');
const childInv = linked.filter((i: any) => i.document_types?.code === 'INVOICE');
// Tax invoice can be issued from ANY live invoice (in_progress / stale / draft / published).
const canIssueTx = code === 'INVOICE' && doc.status !== 'removed' && existingTx.length === 0;
const canMarkPublished = doc.status === 'draft' && canPublish(user); // legacy drafts only
const sourceDoc = (doc as any).source_document;
const W = whtInfo(doc);
const total = Number(doc.total_amount || 0);
const billed = childInv.reduce((s: number, i: any) => s + Number(i.total_amount || 0), 0);
const billedPct = total > 0 ? Math.min(100, Math.floor(billed / total * 100)) : 0;
const remaining = Math.max(0, Math.round((total - billed) * 100) / 100);
const today = new Date(); today.setHours(0, 0, 0, 0);
const ageDays = doc.issue_date ? Math.max(0, Math.round((today.getTime() - new Date(doc.issue_date).getTime()) / 86400000)) : 0;
const todayIso = new Date(Date.now() + 7 * 3600 * 1000).toISOString().slice(0, 10); // Bangkok date

// One plain-language state, same wording as the dashboard
let ws = 'open', wl = 'ยังไม่วางบิล';
if (code === 'TAX_INVOICE') { ws = doc.status === 'draft' ? 'open' : 'done'; wl = doc.status === 'draft' ? 'ร่าง ยังไม่ออก' : 'ออกแล้ว'; }
else if (code === 'INVOICE') { ws = existingTx.length ? 'done' : 'todo'; wl = existingTx.length ? 'ออกใบกำกับแล้ว' : 'ค้างรับเงิน'; }
else if (childInv.length && remaining <= 1) { ws = 'done'; wl = 'วางบิลครบแล้ว'; }
else if (childInv.length) { ws = 'partial'; wl = `วางบิลแล้ว ${billedPct}%`; }
const idleNote = doc.status === 'stale' ? 'ไม่เคลื่อนไหว 5+ วัน' : '';
const job = (doc as any).jobs;
const cust = doc.customers || {};
---
<!DOCTYPE html>
<html lang="th">
<head>
  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dynjnftnu/image/upload/v1781103809/LOGO_TNC-02_xhpu0t.png"/>
  <link rel="apple-touch-icon" href="https://res.cloudinary.com/dynjnftnu/image/upload/v1781103809/LOGO_TNC-02_xhpu0t.png"/>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="robots" content="noindex,nofollow"/>
  <title>{doc.document_number} — TNC</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#F6F5F2;--white:#fff;--border:#E3E0DA;--line:#EEECE7;
      --text:#1A1814;--t2:#66635C;--t3:#A9A69F;
      --gold:#B8955A;--gbg:#FAF6EE;
      --green:#2D7A4F;--grbg:#EEF6F1;--red:#B23B3B;--redbg:#FBF0F0;--amber:#B97A26;--blue:#2D5A9E;
    }
    body{font-family:'Plus Jakarta Sans','Noto Sans Thai',sans-serif;background:var(--bg);color:var(--text);font-size:14px;-webkit-font-smoothing:antialiased;}
    a{color:inherit;}
    button,input,textarea,select{font-family:inherit;}
    button:focus{outline:none;} button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--text);outline-offset:2px;}
    .ic{width:16px;height:16px;flex-shrink:0;}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}

    /* Top bar */
    .top{position:sticky;top:0;z-index:40;background:rgba(246,245,242,.92);backdrop-filter:saturate(1.4) blur(8px);-webkit-backdrop-filter:saturate(1.4) blur(8px);border-bottom:1px solid var(--line);}
    .top-in{max-width:1200px;margin:0 auto;padding:0 28px;height:58px;display:flex;align-items:center;gap:12px;}
    .back{display:inline-flex;align-items:center;gap:4px;height:34px;padding:0 10px 0 6px;border-radius:7px;font-size:13px;color:var(--t2);text-decoration:none;}
    .back:hover{background:var(--white);color:var(--text);}
    .crumb{font-size:13px;color:var(--t3);display:flex;align-items:center;gap:8px;min-width:0;}
    .crumb b{color:var(--text);font-weight:600;}
    .spacer{flex:1;}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;padding:0 14px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;cursor:pointer;border:1px solid var(--border);background:var(--white);color:var(--text);white-space:nowrap;}
    .btn:hover{border-color:var(--text);}
    .btn-dark{background:var(--text);border-color:var(--text);color:var(--white);}
    .btn-dark:hover{opacity:.88;}
    .btn-green{background:var(--green);border-color:var(--green);color:var(--white);}
    .btn-green:hover{opacity:.9;}
    .btn-block{width:100%;height:40px;}
    .btn[disabled]{opacity:.6;cursor:default;}

    /* Page */
    .wrap{max-width:1200px;margin:0 auto;padding:28px 28px 64px;}
    .hero{display:flex;align-items:flex-end;gap:24px;margin-bottom:24px;}
    .hero-main{flex:1;min-width:0;}
    .eyebrow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px;color:var(--t2);margin-bottom:8px;}
    .docno{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600;color:var(--text);font-size:14px;}
    .t-QUOTATION{color:var(--blue);} .t-INVOICE{color:var(--green);} .t-TAX_INVOICE{color:var(--red);}
    .pill{display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 10px;border-radius:13px;background:var(--white);border:1px solid var(--border);font-size:12.5px;font-weight:500;}
    .dot{width:7px;height:7px;border-radius:50%;background:var(--t3);}
    .ws-todo .dot{background:var(--red);} .ws-partial .dot{background:var(--gold);} .ws-done .dot{background:var(--green);}
    .h1{font-size:26px;font-weight:700;letter-spacing:-.015em;line-height:1.25;}
    .jobline{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:6px;font-size:15px;color:var(--t2);}
    .linkbtn{border:none;background:none;padding:0;font-size:12.5px;color:var(--t2);cursor:pointer;text-decoration:underline;text-underline-offset:3px;}
    .linkbtn:hover{color:var(--text);}
    .hero-amt{text-align:right;flex-shrink:0;}
    .hero-amt .l{font-size:12.5px;color:var(--t2);}
    .hero-amt .v{font-size:30px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.2;}
    .hero-amt .s{font-size:12.5px;color:var(--t2);margin-top:2px;font-variant-numeric:tabular-nums;}
    .jobform{display:none;margin:-8px 0 24px;padding:16px;background:var(--white);border:1px solid var(--border);border-radius:12px;gap:12px;align-items:flex-end;flex-wrap:wrap;}
    .jobform.show{display:flex;}
    .field{display:flex;flex-direction:column;gap:6px;flex:1;min-width:200px;}
    .field label{font-size:12px;color:var(--t2);font-weight:500;}
    .inp{height:38px;padding:0 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;color:var(--text);background:var(--white);outline:none;width:100%;}
    .inp:focus{border-color:var(--text);}
    textarea.inp{height:auto;padding:10px 12px;line-height:1.7;resize:vertical;}

    .grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:24px;align-items:start;}
    .content,.side{min-width:0;}
    .card{background:var(--white);border:1px solid var(--border);border-radius:12px;}
    .card + .card{margin-top:16px;}
    .card-h{display:flex;align-items:center;gap:10px;padding:16px 20px 0;}
    .card-t{font-size:13px;font-weight:700;flex:1;}
    .card-b{padding:14px 20px 18px;}

    /* Details */
    .dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 24px;}
    .dl .full{grid-column:1 / -1;}
    .dt{font-size:12px;color:var(--t3);margin-bottom:3px;}
    .dd{font-size:13.5px;color:var(--text);line-height:1.55;word-break:break-word;}
    .dd.muted{color:var(--t3);}
    .dd a{text-decoration:none;border-bottom:1px solid var(--line);}
    .dd a:hover{border-color:var(--text);}

    /* Items */
    .cat{border-top:1px solid var(--line);}
    .cat:first-of-type{border-top:none;}
    .cat-h{display:flex;align-items:baseline;gap:12px;padding:14px 20px 10px;}
    .cat-n{font-size:12px;color:var(--t3);font-weight:600;white-space:nowrap;}
    .cat-t{font-size:14px;font-weight:600;flex:1;}
    .cat-sum{font-size:13.5px;font-weight:600;font-variant-numeric:tabular-nums;}
    .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;padding:0 8px 8px;}
    table{width:100%;border-collapse:collapse;min-width:560px;font-variant-numeric:tabular-nums;}
    th{padding:8px 10px;font-size:11.5px;font-weight:600;color:var(--t3);text-align:left;border-bottom:1px solid var(--line);white-space:nowrap;}
    th.r,td.r{text-align:right;} th.c,td.c{text-align:center;}
    td{padding:10px 10px;font-size:13px;color:var(--t2);border-bottom:1px solid var(--line);vertical-align:top;}
    tr:last-child td{border-bottom:none;}
    td.no{font-size:12px;color:var(--t3);white-space:nowrap;}
    td.desc{color:var(--text);line-height:1.55;min-width:200px;}
    td.amt{color:var(--text);font-weight:600;white-space:nowrap;}
    tr.sub td{background:var(--bg);font-weight:600;color:var(--text);}
    .mlist{display:none;padding:0 16px 6px;}
    .mi{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;padding:10px 0;border-top:1px solid var(--line);}
    .mi-d{font-size:13.5px;line-height:1.5;}
    .mi-no{color:var(--t3);font-size:12px;margin-right:8px;}
    .mi-a{font-size:13.5px;font-weight:600;text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums;}
    .mi-s{grid-column:1 / -1;font-size:12px;color:var(--t3);font-variant-numeric:tabular-nums;}
    .mi.sub{background:var(--bg);margin:0 -16px;padding:10px 16px;}
    .mi.sub .mi-d{font-weight:600;}
    .empty{padding:36px 20px;text-align:center;color:var(--t3);font-size:13px;}
    .notes{white-space:pre-line;font-size:13.5px;line-height:1.75;color:var(--t2);}

    /* Side */
    .side{position:sticky;top:78px;}
    .sumrow{display:flex;justify-content:space-between;gap:12px;padding:6px 0;font-size:13px;color:var(--t2);font-variant-numeric:tabular-nums;}
    .sumrow span:last-child{color:var(--text);font-weight:500;}
    .sumrow.total{border-top:1px solid var(--border);margin-top:6px;padding-top:12px;font-size:14px;color:var(--text);font-weight:600;}
    .sumrow.total span:last-child{font-size:18px;font-weight:700;}
    .sumrow.net{font-weight:600;color:var(--text);}
    .sumrow.net span:last-child{font-weight:700;}
    .next{border-color:var(--text);}
    .next.done{border-color:var(--border);}
    .next-t{font-size:15px;font-weight:700;margin-bottom:4px;}
    .next-s{font-size:12.5px;color:var(--t2);line-height:1.6;margin-bottom:14px;}
    .next-s b{color:var(--text);font-weight:600;}
    .age-old{color:var(--red);font-weight:600;} .age-mid{color:var(--amber);font-weight:600;}
    .bar{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin:4px 0 10px;}
    .bar i{display:block;height:100%;background:var(--gold);}
    .kv{display:flex;justify-content:space-between;font-size:12.5px;color:var(--t2);padding:3px 0;font-variant-numeric:tabular-nums;}
    .kv span:last-child{color:var(--text);font-weight:600;}
    .pulse{animation:pulse 1.2s ease-in-out 3;}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(26,24,20,.35);}70%{box-shadow:0 0 0 10px rgba(26,24,20,0);}100%{box-shadow:0 0 0 0 rgba(26,24,20,0);}}
    .inst{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px;}
    .inst:last-child{border-bottom:none;}
    .inst-p{font-weight:700;min-width:42px;font-variant-numeric:tabular-nums;}
    .inst-l{flex:1;color:var(--t2);line-height:1.5;}
    .inst-a{font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums;}
    .hint{font-size:12px;color:var(--t3);line-height:1.6;}
    .rel{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);text-decoration:none;}
    .rel:last-child{border-bottom:none;}
    .rel:hover .rel-n{text-decoration:underline;}
    .rel-main{flex:1;min-width:0;}
    .rel-n{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;font-weight:600;}
    .rel-s{font-size:12px;color:var(--t3);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .rel-a{font-size:13px;font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums;text-align:right;}
    .rel-a small{display:block;font-size:11.5px;font-weight:500;color:var(--t3);}
    .acts{display:flex;flex-direction:column;}
    .act{display:flex;align-items:center;gap:10px;width:100%;padding:11px 20px;border:none;border-top:1px solid var(--line);background:none;font-size:13.5px;color:var(--text);text-decoration:none;cursor:pointer;text-align:left;}
    .act:first-child{border-top:none;}
    .act:hover{background:#FBFAF8;}
    .act .ic{color:var(--t2);}
    .act small{margin-left:auto;font-size:12px;color:var(--t3);}
    .act.danger{color:var(--red);}
    .act.danger .ic{color:var(--red);}
    .meta{font-size:12px;color:var(--t3);line-height:1.8;padding:14px 4px 0;}

    /* Modals */
    .overlay{display:none;position:fixed;inset:0;background:rgba(26,24,20,.45);z-index:200;align-items:center;justify-content:center;padding:16px;}
    .overlay.show{display:flex;}
    .modal{background:var(--white);border-radius:14px;width:520px;max-width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.25);}
    .modal-h{display:flex;align-items:flex-start;gap:12px;padding:20px 22px 0;}
    .modal-t{font-size:16px;font-weight:700;flex:1;}
    .modal-s{font-size:12.5px;color:var(--t2);margin-top:3px;}
    .xbtn{width:32px;height:32px;border:none;border-radius:8px;background:none;color:var(--t2);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;}
    .xbtn:hover{background:var(--bg);color:var(--text);}
    .modal-b{padding:16px 22px;}
    .modal-f{display:flex;gap:8px;padding:0 22px 20px;}
    .modal-f .btn{flex:1;height:42px;}
    .seg{display:flex;background:var(--bg);border-radius:9px;padding:3px;gap:2px;margin-bottom:14px;}
    .seg button{flex:1;height:32px;border:none;border-radius:7px;background:none;font-size:13px;font-weight:500;color:var(--t2);cursor:pointer;}
    .seg button.on{background:var(--white);color:var(--text);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08);}
    .opt{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--border);border-radius:10px;cursor:pointer;margin-bottom:8px;}
    .opt:hover{border-color:var(--t2);}
    .opt:has(input:checked){border-color:var(--text);background:#FBFAF8;}
    .opt input{width:16px;height:16px;accent-color:var(--text);flex-shrink:0;}
    .opt-m{font-size:13.5px;font-weight:600;font-variant-numeric:tabular-nums;}
    .opt-s{font-size:12px;color:var(--t2);margin-top:1px;}
    .crow{display:grid;grid-template-columns:20px 76px minmax(0,1fr) auto 28px;gap:8px;align-items:center;margin-bottom:8px;}
    .crow input[type=radio]{width:16px;height:16px;accent-color:var(--text);}
    .crow .inp{height:36px;padding:0 10px;font-size:13px;}
    .crow .amt-lbl{font-size:12.5px;font-weight:600;min-width:84px;text-align:right;font-variant-numeric:tabular-nums;}
    .addrow{width:100%;height:36px;border:1px dashed var(--border);border-radius:8px;background:none;font-size:13px;color:var(--t2);cursor:pointer;}
    .addrow:hover{border-color:var(--text);color:var(--text);}
    .totpct{display:flex;justify-content:space-between;margin-top:10px;padding:10px 12px;background:var(--bg);border-radius:8px;font-size:13px;color:var(--t2);}
    .totpct b{color:var(--text);}
    .msg{display:none;margin-top:10px;padding:10px 12px;border-radius:8px;font-size:12.5px;line-height:1.5;}
    .msg.show{display:block;}
    .msg.info{background:var(--gbg);color:#7A5C1E;}
    .msg.ok{background:var(--grbg);color:var(--green);}
    .msg.err{background:var(--redbg);color:var(--red);}
    .msg.warn{background:#FDF6EA;color:#8A5A12;}
    .two{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px;padding-top:16px;border-top:1px solid var(--line);}
    .confirm-box{background:var(--bg);border-radius:10px;padding:14px 16px;margin-bottom:16px;}

    @media(max-width:1020px){
      .grid{grid-template-columns:minmax(0,1fr);}
      .side{position:static;}
      .dl{grid-template-columns:repeat(2,minmax(0,1fr));}
    }
    @media(max-width:640px){
      .top-in{padding:0 12px;height:54px;gap:8px;}
      .crumb{display:none;}
      .top .btn .lbl{display:none;}
      .wrap{padding:18px 12px 48px;}
      .hero{flex-direction:column;align-items:flex-start;gap:14px;margin-bottom:18px;}
      .hero-amt{text-align:left;}
      .h1{font-size:21px;}
      .hero-amt .v{font-size:24px;}
      .dl{grid-template-columns:1fr 1fr;gap:14px 16px;}
      .card-h{padding:14px 16px 0;} .card-b{padding:12px 16px 16px;}
      .cat-h{padding:12px 16px 8px;}
      .act{padding:12px 16px;}
      .tbl-wrap{display:none;} .mlist{display:block;}
      .crow{grid-template-columns:20px 64px minmax(0,1fr) 28px;}
      .crow .amt-lbl{display:none;}
      .two{grid-template-columns:1fr;}
    }
  </style>
</head>
<body>
  <header class="top">
    <div class="top-in">
      <a href="/documents/dashboard" class="back" id="backLink"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>เอกสาร</a>
      <div class="crumb"><span>/</span><b class="mono">{doc.document_number}</b></div>
      <span class="spacer"></span>
      <a href={`/documents/${id}/print`} target="_blank" class="btn"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9V4h10v5"/><rect x="4" y="9" width="16" height="8" rx="2"/><path d="M7 14h10v6H7z"/></svg><span class="lbl">พิมพ์ / PDF</span></a>
      {canEdit(user) && (
        <a href={`/documents/${id}/edit`} class="btn btn-dark"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16v4z"/></svg><span class="lbl">แก้ไข</span></a>
      )}
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="hero-main">
        <div class="eyebrow">
          <span class="docno">{doc.document_number}</span>
          <span class={`t-${code}`}>{typeLabel}</span>
          <span class={`pill ws-${ws}`}><span class="dot"></span>{wl}</span>
          {idleNote && <span style="color:var(--amber);font-size:12.5px;">{idleNote}</span>}
        </div>
        <h1 class="h1">{cust.company_name || 'ไม่ระบุลูกค้า'}</h1>
        {job ? (
          <div class="jobline">
            <span>{job.name}</span>
            <button type="button" class="linkbtn" onclick="document.getElementById('jobForm').classList.toggle('show')">แก้ไขชื่องาน</button>
          </div>
        ) : null}
      </div>
      <div class="hero-amt">
        <div class="l">ยอดรวมทั้งสิ้น</div>
        <div class="v">฿{money(doc.total_amount)}</div>
        {W.applies && code !== 'TAX_INVOICE' && <div class="s">โอนสุทธิหลังหัก ณ ที่จ่าย ฿{money(W.net)}</div>}
      </div>
    </section>

    {job && (
      <form method="POST" class="jobform" id="jobForm">
        <input type="hidden" name="action" value="rename_job"/>
        <div class="field"><label>ชื่องาน</label><input class="inp" type="text" name="job_name" value={job.name} required/></div>
        <div class="field"><label>รายละเอียด (ไม่บังคับ)</label><input class="inp" type="text" name="job_description" value={job.description || ''}/></div>
        <button type="submit" class="btn btn-dark">บันทึก</button>
        <button type="button" class="btn" onclick="document.getElementById('jobForm').classList.remove('show')">ยกเลิก</button>
      </form>
    )}

    <div class="grid">
      <div class="content">
        <section class="card">
          <div class="card-h"><div class="card-t">ข้อมูลเอกสาร</div></div>
          <div class="card-b">
            <div class="dl">
              <div>
                <div class="dt">{code === 'TAX_INVOICE' ? 'วันที่ในใบกำกับภาษี' : 'วันที่ออก'}</div>
                <div class="dd">{thaiDate(doc.issue_date)}</div>
              </div>
              <div>
                <div class="dt">{code === 'QUOTATION' ? 'ราคามีผลถึง' : 'กำหนดชำระ'}</div>
                <div class={`dd${doc.due_date ? '' : ' muted'}`}>{doc.due_date ? thaiDate(doc.due_date) : 'ไม่ระบุ'}</div>
              </div>
              <div>
                <div class="dt">อ้างอิง P/O</div>
                <div class={`dd${doc.reference_po ? '' : ' muted'}`}>{doc.reference_po || 'ไม่ระบุ'}</div>
              </div>
              <div>
                <div class="dt">รหัสลูกค้า</div>
                <div class="dd mono">{cust.customer_code || '—'}</div>
              </div>
              <div>
                <div class="dt">เลขประจำตัวผู้เสียภาษี</div>
                <div class={`dd mono${cust.tax_id ? '' : ' muted'}`}>{cust.tax_id || 'ยังไม่มีข้อมูล'}</div>
              </div>
              <div>
                <div class="dt">โทรศัพท์</div>
                <div class={`dd${cust.phone ? '' : ' muted'}`}>{cust.phone || '—'}</div>
              </div>
              <div class="full">
                <div class="dt">ที่อยู่</div>
                <div class={`dd${cust.address ? '' : ' muted'}`}>{cust.address || 'ยังไม่มีข้อมูล'}</div>
              </div>
              {cust.id && (
                <div class="full"><div class="dd"><a href={`/documents/customers/${cust.id}`}>ดูข้อมูลลูกค้า</a> <span style="color:var(--line);margin:0 6px;">|</span> <a href={`/documents/dashboard?cust=${cust.id}`}>เอกสารทั้งหมดของลูกค้านี้</a></div></div>
              )}
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-h"><div class="card-t">รายการ</div><span class="hint">{doc.items.filter((i: any) => !i.is_subtotal_row).length} รายการ</span></div>
          <div style="padding-top:6px;">
            {doc.categories.length === 0 ? (
              <div class="empty">ยังไม่มีรายการในเอกสารนี้</div>
            ) : doc.categories.map((cat: any) => {
              const items = itemsByCategory[cat.id] || [];
              const catTotal = items.filter((i: any) => !i.is_subtotal_row).reduce((s: number, i: any) => s + Number(i.amount || 0), 0);
              return (
                <div class="cat">
                  <div class="cat-h">
                    <span class="cat-n">หมวด {cat.category_number}</span>
                    <span class="cat-t">{cat.name_th}</span>
                    <span class="cat-sum">฿{money(catTotal)}</span>
                  </div>
                  <div class="tbl-wrap">
                    <table>
                      <thead>
                        <tr>
                          <th style="width:48px;">ลำดับ</th>
                          <th style="width:56px;">รหัส</th>
                          <th>รายการ</th>
                          <th class="r" style="width:60px;">จำนวน</th>
                          <th class="c" style="width:56px;">หน่วย</th>
                          {hasMatLab ? (
                            <>
                              <th class="r">วัสดุ</th>
                              <th class="r">รวมวัสดุ</th>
                              <th class="r">แรงงาน</th>
                              <th class="r">รวมแรงงาน</th>
                            </>
                          ) : (
                            <th class="r" style="width:100px;">หน่วยละ</th>
                          )}
                          <th class="r" style="width:110px;">จำนวนเงิน</th>
                        </tr>
                      </thead>
                      <tbody>
                        {items.map((item: any) => item.is_subtotal_row ? (
                          <tr class="sub">
                            <td colspan={itemCols - 1} class="r">{item.description_th}</td>
                            <td class="r amt">{money(item.amount)}</td>
                          </tr>
                        ) : (
                          <tr>
                            <td class="no">{item.item_number}</td>
                            <td class="no">{item.item_code || ''}</td>
                            <td class="desc">{item.description_th}</td>
                            <td class="r">{item.quantity > 0 ? Number(item.quantity).toLocaleString('th-TH') : '—'}</td>
                            <td class="c">{item.unit_th}</td>
                            {hasMatLab ? (
                              <>
                                <td class="r">{item.material_cost > 0 ? money(item.material_cost) : '—'}</td>
                                <td class="r">{item.material_total > 0 ? money(item.material_total) : '—'}</td>
                                <td class="r">{item.labor_cost > 0 ? money(item.labor_cost) : '—'}</td>
                                <td class="r">{item.labor_total > 0 ? money(item.labor_total) : '—'}</td>
                              </>
                            ) : (
                              <td class="r">{item.unit_price > 0 ? money(item.unit_price) : '—'}</td>
                            )}
                            <td class="r amt">{item.amount > 0 ? money(item.amount) : '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <div class="mlist">
                    {items.map((item: any) => item.is_subtotal_row ? (
                      <div class="mi sub"><div class="mi-d">{item.description_th}</div><div class="mi-a">{money(item.amount)}</div></div>
                    ) : (
                      <div class="mi">
                        <div class="mi-d"><span class="mi-no">{item.item_number}</span>{item.description_th}</div>
                        <div class="mi-a">{item.amount > 0 ? money(item.amount) : '—'}</div>
                        <div class="mi-s">
                          {item.quantity > 0 ? `${Number(item.quantity).toLocaleString('th-TH')} ${item.unit_th || ''}` : ''}
                          {hasMatLab
                            ? `${item.material_cost > 0 ? ` · วัสดุ ${money(item.material_cost)}` : ''}${item.labor_cost > 0 ? ` · แรงงาน ${money(item.labor_cost)}` : ''}`
                            : (item.unit_price > 0 ? ` × ${money(item.unit_price)}` : '')}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        {doc.notes && (
          <section class="card">
            <div class="card-h"><div class="card-t">หมายเหตุ</div></div>
            <div class="card-b"><div class="notes">{doc.notes}</div></div>
          </section>
        )}
      </div>

      <aside class="side">
        {/* Next step: depends on the kind of document */}
        {code === 'INVOICE' && canIssueTx && (
          <section class="card next">
            <div class="card-b" style="padding-top:18px;">
              <div class="next-t">รอรับชำระเงิน</div>
              <div class="next-s">
                วางบิลเมื่อ {thaiDate(doc.issue_date)} · <span class={ageDays > 60 ? 'age-old' : (ageDays > 30 ? 'age-mid' : '')}>ค้าง {ageDays} วัน</span><br/>
                ลูกค้าต้องโอน <b>฿{money(W.applies ? W.net : doc.total_amount)}</b>{W.applies ? ' (หัก ณ ที่จ่าย 3% แล้ว)' : ''}
              </div>
              <button type="button" class="btn btn-dark btn-block" id="txBtn" onclick="openTxModal()">ลูกค้าชำระแล้ว ออกใบกำกับภาษี</button>
            </div>
          </section>
        )}
        {code === 'INVOICE' && !canIssueTx && existingTx.length > 0 && (
          <section class="card next done">
            <div class="card-b" style="padding-top:18px;">
              <div class="next-t">ออกใบกำกับภาษีแล้ว</div>
              <div class="next-s">ใบแจ้งหนี้นี้ได้รับชำระและออกใบกำกับภาษีเรียบร้อย</div>
              {existingTx.map((t: any) => (
                <a href={`/documents/${t.id}`} class="btn btn-block">ดู {t.document_number}</a>
              ))}
            </div>
          </section>
        )}
        {code === 'TAX_INVOICE' && (
          <section class="card next done">
            <div class="card-b" style="padding-top:18px;">
              <div class="next-t">วันที่รับชำระเงิน</div>
              <div class="next-s">วันที่ในใบกำกับภาษีต้องเป็นวันที่ลูกค้าชำระเงิน แก้ไขได้ที่นี่</div>
              <div style="display:flex;gap:8px;align-items:center;">
                <input type="date" class="inp" id="txDateInp" value={doc.issue_date || ''} onchange="saveTxDate(this.value)"/>
              </div>
              <div class="hint" id="txDateHint" style="margin-top:6px;"></div>
            </div>
          </section>
        )}
        {code !== 'INVOICE' && code !== 'TAX_INVOICE' && (
          <section class="card next">
            <div class="card-b" style="padding-top:18px;">
              <div class="next-t">{childInv.length ? (remaining > 1 ? 'วางบิลงวดถัดไป' : 'วางบิลครบแล้ว') : 'วางบิลงวดแรก'}</div>
              <div class="kv"><span>วางบิลแล้ว</span><span>฿{money(billed)} ({billedPct}%)</span></div>
              <div class="bar"><i style={`width:${billedPct}%`}></i></div>
              <div class="kv" style="margin-bottom:14px;"><span>ยังไม่วางบิล</span><span>฿{money(remaining)}</span></div>
              <button type="button" class="btn btn-dark btn-block" id="genInstBtn">สร้างใบแจ้งหนี้งวด</button>
            </div>
          </section>
        )}

        <section class="card">
          <div class="card-h"><div class="card-t">สรุปยอด</div></div>
          <div class="card-b">
            <div class="sumrow"><span>รวมจำนวนเงิน</span><span>฿{money(doc.subtotal)}</span></div>
            {doc.discount_design > 0 && <div class="sumrow"><span>ส่วนลดค่าแบบ</span><span>-฿{money(doc.discount_design)}</span></div>}
            {doc.discount_trade > 0 && <div class="sumrow"><span>ส่วนลดการค้า</span><span>-฿{money(doc.discount_trade)}</span></div>}
            <div class="sumrow"><span>ราคาก่อน VAT</span><span>฿{money(doc.price_before_vat)}</span></div>
            <div class="sumrow"><span>VAT 7%</span><span>฿{money(doc.vat_amount)}</span></div>
            <div class="sumrow total"><span>ยอดรวมทั้งสิ้น</span><span>฿{money(doc.total_amount)}</span></div>
            {W.applies ? (
              <>
                <div class="sumrow"><span>หัก ณ ที่จ่าย 3%</span><span>-฿{money(W.wht)}</span></div>
                <div class="sumrow net"><span>ยอดชำระสุทธิ</span><span>฿{money(W.net)}</span></div>
              </>
            ) : (
              <div class="sumrow"><span>ไม่หัก ณ ที่จ่าย</span><span></span></div>
            )}
          </div>
        </section>

        {code !== 'TAX_INVOICE' && (
          <section class="card">
            <div class="card-h">
              <div class="card-t">เงื่อนไขการชำระเงิน</div>
              <button type="button" class="linkbtn" id="instEditBtn" onclick="toggleInstEdit()">แก้ไข</button>
            </div>
            <div class="card-b">
              <div id="instPreview">
                {installments.length > 0 ? installments.map((inst: any) => (
                  <div class="inst"><span class="inst-p">{inst.pct}%</span><span class="inst-l">{inst.label}</span><span class="inst-a">฿{money(inst.amount)}</span></div>
                )) : (doc.payment_condition ? (
                  <div class="notes" style="font-size:13px;">{doc.payment_condition}</div>
                ) : (
                  <div class="hint">ยังไม่มีเงื่อนไข กด "แก้ไข" เพื่อเพิ่ม</div>
                ))}
              </div>
              <div id="instEditBox" style="display:none;">
                <textarea id="instEditTA" class="inp" rows="5">{doc.payment_condition || ''}</textarea>
                <div class="hint" style="margin:6px 0 10px;">พิมพ์แต่ละงวดในบรรทัดใหม่ เช่น<br/>30% เมื่อตกลงทำสัญญา<br/>70% เมื่อส่งมอบงาน</div>
                <button type="button" class="btn btn-dark btn-block" onclick="saveInstCondition()">บันทึกเงื่อนไข</button>
              </div>
            </div>
          </section>
        )}

        {(sourceDoc || linked.length > 0) && (
          <section class="card">
            <div class="card-h"><div class="card-t">เอกสารที่เกี่ยวข้อง</div></div>
            <div class="card-b" style="padding-top:6px;">
              {sourceDoc && (
                <a class="rel" href={`/documents/${sourceDoc.id}`}>
                  <div class="rel-main"><div class="rel-n">{sourceDoc.document_number}</div><div class="rel-s">เอกสารต้นทาง · {SHORT[sourceDoc.document_types?.code] || sourceDoc.document_types?.name_th}</div></div>
                </a>
              )}
              {linked.map((inv: any) => (
                <a class="rel" href={`/documents/${inv.id}`}>
                  <div class="rel-main">
                    <div class="rel-n">{inv.document_number}</div>
                    <div class="rel-s">{SHORT[inv.document_types?.code] || ''}{inv.payment_condition ? ` · ${inv.payment_condition.split('\n')[0]}` : ''}</div>
                  </div>
                  <div class="rel-a">฿{money(inv.total_amount)}<small>{thaiDate(inv.issue_date)}</small></div>
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="card">
          <div class="acts">
            <button type="button" class="act" onclick="copyLink()">
              <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
              คัดลอกลิงก์ให้ลูกค้า<small id="copy-hint"></small>
            </button>
            <a href={`/documents/${id}/print`} target="_blank" class="act">
              <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9V4h10v5"/><rect x="4" y="9" width="16" height="8" rx="2"/><path d="M7 14h10v6H7z"/></svg>
              พิมพ์ / บันทึก PDF
            </a>
            {canEdit(user) && (
              <a href={`/documents/${id}/edit`} class="act">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16v4z"/></svg>
                แก้ไขเอกสาร
              </a>
            )}
            {canMarkPublished && (
              <form method="POST">
                <input type="hidden" name="action" value="publish"/>
                <button type="submit" class="act" onclick="return confirm('ออกเอกสารนี้?')">
                  <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg>
                  ออกเอกสาร (เปลี่ยนจากร่าง)
                </button>
              </form>
            )}
            {canDelete(user) && (
              <form method="POST">
                <input type="hidden" name="action" value="delete"/>
                <button type="submit" class="act danger" onclick={`return confirm('ลบเอกสาร ${doc.document_number}? จะย้ายไปถังขยะ กู้คืนได้ภายใน 45 วัน')`}>
                  <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>
                  ลบเอกสาร<small>กู้คืนได้ภายใน 45 วัน</small>
                </button>
              </form>
            )}
          </div>
        </section>
        <div class="meta">
          สร้างโดย {doc.tnc_users?.full_name || '—'}<br/>
          {doc.document_types?.name_th} · <span class="mono">{id?.substring(0, 8)}</span>
        </div>
      </aside>
    </div>
  </main>

  {canIssueTx && (
    <div class="overlay" id="txModal">
      <div class="modal" style="width:440px;">
        <div class="modal-h">
          <div style="flex:1;"><div class="modal-t">ออกใบกำกับภาษี</div><div class="modal-s">จาก {doc.document_number} · {cust.company_name}</div></div>
          <button type="button" class="xbtn" aria-label="ปิด" onclick="closeModal('txModal')"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <div class="modal-b">
          <div class="confirm-box">
            <div class="kv"><span>ยอดรวมทั้งสิ้น</span><span>฿{money(doc.total_amount)}</span></div>
            {W.applies && <div class="kv"><span>หัก ณ ที่จ่าย 3%</span><span>-฿{money(W.wht)}</span></div>}
            {W.applies && <div class="kv"><span>ลูกค้าโอนสุทธิ</span><span>฿{money(W.net)}</span></div>}
          </div>
          <div class="field">
            <label for="txPayDate">วันที่ลูกค้าชำระเงิน (จะเป็นวันที่ในใบกำกับภาษี)</label>
            <input type="date" class="inp" id="txPayDate" value={todayIso}/>
          </div>
          <div class="hint" style="margin-top:8px;">เลขที่ใบกำกับภาษีจะถูกใช้ถาวรและยกเลิกไม่ได้ กรุณาตรวจสอบยอดและวันที่ก่อนยืนยัน</div>
          <div class="msg" id="txMsg"></div>
        </div>
        <div class="modal-f">
          <button type="button" class="btn" onclick="closeModal('txModal')">ยกเลิก</button>
          <button type="button" class="btn btn-dark" id="txConfirm" onclick="createTaxInvoice()">ยืนยันออกใบกำกับภาษี</button>
        </div>
      </div>
    </div>
  )}

  <div class="overlay" id="instModal">
    <div class="modal">
      <div class="modal-h">
        <div style="flex:1;"><div class="modal-t">สร้างใบแจ้งหนี้งวด</div><div class="modal-s" id="instModalSub"></div></div>
        <button type="button" class="xbtn" aria-label="ปิด" onclick="closeModal('instModal')"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="modal-b">
        <div class="seg" id="instTabs">
          <button type="button" id="tabPreset" onclick="switchInstTab('preset')">ตามเงื่อนไขเดิม</button>
          <button type="button" id="tabCustom" onclick="switchInstTab('custom')">กำหนดเอง</button>
        </div>
        <div id="tabPresetContent"><div id="presetList"></div></div>
        <div id="tabCustomContent" style="display:none;">
          <div id="customRows"></div>
          <button type="button" class="addrow" onclick="addInstRow()">เพิ่มงวด</button>
          <div class="totpct"><span>รวม</span><b id="instTotalPct">0%</b></div>
          <div class="msg" id="instWarning"></div>
        </div>
        <div class="two">
          <div class="field" style="min-width:0;"><label for="instIssueDate">วันที่ออกใบแจ้งหนี้</label><input type="date" id="instIssueDate" class="inp"/></div>
          <div class="field" style="min-width:0;"><label for="instDueDate">กำหนดชำระ</label><input type="date" id="instDueDate" class="inp"/></div>
        </div>
        <div class="msg" id="instCreateStatus"></div>
      </div>
      <div class="modal-f">
        <button type="button" class="btn" onclick="closeModal('instModal')">ยกเลิก</button>
        <button type="button" class="btn btn-dark" id="instConfirm">สร้างใบแจ้งหนี้</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ installments, docId: id, docNum: doc.document_number, docTotal: doc.total_amount, docCustomerId: doc.customer_id }}>
  var TOTAL = Number(docTotal) || 0;
  var customRowCount = 0;
  var X_SVG = '<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
  function money(n) { return Number(n||0).toLocaleString('th-TH', {minimumFractionDigits:2, maximumFractionDigits:2}); }
  function escHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function setMsg(el, kind, text) { el.className = 'msg show ' + kind; el.textContent = text; }

  window.closeModal = function(id) { var m = document.getElementById(id); if (m) m.classList.remove('show'); };
  document.querySelectorAll('.overlay').forEach(function(o) {
    o.addEventListener('click', function(e) { if (e.target === o) o.classList.remove('show'); });
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') document.querySelectorAll('.overlay.show').forEach(function(o){ o.classList.remove('show'); });
  });

  // ── Installment modal ─────────────────────────────────────────
  window.switchInstTab = function(tab) {
    var isPreset = tab === 'preset';
    document.getElementById('tabPresetContent').style.display = isPreset ? '' : 'none';
    document.getElementById('tabCustomContent').style.display = isPreset ? 'none' : '';
    document.getElementById('tabPreset').classList.toggle('on', isPreset);
    document.getElementById('tabCustom').classList.toggle('on', !isPreset);
  };

  window.addInstRow = function(pct, label) {
    customRowCount++;
    var id = 'row_' + customRowCount;
    var div = document.createElement('div');
    div.id = id;
    div.className = 'crow';
    div.innerHTML =
      '<input type="radio" name="customChoice" value="'+customRowCount+'" onchange="updateCustomSummary()"/>'+
      '<input type="number" class="inp pct-inp" placeholder="%" min="1" max="100" step="0.01" oninput="updateCustomSummary()" value="'+(pct||'')+'"/>'+
      '<input type="text" class="inp lbl-inp" placeholder="รายละเอียดงวด" value="'+escHtml(label||'')+'"/>'+
      '<span class="amt-lbl">฿—</span>'+
      '<button type="button" class="xbtn" aria-label="ลบงวด" onclick="removeInstRow(\'' + id + '\')">' + X_SVG + '</button>';
    document.getElementById('customRows').appendChild(div);
    updateCustomSummary();
  };

  window.removeInstRow = function(id) {
    var el = document.getElementById(id);
    if (el) el.remove();
    updateCustomSummary();
  };

  window.updateCustomSummary = function() {
    var rows = document.querySelectorAll('#customRows > .crow');
    var total = 0;
    rows.forEach(function(row) {
      var pct = parseFloat(row.querySelector('.pct-inp').value) || 0;
      total += pct;
      var amt = Math.round(TOTAL * pct / 100 * 100) / 100;
      row.querySelector('.amt-lbl').textContent = pct > 0 ? '฿' + money(amt) : '฿—';
    });
    var pctEl = document.getElementById('instTotalPct');
    pctEl.textContent = total.toFixed(2).replace(/\.00$/, '') + '%';
    pctEl.style.color = Math.abs(total - 100) < 0.01 ? 'var(--green)' : (total > 100 ? 'var(--red)' : 'var(--text)');
    var warn = document.getElementById('instWarning');
    if (total > 100) setMsg(warn, 'err', 'รวมเกิน 100% กรุณาตรวจสอบ');
    else if (total > 0 && total < 100) setMsg(warn, 'warn', 'รวม ' + total.toFixed(2).replace(/\.00$/, '') + '% ยังไม่ครบ 100% (สร้างได้)');
    else warn.className = 'msg';
  };

  window.openInstModal = function() {
    document.getElementById('instModalSub').textContent = docNum + ' · ยอดรวม ฿' + money(TOTAL);
    var presetList = document.getElementById('presetList');
    if (installments && installments.length > 0) {
      presetList.innerHTML = '';
      installments.forEach(function(inst, idx) {
        var lbl = document.createElement('label');
        lbl.className = 'opt';
        lbl.innerHTML =
          '<input type="radio" name="instChoice" value="'+idx+'"/>'+
          '<div style="flex:1;min-width:0;"><div class="opt-m">'+inst.pct+'% · ฿'+money(inst.amount)+'</div>'+
          '<div class="opt-s">'+escHtml(inst.label)+'</div></div>';
        presetList.appendChild(lbl);
      });
      document.getElementById('instTabs').style.display = '';
      switchInstTab('preset');
    } else {
      document.getElementById('instTabs').style.display = 'none';
      switchInstTab('custom');
    }
    if (document.getElementById('customRows').children.length === 0) addInstRow();
    var d = new Date(Date.now() + 7 * 3600 * 1000).toISOString().split('T')[0];
    document.getElementById('instIssueDate').value = d;
    document.getElementById('instCreateStatus').className = 'msg';
    document.getElementById('instModal').classList.add('show');
  };

  var genBtn = document.getElementById('genInstBtn');
  if (genBtn) genBtn.addEventListener('click', openInstModal);

  document.getElementById('instConfirm').addEventListener('click', async function() {
    var isPreset = document.getElementById('tabPresetContent').style.display !== 'none';
    var pct, label, amount;
    if (isPreset) {
      var sel = document.querySelector('input[name="instChoice"]:checked');
      if (!sel) { alert('กรุณาเลือกงวด'); return; }
      var inst = installments[parseInt(sel.value)];
      pct = inst.pct; label = inst.label; amount = inst.amount;
    } else {
      var selCustom = document.querySelector('input[name="customChoice"]:checked');
      if (!selCustom) { alert('กรุณาเลือกงวดที่ต้องการสร้างใบแจ้งหนี้'); return; }
      var row = document.getElementById('row_' + selCustom.value);
      pct = parseFloat(row.querySelector('.pct-inp').value) || 0;
      label = row.querySelector('.lbl-inp').value || ('งวด ' + selCustom.value);
      amount = Math.round(TOTAL * pct / 100 * 100) / 100;
      if (!pct || pct <= 0) { alert('กรุณากรอก % ของงวดที่เลือก'); return; }
    }
    var issueDate = document.getElementById('instIssueDate').value;
    var dueDate = document.getElementById('instDueDate').value;
    if (!issueDate) { alert('กรุณาระบุวันที่ออกใบแจ้งหนี้'); return; }

    var btn = document.getElementById('instConfirm');
    var status = document.getElementById('instCreateStatus');
    btn.disabled = true;
    btn.textContent = 'กำลังสร้าง...';
    setMsg(status, 'info', 'กำลังสร้างใบแจ้งหนี้...');
    try {
      var res = await fetch('/documents/api/create-installment', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          source_doc_id: docId,
          source_doc_num: docNum,
          customer_id: docCustomerId,
          pct: pct,
          amount: amount,
          label: label,
          issue_date: issueDate,
          due_date: dueDate || null,
        })
      });
      var data = await res.json();
      if (!res.ok) throw new Error(data.error || 'เกิดข้อผิดพลาด');
      setMsg(status, 'ok', 'สร้างสำเร็จ ' + data.document_number + ' กำลังเปิดเอกสาร...');
      setTimeout(function() { window.location.href = '/documents/' + data.id; }, 800);
    } catch (e) {
      setMsg(status, 'err', 'เกิดข้อผิดพลาด: ' + e.message);
      btn.disabled = false;
      btn.textContent = 'สร้างใบแจ้งหนี้';
    }
  });

  // ── Payment condition ─────────────────────────────────────────
  window.toggleInstEdit = function() {
    var box = document.getElementById('instEditBox');
    var btn = document.getElementById('instEditBtn');
    var preview = document.getElementById('instPreview');
    var isHidden = box.style.display === 'none';
    box.style.display = isHidden ? '' : 'none';
    preview.style.display = isHidden ? 'none' : '';
    btn.textContent = isHidden ? 'ยกเลิก' : 'แก้ไข';
  };
  window.saveInstCondition = async function() {
    var val = document.getElementById('instEditTA').value.trim();
    try {
      var res = await fetch('/documents/api/update-payment-condition', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ doc_id: docId, payment_condition: val })
      });
      if (res.ok) { window.location.reload(); }
      else { alert('บันทึกไม่สำเร็จ'); }
    } catch (e) { alert('เกิดข้อผิดพลาด: ' + e.message); }
  };

  // ── Tax invoice (from an invoice) ─────────────────────────────
  window.openTxModal = function() {
    var m = document.getElementById('txModal');
    if (!m) return;
    document.getElementById('txMsg').className = 'msg';
    m.classList.add('show');
  };
  window.createTaxInvoice = async function() {
    var dateEl = document.getElementById('txPayDate');
    var payDate = dateEl ? dateEl.value : '';
    if (!payDate) { alert('กรุณาระบุวันที่ลูกค้าชำระเงิน'); return; }
    var btn = document.getElementById('txConfirm');
    var msg = document.getElementById('txMsg');
    btn.disabled = true;
    btn.textContent = 'กำลังสร้าง...';
    setMsg(msg, 'info', 'กำลังออกใบกำกับภาษี...');
    try {
      var res = await fetch('/documents/api/create-tax-invoice', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          source_doc_id: docId,
          source_doc_num: docNum,
          customer_id: docCustomerId,
          total_amount: Number(docTotal),
          issue_date: payDate,
          inst_label: null,
        })
      });
      var data = await res.json();
      if (!res.ok) throw new Error(data.error || 'เกิดข้อผิดพลาด');
      setMsg(msg, 'ok', 'สร้างสำเร็จ ' + data.document_number + ' กำลังเปิดเอกสาร...');
      setTimeout(function() { window.location.href = '/documents/' + data.id; }, 800);
    } catch (e) {
      setMsg(msg, 'err', 'เกิดข้อผิดพลาด: ' + e.message);
      btn.disabled = false;
      btn.textContent = 'ยืนยันออกใบกำกับภาษี';
    }
  };

  // ── Tax invoice date (on a tax invoice) ───────────────────────
  window.saveTxDate = async function(val) {
    if (!val) return;
    var hint = document.getElementById('txDateHint');
    if (hint) hint.textContent = 'กำลังบันทึก...';
    try {
      var res = await fetch('/documents/api/update-date', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ doc_id: docId, issue_date: val })
      });
      var data = await res.json();
      if (!res.ok) { alert('บันทึกไม่สำเร็จ: ' + (data.error || '')); if (hint) hint.textContent = ''; return; }
      window.location.reload();
    } catch (e) { alert('เกิดข้อผิดพลาด: ' + e.message); }
  };

  // ── Copy customer link ────────────────────────────────────────
  window.copyLink = function() {
    var url = 'https://tncdocument.pages.dev/documents/' + docId + '/print';
    navigator.clipboard.writeText(url).then(function() {
      var hint = document.getElementById('copy-hint');
      if (hint) {
        hint.textContent = 'คัดลอกแล้ว';
        hint.style.color = 'var(--green)';
        setTimeout(function() { hint.textContent = ''; hint.style.color = ''; }, 2000);
      }
    });
  };

  // Back returns to the exact dashboard search/filter the user came from
  try {
    var dashUrl = sessionStorage.getItem('tnc_dash_url');
    var back = document.getElementById('backLink');
    if (dashUrl && back && dashUrl.indexOf('/documents/dashboard') === 0) back.setAttribute('href', dashUrl);
  } catch (e) {}

  // Arrived via the dashboard's "ออกใบกำกับภาษี" shortcut → open the confirm dialog
  if (new URLSearchParams(location.search).get('tx') === '1') {
    var txb = document.getElementById('txBtn');
    if (txb) { txb.scrollIntoView({ behavior: 'smooth', block: 'center' }); txb.classList.add('pulse'); openTxModal(); }
    history.replaceState(null, '', location.pathname);
  }
  </script>
</body>
</html>
