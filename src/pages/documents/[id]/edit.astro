---
import { getDocument, getDocumentTypes, getCustomers, saveDocument, statusInfo } from '../../../lib/documents';
import { canEdit } from '../../../lib/auth';
const user = Astro.locals.user;
const { id } = Astro.params;
const doc = await getDocument(id!);
if (!doc) return Astro.redirect('/documents/dashboard');
if (doc.status === 'published' && !canEdit(user)) return Astro.redirect(`/documents/${id}`);

const documentTypes = await getDocumentTypes();
const customers = await getCustomers();

if (Astro.request.method === 'POST') {
  try {
    const body = await Astro.request.json();
    body.document.id = id;
    const skipBOQ = body.skipBOQ === true;
    const result = await saveDocument(body.document, body.categories || [], body.items || [], user.id, skipBOQ);
    if (result.error) return new Response(JSON.stringify({ error: result.error.message }), { status: 400 });
    return new Response(JSON.stringify({ id: result.document.id, document_number: result.document.document_number }), { status: 200 });
  } catch (e: any) {
    return new Response(JSON.stringify({ error: e.message }), { status: 500 });
  }
}

const SHORT: Record<string, string> = { QUOTATION: 'ใบเสนอราคา', INVOICE: 'ใบแจ้งหนี้', TAX_INVOICE: 'ใบกำกับภาษี', BOQ: 'BOQ' };
const types = documentTypes.map((dt: any) => ({ id: dt.id, code: dt.code, label: SHORT[dt.code] || dt.name_th }));
const curType = types.find((t: any) => t.id === doc.document_type_id) || { id: doc.document_type_id, code: doc.document_types?.code || '', label: doc.document_types?.name_th || '' };
if (!types.some((t: any) => t.id === curType.id)) types.push(curType);

// Same fields the old edit page loaded and saved
const existingDoc = {
  document_type_id: doc.document_type_id,
  customer_id: doc.customer_id,
  issue_date: doc.issue_date?.split('T')[0] || '',
  due_date: doc.due_date?.split('T')[0] || '',
  reference_po: doc.reference_po || '',
  payment_condition: doc.payment_condition || '',
  notes: doc.notes || '',
  discount_design: doc.discount_design || 0,
  discount_trade: doc.discount_trade || 0,
  apply_wht: doc.apply_wht !== false,
};
const cust = doc.customers || null;
// The picker list is capped; make sure this document's customer is always in it
const custList = cust && !customers.some((c: any) => c.id === cust.id) ? [cust, ...customers] : customers;
const isOpen = doc.status === 'draft' || doc.status === 'in_progress';
const isPublished = doc.status === 'published';
const st = statusInfo(doc.status);
const job = doc.jobs || null;

// Escape "<" so document text can never break out of the JSON <script> block.
const dataJson = JSON.stringify({
  custs: custList.map((c: any) => ({ id: c.id, customer_code: c.customer_code, company_name: c.company_name, tax_id: c.tax_id, phone: c.phone, address: c.address })),
  categories: doc.categories || [],
  items: doc.items || [],
  orig: { total: Number(doc.total_amount || 0), type: doc.document_type_id, customer: doc.customer_id },
  isPublished,
}).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="th">
<head>
  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dynjnftnu/image/upload/v1781103809/LOGO_TNC-02_xhpu0t.png"/>
  <link rel="apple-touch-icon" href="https://res.cloudinary.com/dynjnftnu/image/upload/v1781103809/LOGO_TNC-02_xhpu0t.png"/>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="robots" content="noindex,nofollow"/>
  <title>แก้ไข {doc.document_number} — TNC</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#F6F5F2;--white:#fff;--border:#E3E0DA;--line:#EEECE7;
      --text:#1A1814;--t2:#66635C;--t3:#A9A69F;
      --gold:#B8955A;--gbg:#FAF6EE;
      --green:#2D7A4F;--grbg:#EEF6F1;--red:#B23B3B;--redbg:#FBF0F0;--amber:#B97A26;--blue:#2D5A9E;
    }
    body{font-family:'Plus Jakarta Sans','Noto Sans Thai',sans-serif;background:var(--bg);color:var(--text);font-size:14px;-webkit-font-smoothing:antialiased;}
    a{color:inherit;}
    button,input,textarea,select{font-family:inherit;}
    button:focus{outline:none;} button:focus-visible,a:focus-visible{outline:2px solid var(--text);outline-offset:2px;}
    .ic{width:16px;height:16px;flex-shrink:0;}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}

    /* Top bar (same as document page) */
    .top{position:sticky;top:0;z-index:40;background:rgba(246,245,242,.92);backdrop-filter:saturate(1.4) blur(8px);-webkit-backdrop-filter:saturate(1.4) blur(8px);border-bottom:1px solid var(--line);}
    .top-in{max-width:1320px;margin:0 auto;padding:0 28px;height:58px;display:flex;align-items:center;gap:12px;}
    .back{display:inline-flex;align-items:center;gap:4px;height:34px;padding:0 10px 0 6px;border-radius:7px;font-size:13px;color:var(--t2);text-decoration:none;white-space:nowrap;}
    .back:hover{background:var(--white);color:var(--text);}
    .crumb{font-size:13px;color:var(--t3);display:flex;align-items:center;gap:8px;min-width:0;}
    .crumb b{color:var(--text);font-weight:600;}
    .spacer{flex:1;}
    .state{font-size:12.5px;color:var(--t3);display:flex;align-items:center;gap:7px;white-space:nowrap;}
    .state .dot{width:7px;height:7px;border-radius:50%;background:var(--t3);}
    .state.ok{color:var(--green);} .state.ok .dot{background:var(--green);}
    .state.warn{color:var(--amber);} .state.warn .dot{background:var(--amber);}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;padding:0 14px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;cursor:pointer;border:1px solid var(--border);background:var(--white);color:var(--text);white-space:nowrap;}
    .btn:hover{border-color:var(--text);}
    .btn-dark{background:var(--text);border-color:var(--text);color:var(--white);}
    .btn-dark:hover{opacity:.88;}
    .btn-sm{height:30px;padding:0 11px;font-size:12.5px;font-weight:500;border-radius:7px;}
    .btn-block{width:100%;height:42px;}
    .btn[disabled]{opacity:.55;cursor:default;}
    .linkbtn{border:none;background:none;padding:0;font-size:12.5px;color:var(--t2);cursor:pointer;text-decoration:underline;text-underline-offset:3px;}
    .linkbtn:hover{color:var(--text);}
    .linkbtn.danger:hover{color:var(--red);}

    /* Page */
    .wrap{max-width:1320px;margin:0 auto;padding:28px 28px 64px;}
    .hero{display:flex;align-items:flex-end;gap:24px;margin-bottom:24px;}
    .hero-main{flex:1;min-width:0;}
    .eyebrow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px;color:var(--t2);margin-bottom:8px;}
    .docno{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600;color:var(--text);font-size:14px;}
    .t-QUOTATION{color:var(--blue);} .t-INVOICE{color:var(--green);} .t-TAX_INVOICE{color:var(--red);}
    .pill{display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 10px;border-radius:13px;background:var(--white);border:1px solid var(--border);font-size:12.5px;font-weight:500;}
    .pill .dot{width:7px;height:7px;border-radius:50%;background:var(--t3);}
    .pill.published .dot{background:var(--green);} .pill.stale .dot{background:var(--amber);} .pill.removed .dot{background:var(--red);}
    .h1{font-size:26px;font-weight:700;letter-spacing:-.015em;line-height:1.25;margin-bottom:14px;}
    .jobline{font-size:14px;color:var(--t2);margin:-8px 0 14px;}
    .hero-amt{text-align:right;flex-shrink:0;}
    .hero-amt .l{font-size:12.5px;color:var(--t2);}
    .hero-amt .v{font-size:30px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.2;}
    .hero-amt .s{font-size:12.5px;color:var(--t2);margin-top:2px;font-variant-numeric:tabular-nums;min-height:18px;}
    .hero-amt .s.chg{color:var(--amber);}

    /* Type switch */
    .seg{display:inline-flex;background:#ECEAE5;border-radius:10px;padding:3px;gap:2px;max-width:100%;overflow-x:auto;}
    .seg button{height:34px;padding:0 16px;border:none;border-radius:8px;background:none;font-size:13.5px;font-weight:500;color:var(--t2);cursor:pointer;white-space:nowrap;}
    .seg button:hover{color:var(--text);}
    .seg button.on{background:var(--white);color:var(--text);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08);}

    .grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px;align-items:start;}
    .content,.side{min-width:0;}
    .card{background:var(--white);border:1px solid var(--border);border-radius:12px;}
    .card + .card{margin-top:16px;}
    .card-h{display:flex;align-items:center;gap:12px;padding:16px 20px 0;}
    .card-t{font-size:13px;font-weight:700;flex:1;}
    .card-n{font-size:12.5px;color:var(--t3);}
    .card-b{padding:14px 20px 20px;}

    /* Fields */
    .fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 20px;}
    .fields .full{grid-column:1 / -1;}
    .field{display:flex;flex-direction:column;gap:6px;min-width:0;}
    .field label,.flabel{font-size:12px;color:var(--t2);font-weight:500;}
    .inp{height:38px;padding:0 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;color:var(--text);background:var(--white);outline:none;width:100%;}
    .inp:hover{border-color:#CFCBC3;}
    .inp:focus{border-color:var(--text);}
    .inp::placeholder{color:var(--t3);}
    textarea.inp{height:auto;padding:10px 12px;line-height:1.7;resize:vertical;min-height:84px;}

    /* Customer picker */
    .picker{position:relative;}
    .picker .ic{position:absolute;left:12px;top:11px;color:var(--t3);}
    .picker .inp{padding-left:36px;}
    .dd{display:none;position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:60;background:var(--white);border:1px solid var(--border);border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.12);max-height:320px;overflow-y:auto;padding:4px;}
    .dd.open{display:block;}
    .opt{display:flex;align-items:baseline;gap:10px;padding:9px 10px;border-radius:7px;cursor:pointer;}
    .opt.act,.opt:hover{background:var(--bg);}
    .opt-n{font-size:13.5px;flex:1;min-width:0;}
    .opt-c{font-size:12px;color:var(--t3);white-space:nowrap;}
    .dd-empty{padding:14px 10px;font-size:13px;color:var(--t3);}
    .chosen{display:none;}
    .chosen.show{display:block;}
    .chosen-h{display:flex;align-items:baseline;gap:12px;margin-bottom:12px;}
    .chosen-n{font-size:16px;font-weight:700;flex:1;min-width:0;line-height:1.4;}
    .dt{font-size:12px;color:var(--t3);margin-bottom:3px;}
    .dd-v{font-size:13.5px;line-height:1.55;word-break:break-word;}
    .dd-v.muted{color:var(--t3);}

    .msg{display:none;margin-top:12px;padding:10px 12px;border-radius:8px;font-size:12.5px;line-height:1.6;}
    .msg.show{display:block;}
    .msg.warn{background:#FDF6EA;color:#8A5A12;}
    .msg.info{background:var(--gbg);color:#7A5C1E;}
    .msg a{font-weight:600;}

    /* BOQ */
    .cat{border-top:1px solid var(--line);}
    .cat-h{display:flex;align-items:center;gap:12px;padding:14px 20px 8px;}
    .cat-n{font-size:12px;color:var(--t3);font-weight:600;white-space:nowrap;}
    .cat-in{flex:1;min-width:0;height:34px;border:1px solid transparent;border-radius:7px;padding:0 8px;margin-left:-8px;font-size:14px;font-weight:600;color:var(--text);background:none;outline:none;}
    .cat-in:hover{border-color:var(--line);}
    .cat-in:focus{border-color:var(--text);background:var(--white);}
    .cat-in::placeholder{color:var(--t3);font-weight:500;}
    .cat-in.bad{border-color:var(--red);background:var(--redbg);}
    .cat-sum{font-size:13.5px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;}
    .tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;padding:0 12px;}
    .et{width:100%;border-collapse:collapse;table-layout:fixed;min-width:860px;font-variant-numeric:tabular-nums;}
    .et th{padding:8px 6px;font-size:11.5px;font-weight:600;color:var(--t3);text-align:left;border-bottom:1px solid var(--line);white-space:nowrap;}
    .et th.r{text-align:right;}
    .et td{padding:3px 2px;border-bottom:1px solid var(--line);vertical-align:middle;}
    .et tr:last-child td{border-bottom:none;}
    .et td input,.et td select{width:100%;height:34px;padding:0 8px;font-size:13px;color:var(--text);background:transparent;border:1px solid transparent;border-radius:7px;outline:none;}
    .et td input:hover,.et td select:hover{border-color:var(--line);}
    .et td input:focus,.et td select:focus{border-color:var(--text);background:var(--white);}
    .et td input[type=number]{text-align:right;}
    .et td input::placeholder{color:var(--t3);}
    .et td input:disabled{color:var(--t3);background:none;border-color:transparent;cursor:default;}
    .et .calc{display:block;text-align:right;padding:0 8px;font-size:13px;color:var(--t2);white-space:nowrap;}
    .et .calc.b{color:var(--text);font-weight:600;}
    .et tr.sub td{background:var(--bg);}
    .et tr.sub .sub-l{text-align:right;padding-right:10px;font-size:13px;font-weight:600;}
    .w-no{width:58px;}.w-code{width:64px;}.w-qty{width:72px;}.w-unit{width:88px;}.w-mon{width:104px;}.w-tot{width:118px;}.w-x{width:38px;}
    .et .calc small{display:block;font-size:11px;font-weight:400;color:var(--t3);margin-top:1px;white-space:normal;line-height:1.35;}
    .xbtn{width:30px;height:30px;border:none;border-radius:7px;background:none;color:var(--t3);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;}
    .xbtn:hover{background:var(--redbg);color:var(--red);}
    .cat-f{display:flex;align-items:center;gap:8px;padding:8px 20px 16px;}
    .cat-f .hint{margin-left:auto;}
    .hint{font-size:12px;color:var(--t3);line-height:1.6;}
    .boq-note{padding:0 20px 4px;}
    .empty{margin:6px 20px 20px;padding:36px 20px;text-align:center;border:1px dashed var(--border);border-radius:10px;}
    .empty-t{font-size:14px;font-weight:600;margin-bottom:4px;}
    .empty-s{font-size:12.5px;color:var(--t3);margin-bottom:14px;}

    /* Payment terms */
    .presets{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;}
    .inst-list{margin-top:12px;border-top:1px solid var(--line);}
    .inst{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px;}
    .inst-p{font-weight:700;min-width:42px;font-variant-numeric:tabular-nums;}
    .inst-l{flex:1;color:var(--t2);line-height:1.5;}
    .inst-a{font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums;}
    .inst-tot{display:flex;justify-content:space-between;padding:8px 0 0;font-size:12.5px;color:var(--t2);}
    .inst-tot.bad{color:var(--amber);font-weight:600;}

    /* Side */
    .side{position:sticky;top:78px;}
    .sumrow{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:6px 0;font-size:13px;color:var(--t2);font-variant-numeric:tabular-nums;}
    .sumrow span:last-child{color:var(--text);font-weight:500;}
    .sumrow .sinp{width:130px;height:32px;padding:0 10px;border:1px solid var(--border);border-radius:7px;font-size:13px;text-align:right;color:var(--text);background:var(--white);outline:none;font-variant-numeric:tabular-nums;}
    .sumrow .sinp:focus{border-color:var(--text);}
    .sumrow.total{border-top:1px solid var(--border);margin-top:6px;padding-top:12px;font-size:14px;color:var(--text);font-weight:600;}
    .sumrow.total span:last-child{font-size:18px;font-weight:700;}
    .sumrow.net{font-weight:600;color:var(--text);}
    .sumrow.net span:last-child{font-weight:700;}
    .sumrow.was{font-size:12.5px;color:var(--t3);}
    .sumrow.was span:last-child{color:var(--t3);font-weight:400;}
    .check{display:flex;align-items:center;gap:9px;padding:10px 0 4px;margin-top:6px;border-top:1px solid var(--line);font-size:13px;color:var(--t2);cursor:pointer;}
    .check input{width:16px;height:16px;accent-color:var(--text);}
    .wht{display:none;} .wht.show{display:block;}
    .acts{display:flex;flex-direction:column;gap:8px;padding:0 20px 20px;}
    .acts .linkbtn{align-self:center;margin-top:4px;}

    /* Confirm dialog (same as document page) */
    .overlay{display:none;position:fixed;inset:0;background:rgba(26,24,20,.45);z-index:200;align-items:center;justify-content:center;padding:16px;}
    .overlay.show{display:flex;}
    .modal{background:var(--white);border-radius:14px;width:480px;max-width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.25);}
    .modal-h{display:flex;align-items:flex-start;gap:12px;padding:20px 22px 0;}
    .modal-t{font-size:16px;font-weight:700;flex:1;}
    .modal-s{font-size:12.5px;color:var(--t2);margin-top:3px;}
    .modal .xbtn{width:32px;height:32px;color:var(--t2);}
    .modal .xbtn:hover{background:var(--bg);color:var(--text);}
    .modal-b{padding:16px 22px;}
    .modal-f{display:flex;gap:8px;padding:0 22px 20px;}
    .modal-f .btn{flex:1;height:42px;}
    .kv{display:flex;justify-content:space-between;gap:16px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13px;color:var(--t2);font-variant-numeric:tabular-nums;}
    .kv:last-child{border-bottom:none;}
    .kv span:last-child{color:var(--text);font-weight:600;text-align:right;}
    .chg-t{font-size:12px;color:var(--t3);font-weight:600;margin:14px 0 6px;}
    .chg{font-size:13px;line-height:1.55;padding:5px 0;border-bottom:1px solid var(--line);}
    .chg:last-child{border-bottom:none;}
    .chg b{font-weight:600;}
    .chg .k{display:inline-block;min-width:56px;font-size:12px;color:var(--t3);}
    .chg.add .k{color:var(--green);} .chg.del .k{color:var(--red);}
    .modal .msg{margin:0 0 4px;}

    /* Toast */
    .toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:300;display:none;align-items:center;gap:10px;padding:11px 18px;border-radius:10px;background:var(--text);color:var(--white);font-size:13px;font-weight:500;box-shadow:0 12px 32px rgba(0,0,0,.25);max-width:calc(100% - 32px);}
    .toast.show{display:flex;}
    .toast.err{background:var(--red);}
    .spin{display:none;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:sp .6s linear infinite;}
    .toast.loading .spin{display:block;}
    @keyframes sp{to{transform:rotate(360deg)}}

    @media(max-width:1020px){
      .grid{grid-template-columns:minmax(0,1fr);}
      .side{position:static;}
    }
    @media(max-width:640px){
      .top-in{padding:0 12px;height:54px;gap:8px;}
      .crumb,.state,.top .btn-cancel{display:none;}
      .wrap{padding:18px 12px 48px;}
      .hero{flex-direction:column;align-items:stretch;gap:14px;margin-bottom:18px;}
      .hero-amt{text-align:left;}
      .h1{font-size:21px;margin-bottom:12px;}
      .hero-amt .v{font-size:24px;}
      .seg{display:flex;}
      .seg button{flex:1;padding:0 10px;}
      .fields{grid-template-columns:1fr 1fr;gap:14px 12px;}
      .fields .ref{grid-column:1 / -1;}
      .card-h{padding:14px 16px 0;} .card-b{padding:12px 16px 16px;}
      .cat-h{padding:12px 16px 6px;} .cat-f{padding:8px 16px 14px;} .boq-note{padding:0 16px 4px;}
      .empty{margin:6px 16px 16px;}
      .tbl-wrap{overflow:visible;padding:0 16px;}
      .et,.et tbody{display:block;min-width:0;}
      .et thead{display:none;}
      .et tr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) 34px;grid-template-areas:"no desc desc x" "qty unit code code" "mat lab up up" "tot tot tot tot";gap:6px 8px;padding:12px 0;border-bottom:1px solid var(--line);}
      .et tr:last-child{border-bottom:none;}
      .et td{display:block;border:none;padding:0;width:auto!important;min-width:0;}
      .et td[data-l]::before{content:attr(data-l);display:block;font-size:11px;color:var(--t3);margin:0 0 2px 2px;}
      .et td input,.et td select{border-color:var(--line);height:38px;}
      .et td input:disabled{border-color:var(--line);background:var(--bg);}
      .et td.a-no{grid-area:no;} .et td.a-desc{grid-area:desc;} .et td.a-x{grid-area:x;}
      .et td.a-qty{grid-area:qty;} .et td.a-unit{grid-area:unit;} .et td.a-code{grid-area:code;}
      .et td.a-mat{grid-area:mat;} .et td.a-lab{grid-area:lab;} .et td.a-up{grid-area:up;} .et td.a-tot{grid-area:tot;padding-top:2px;}
      .et tr.sub{grid-template-areas:"subl subl tot x";background:var(--bg);margin:0 -16px;padding:10px 16px;align-items:center;}
      .et tr.sub td{background:none;}
      .et tr.sub .sub-l{grid-area:subl;text-align:left;padding:0;}
      .et tr.sub .a-tot{padding:0;}
      .et .calc{padding:0 2px;}
      .et .calc small{white-space:normal;}
      .acts{padding:0 16px 16px;}
      .modal-f{flex-direction:column-reverse;}
      input,select,textarea{font-size:16px!important;}
    }
  </style>
</head>
<body>
  <header class="top">
    <div class="top-in">
      <a href={`/documents/${id}`} class="back"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg><span class="mono">{doc.document_number}</span></a>
      <div class="crumb"><span>/</span><b>แก้ไข</b></div>
      <span class="spacer"></span>
      <span class="state" id="state"><span class="dot"></span><span id="stateTxt">ยังไม่มีการเปลี่ยนแปลง</span></span>
      <a href={`/documents/${id}`} class="btn btn-cancel">ยกเลิก</a>
      <button type="button" class="btn btn-dark" data-save="open">บันทึก</button>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="hero-main">
        <div class="eyebrow">
          <span class="docno">{doc.document_number}</span>
          <span class={`t-${curType.code}`} id="typeLbl">{curType.label}</span>
          <span class={`pill ${st.cls}`}><span class="dot"></span>{st.label}</span>
        </div>
        <h1 class="h1">แก้ไขเอกสาร</h1>
        {job && <div class="jobline">{job.name}</div>}
        <div class="seg" id="typeSeg" role="tablist">
          {types.map((t: any) => <button type="button" data-id={t.id} data-code={t.code} class={t.id === curType.id ? 'on' : ''}>{t.label}</button>)}
        </div>
        <input type="hidden" id="docType" value={curType.id}/>
      </div>
      <div class="hero-amt">
        <div class="l">ยอดรวมทั้งสิ้น</div>
        <div class="v" id="hTot">฿0.00</div>
        <div class="s" id="hNet"></div>
      </div>
    </section>

    <div class="grid">
      <div class="content">
        {isPublished && (
          <div class="msg warn show" style="margin:0 0 16px;">
            {curType.code === 'TAX_INVOICE'
              ? 'ใบกำกับภาษีนี้ออกให้ลูกค้าแล้ว การแก้ไขจะมีผลกับเอกสารทันที หากเปลี่ยนยอดหรือวันที่ ต้องพิมพ์ใหม่และแจ้งฝ่ายบัญชี'
              : 'เอกสารนี้เผยแพร่แล้ว ลูกค้าอาจเปิดดูอยู่ การแก้ไขจะมีผลกับเอกสารทันที'}
          </div>
        )}
        <div class="msg warn" id="typeWarn" style="margin:0 0 16px;"></div>

        <section class="card">
          <div class="card-h">
            <div class="card-t">ลูกค้า</div>
            <a href="/documents/customers/new" class="linkbtn">เพิ่มลูกค้าใหม่</a>
          </div>
          <div class="card-b">
            <div class="picker" id="picker" style="display:none;">
              <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input type="text" class="inp" id="custSearch" placeholder="พิมพ์ชื่อบริษัท รหัส หรือเลขผู้เสียภาษี" autocomplete="off" spellcheck="false"/>
              <div class="dd" id="custDD"></div>
            </div>
            <input type="hidden" id="custId" value={existingDoc.customer_id || ''}/>
            <div class="chosen" id="chosen">
              <div class="chosen-h">
                <div class="chosen-n" id="cName"></div>
                <button type="button" class="linkbtn" id="custChange">เปลี่ยนลูกค้า</button>
              </div>
              <div class="fields">
                <div><div class="dt">รหัสลูกค้า</div><div class="dd-v mono" id="cCode"></div></div>
                <div><div class="dt">เลขประจำตัวผู้เสียภาษี</div><div class="dd-v mono" id="cTax"></div></div>
                <div><div class="dt">โทรศัพท์</div><div class="dd-v" id="cPhone"></div></div>
                <div class="full"><div class="dt">ที่อยู่</div><div class="dd-v" id="cAddr"></div></div>
              </div>
              <div class="msg warn" id="custWarn"></div>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-h"><div class="card-t">รายละเอียดเอกสาร</div></div>
          <div class="card-b">
            <div class="fields">
              <div class="field">
                <label for="issueDate" id="issueLbl">วันที่ออก</label>
                <input type="date" class="inp" id="issueDate" value={existingDoc.issue_date}/>
              </div>
              <div class="field">
                <label for="dueDate" id="dueLbl">ราคามีผลถึง</label>
                <input type="date" class="inp" id="dueDate" value={existingDoc.due_date}/>
              </div>
              <div class="field ref">
                <label for="refPO">อ้างอิง P/O</label>
                <input type="text" class="inp" id="refPO" value={existingDoc.reference_po} placeholder="ไม่บังคับ"/>
              </div>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-h">
            <div class="card-t">รายการงาน</div>
            <span class="card-n" id="boqCnt"></span>
            <button type="button" class="btn btn-sm" data-act="addCat">เพิ่มหมวดงาน</button>
          </div>
          <div class="hint boq-note" style="padding-top:6px;">ใส่ค่าวัสดุและค่าแรงต่อหน่วย หรือใส่ราคาต่อหน่วยอย่างเดียวก็ได้ (ราคา/หน่วยจะคำนวณให้เองเมื่อมีค่าวัสดุหรือค่าแรง)</div>
          <div id="catsWrap" style="padding-top:6px;"></div>
        </section>

        <section class="card">
          <div class="card-h"><div class="card-t">เงื่อนไขชำระเงิน</div></div>
          <div class="card-b">
            <textarea class="inp" id="payCond" rows="4" placeholder="พิมพ์ทีละบรรทัด เช่น&#10;50% เมื่อตกลงทำสัญญา&#10;50% เมื่อส่งมอบงาน">{existingDoc.payment_condition}</textarea>
            <div class="presets">
              <button type="button" class="btn btn-sm" data-preset="30% เมื่อตกลงทำสัญญา\n20% เมื่อผนังแล้วเสร็จ\n30% เมื่อติดตั้งเฟอร์นิเจอร์\n20% เมื่อส่งมอบงาน">4 งวด</button>
              <button type="button" class="btn btn-sm" data-preset="50% เมื่อตกลงทำสัญญา\n50% เมื่อส่งมอบงาน">50 / 50</button>
              <button type="button" class="btn btn-sm" data-preset="100% เมื่อส่งมอบงาน">ชำระเต็มจำนวน</button>
            </div>
            <div id="instList"></div>
          </div>
        </section>

        <section class="card">
          <div class="card-h"><div class="card-t">หมายเหตุ</div><span class="card-n">แสดงบน PDF</span></div>
          <div class="card-b">
            <textarea class="inp" id="docNotes" rows="3" placeholder="ไม่บังคับ">{existingDoc.notes}</textarea>
          </div>
        </section>
      </div>

      <aside class="side">
        <section class="card">
          <div class="card-h"><div class="card-t">สรุปยอด</div></div>
          <div class="card-b">
            <div class="sumrow"><span>รวมจำนวนเงิน</span><span id="rSub">฿0.00</span></div>
            <div class="sumrow"><label for="dD">ส่วนลดค่าแบบ</label><input class="sinp" type="number" id="dD" value={existingDoc.discount_design} min="0" step="0.01" inputmode="decimal"/></div>
            <div class="sumrow"><label for="dT">ส่วนลดการค้า</label><input class="sinp" type="number" id="dT" value={existingDoc.discount_trade} min="0" step="0.01" inputmode="decimal"/></div>
            <div class="sumrow"><span>ราคาก่อน VAT</span><span id="rBV">฿0.00</span></div>
            <div class="sumrow"><span>VAT 7%</span><span id="rVAT">฿0.00</span></div>
            <div class="sumrow total"><span>ยอดรวมทั้งสิ้น</span><span id="rTot">฿0.00</span></div>
            <div class="sumrow was" id="rWasRow" style="display:none;"><span>ยอดเดิมก่อนแก้ไข</span><span id="rWas"></span></div>
            <label class="check"><input type="checkbox" id="applyWht" checked={existingDoc.apply_wht}/>หักภาษี ณ ที่จ่าย 3%</label>
            <div class="wht show" id="whtRows">
              <div class="sumrow"><span>หัก ณ ที่จ่าย 3%</span><span id="rWht">฿0.00</span></div>
              <div class="sumrow net"><span>ยอดโอนสุทธิ</span><span id="rNet">฿0.00</span></div>
            </div>
          </div>
          <div class="acts">
            <button type="button" class="btn btn-dark btn-block" data-save="open">{isOpen ? 'บันทึกและเปิดเอกสาร' : 'บันทึกการแก้ไข'}</button>
            {isOpen && <button type="button" class="btn btn-block" data-save="preview">บันทึกและดู PDF</button>}
            {isOpen && <button type="button" class="linkbtn" data-save="draft">บันทึกไว้ก่อน</button>}
            <a href={`/documents/${id}`} class="linkbtn" style="align-self:center;margin-top:4px;">ยกเลิกการแก้ไข</a>
          </div>
        </section>
      </aside>
    </div>
  </main>

  <div class="overlay" id="confirmModal">
    <div class="modal">
      <div class="modal-h">
        <div style="flex:1;"><div class="modal-t">ยืนยันการบันทึก</div><div class="modal-s">{doc.document_number} · <span id="mCust"></span></div></div>
        <button type="button" class="xbtn" aria-label="ปิด" data-close><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="modal-b">
        {isPublished && <div class="msg warn show">เอกสารนี้เผยแพร่แล้ว การแก้ไขจะมีผลกับเอกสารทันที</div>}
        <div id="mBody"></div>
      </div>
      <div class="modal-f">
        <button type="button" class="btn" data-close>กลับไปแก้ไข</button>
        <button type="button" class="btn btn-dark" id="mConfirm">ยืนยันบันทึก</button>
      </div>
    </div>
  </div>

  <div id="toast" class="toast"><div class="spin"></div><span id="tMsg"></span></div>
  <script type="application/json" id="editData" set:html={dataJson}></script>

<script is:inline>
(function(){
  var D = JSON.parse(document.getElementById('editData').textContent);
  var CUSTS = D.custs;
  var UNITS = ['งาน','ตร.ม.','เมตร','ชุด','ชิ้น','จุด','เส้น','ตู้','คู่','ลิตร','ใบ','แผ่น'];
  var cats = [], ibc = {}, cc = 0, ic = 0;
  var busy = false, dirty = false, boqModified = false, typeCode = '', lastSaved = null;
  var $ = function(id){ return document.getElementById(id); };

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function fmt(n) { return Number(n||0).toLocaleString('th-TH', {minimumFractionDigits:2, maximumFractionDigits:2}); }
  function baht(n) { return '฿' + fmt(n); }
  function r2(n) { return Math.round((Number(n) || 0) * 100 + Number.EPSILON) / 100; }
  function num(v) { return parseFloat(v) || 0; }

  // Same rule as computeItemAmount() in lib/documents.ts (what the server saves)
  function amtOf(it) {
    var q = num(it.qty), mc = num(it.mat), lc = num(it.lab);
    if (mc + lc > 0) return r2(q * mc) + r2(q * lc);
    var mt = num(it.matT), lt = num(it.labT);
    if (mt + lt > 0) return r2(mt + lt);
    var up = num(it.price);
    if (up > 0) return r2(q * up);
    return r2(num(it.amt));
  }

  /* ── Load the document's existing BOQ ── */
  (D.categories || []).forEach(function(cat){
    cc++; var tid = 'c' + cc;
    cats.push({ tid: tid, num: cat.category_number, name: cat.name_th || '' });
    ibc[tid] = (D.items || []).filter(function(i){ return i.category_id === cat.id; }).map(function(i){
      ic++;
      var it = { id: 'i' + ic, num: i.item_number || '', code: i.item_code || '', desc: i.description_th || '',
        qty: i.quantity || 0, unit: i.unit_th || (i.is_subtotal_row ? '' : 'งาน'),
        price: i.unit_price || 0, mat: i.material_cost || 0, matT: i.material_total || 0,
        lab: i.labor_cost || 0, labT: i.labor_total || 0, amt: i.amount || 0, sub: !!i.is_subtotal_row };
      if (!it.sub) {
        it.amt = amtOf(it);
        if (num(it.mat) + num(it.lab) > 0) it.price = r2(num(it.mat) + num(it.lab)); // shown read-only
      }
      return it;
    });
  });
  // Snapshot for the "what changed" summary in the confirm dialog
  var orig = {};
  cats.forEach(function(c){ (ibc[c.tid]||[]).forEach(function(i){ if (!i.sub) orig[i.id] = { desc: i.desc, qty: num(i.qty), up: num(i.price), mat: num(i.mat), lab: num(i.lab), amt: i.amt }; }); });
  var origCats = cats.map(function(c){ return c.name; }).join('|');

  function markBOQ() { boqModified = true; markDirty(); }
  function markDirty() {
    dirty = true;
    $('state').className = 'state warn';
    $('stateTxt').textContent = 'มีการแก้ไขที่ยังไม่บันทึก';
  }

  /* ── Totals ── */
  function totals() {
    var sub = 0;
    cats.forEach(function(c){ (ibc[c.tid]||[]).forEach(function(i){ if (!i.sub) sub += num(i.amt); }); });
    sub = r2(sub);
    var bv = r2(sub - num($('dD').value) - num($('dT').value));
    var vat = r2(bv * 0.07);
    var tot = r2(bv + vat);
    var wht = $('applyWht').checked ? r2(bv * 0.03) : 0;
    return { sub: sub, bv: bv, vat: vat, tot: tot, wht: wht, net: r2(tot - wht) };
  }
  function recalc() {
    var t = totals(), w = $('applyWht').checked;
    $('rSub').textContent = baht(t.sub);
    $('rBV').textContent = baht(t.bv);
    $('rVAT').textContent = baht(t.vat);
    $('rTot').textContent = baht(t.tot);
    $('rWht').textContent = '−' + baht(t.wht);
    $('rNet').textContent = baht(t.net);
    $('whtRows').classList.toggle('show', w);
    $('hTot').textContent = baht(t.tot);
    var changed = Math.abs(t.tot - D.orig.total) >= 0.005;
    $('rWasRow').style.display = changed ? '' : 'none';
    $('rWas').textContent = baht(D.orig.total);
    var hs = $('hNet');
    if (changed) { hs.textContent = 'ยอดเดิม ' + baht(D.orig.total); hs.className = 's chg'; }
    else { hs.textContent = w && t.tot > 0 && typeCode !== 'TAX_INVOICE' ? 'โอนสุทธิหลังหัก ณ ที่จ่าย ' + baht(t.net) : ''; hs.className = 's'; }
    renderInst(t.tot);
  }

  /* ── Payment terms preview ── */
  function renderInst(total) {
    var lines = $('payCond').value.split('\n').map(function(l){ return l.trim(); }).filter(Boolean);
    var rows = [], pct = 0;
    lines.forEach(function(l){
      var m = l.match(/^(\d+(?:\.\d+)?)\s*%\s*(.*)/);
      if (m) { var p = parseFloat(m[1]); pct += p; rows.push({ p: p, l: m[2] || l, a: r2(total * p / 100) }); }
    });
    if (!rows.length) { $('instList').innerHTML = ''; return; }
    var ok = Math.abs(pct - 100) < 0.001;
    $('instList').innerHTML = '<div class="inst-list">' + rows.map(function(r){
      return '<div class="inst"><span class="inst-p">' + r.p + '%</span><span class="inst-l">' + esc(r.l) + '</span><span class="inst-a">' + (total > 0 ? baht(r.a) : '') + '</span></div>';
    }).join('') + '<div class="inst-tot' + (ok ? '' : ' bad') + '"><span>' + (ok ? 'รวมครบ 100%' : 'รวม ' + pct + '% (ยังไม่เท่ากับ 100%)') + '</span><span>' + (total > 0 ? 'จากยอด ' + baht(total) : '') + '</span></div></div>';
  }

  /* ── Document type ── */
  var LABELS = {
    QUOTATION:   ['วันที่ออก', 'ราคามีผลถึง'],
    BOQ:         ['วันที่ออก', 'ราคามีผลถึง'],
    INVOICE:     ['วันที่ออก', 'กำหนดชำระ'],
    TAX_INVOICE: ['วันที่รับชำระเงิน', 'กำหนดชำระ']
  };
  function setType(btn, user) {
    [].forEach.call($('typeSeg').children, function(b){ b.classList.toggle('on', b === btn); });
    $('docType').value = btn.getAttribute('data-id');
    typeCode = btn.getAttribute('data-code');
    var L = LABELS[typeCode] || LABELS.QUOTATION;
    $('issueLbl').textContent = L[0];
    $('dueLbl').textContent = L[1];
    var lbl = $('typeLbl'); lbl.textContent = btn.textContent; lbl.className = 't-' + typeCode;
    var tw = $('typeWarn');
    if ($('docType').value !== D.orig.type) {
      tw.textContent = 'คุณกำลังเปลี่ยนประเภทเอกสาร เลขที่เอกสารจะยังเป็นเลขเดิม ไม่ได้ออกเลขใหม่ตามประเภท';
      tw.classList.add('show');
    } else tw.classList.remove('show');
    showCustWarn();
    if (user) markDirty();
    recalc();
  }
  $('typeSeg').addEventListener('click', function(e){ var b = e.target.closest('button'); if (b) setType(b, true); });

  /* ── Customer picker ── */
  var custById = {}; CUSTS.forEach(function(c){ custById[c.id] = c; });
  var ddList = [], ddIdx = -1;
  function norm(s) { return String(s||'').toLowerCase().replace(/\s+/g, ''); }
  function filterCusts(q) {
    q = norm(q);
    if (!q) return CUSTS.slice();
    return CUSTS.filter(function(c){ return norm(c.company_name).indexOf(q) >= 0 || norm(c.customer_code).indexOf(q) >= 0 || norm(c.tax_id).indexOf(q) >= 0; });
  }
  function renderDD() {
    var dd = $('custDD');
    if (!ddList.length) { dd.innerHTML = '<div class="dd-empty">ไม่พบลูกค้า</div>'; return; }
    dd.innerHTML = ddList.slice(0, 30).map(function(c, i){
      return '<div class="opt' + (i === ddIdx ? ' act' : '') + '" data-cid="' + esc(c.id) + '"><span class="opt-n">' + esc(c.company_name) + '</span><span class="opt-c mono">' + esc(c.customer_code || '') + '</span></div>';
    }).join('');
  }
  function openDD() { ddList = filterCusts($('custSearch').value); ddIdx = ddList.length ? 0 : -1; renderDD(); $('custDD').classList.add('open'); }
  function closeDD() { $('custDD').classList.remove('open'); }
  function pickCust(c, user) {
    $('custId').value = c.id;
    $('cName').textContent = c.company_name;
    $('mCust').textContent = c.company_name;
    var set = function(id, v, empty){ var el = $(id); el.textContent = v || empty; el.classList.toggle('muted', !v); };
    set('cCode', c.customer_code, '—');
    set('cTax', c.tax_id, 'ยังไม่มีข้อมูล');
    set('cPhone', c.phone, '—');
    set('cAddr', c.address, 'ยังไม่มีข้อมูล');
    $('picker').style.display = 'none';
    $('chosen').classList.add('show');
    closeDD();
    showCustWarn();
    if (user) markDirty();
  }
  function showCustWarn() {
    var c = custById[$('custId').value], w = $('custWarn');
    if (!c) { w.classList.remove('show'); return; }
    var miss = [];
    if (!/^\d{13}$/.test(String(c.tax_id || '').replace(/\D/g, ''))) miss.push('เลขประจำตัวผู้เสียภาษี 13 หลัก');
    if (!String(c.address || '').trim()) miss.push('ที่อยู่');
    if (!miss.length) { w.classList.remove('show'); return; }
    var strong = typeCode === 'TAX_INVOICE' || typeCode === 'INVOICE';
    w.innerHTML = 'ลูกค้ายังไม่มี' + miss.join('และ') + (strong ? ' ต้องมีก่อนออกใบกำกับภาษี' : ' ควรเพิ่มก่อนออกใบกำกับภาษี') + ' · <a href="/documents/customers/' + esc(c.id) + '" target="_blank">แก้ไขข้อมูลลูกค้า</a>';
    w.classList.add('show');
  }
  $('custSearch').addEventListener('focus', openDD);
  $('custSearch').addEventListener('input', openDD);
  $('custSearch').addEventListener('keydown', function(e){
    if (!$('custDD').classList.contains('open')) return;
    var n = Math.min(ddList.length, 30);
    if (e.key === 'ArrowDown') { e.preventDefault(); ddIdx = n ? (ddIdx + 1) % n : -1; renderDD(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); ddIdx = n ? (ddIdx - 1 + n) % n : -1; renderDD(); }
    else if (e.key === 'Enter') { e.preventDefault(); if (ddIdx >= 0 && ddList[ddIdx]) pickCust(ddList[ddIdx], true); }
    else if (e.key === 'Escape') { closeDD(); }
  });
  $('custDD').addEventListener('mousedown', function(e){
    e.preventDefault();
    var o = e.target.closest('[data-cid]');
    if (o && custById[o.getAttribute('data-cid')]) pickCust(custById[o.getAttribute('data-cid')], true);
  });
  document.addEventListener('click', function(e){ if (!e.target.closest('#picker')) closeDD(); });
  $('custChange').addEventListener('click', function(){
    $('custId').value = '';
    $('chosen').classList.remove('show');
    $('picker').style.display = '';
    $('custSearch').value = '';
    $('custSearch').focus();
  });

  /* ── BOQ ── */
  var X_ICON = '<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
  function unitOpts(sel) {
    var list = UNITS.indexOf(sel) < 0 && sel ? UNITS.concat([sel]) : UNITS;
    return list.map(function(u){ return '<option' + (u === sel ? ' selected' : '') + '>' + esc(u) + '</option>'; }).join('');
  }
  function catSum(tid) { return r2((ibc[tid]||[]).filter(function(i){ return !i.sub; }).reduce(function(s,i){ return s + num(i.amt); }, 0)); }
  function updCnt() {
    var n = cats.reduce(function(s,c){ return s + (ibc[c.tid]||[]).filter(function(i){ return !i.sub; }).length; }, 0);
    $('boqCnt').textContent = cats.length ? cats.length + ' หมวด · ' + n + ' รายการ' : '';
  }
  function usesCost(it) { return num(it.mat) + num(it.lab) > 0; }
  function inp(cat, item, f, type, extra) {
    return '<input type="' + type + '" data-t="' + cat.tid + '" data-i="' + item.id + '" data-f="' + f + '" value="' + esc(item[f]) + '"' + (extra || '') + '/>';
  }
  function render() {
    var w = $('catsWrap');
    if (!cats.length) {
      w.innerHTML = '<div class="empty"><div class="empty-t">ยังไม่มีรายการงาน</div><div class="empty-s">เริ่มจากเพิ่มหมวดงาน แล้วใส่รายการในหมวด</div><button type="button" class="btn btn-dark" data-act="addCat">เพิ่มหมวดงานแรก</button></div>';
      updCnt(); return;
    }
    w.innerHTML = cats.map(function(cat){
      var items = ibc[cat.tid] || [];
      var rows = items.map(function(it){
        var del = '<td class="w-x a-x"><button type="button" class="xbtn" data-act="delItem" data-t="' + cat.tid + '" data-i="' + it.id + '" aria-label="ลบแถว">' + X_ICON + '</button></td>';
        if (it.sub) {
          return '<tr class="sub"><td colspan="8" class="sub-l">' + esc(it.desc) + '</td><td class="w-tot a-tot"><span class="calc b" id="a_' + it.id + '">' + baht(it.amt) + '</span></td>' + del + '</tr>';
        }
        return '<tr>'
          + '<td class="w-no a-no" data-l="ลำดับ">' + inp(cat, it, 'num', 'text', ' placeholder="1.1"') + '</td>'
          + '<td class="w-code a-code" data-l="รหัส">' + inp(cat, it, 'code', 'text', ' placeholder="ไม่บังคับ"') + '</td>'
          + '<td class="a-desc" data-l="รายการ">' + inp(cat, it, 'desc', 'text', ' placeholder="รายละเอียดงาน" id="d_' + it.id + '"') + '</td>'
          + '<td class="w-qty a-qty" data-l="จำนวน">' + inp(cat, it, 'qty', 'number', ' min="0" step="0.001" inputmode="decimal"') + '</td>'
          + '<td class="w-unit a-unit" data-l="หน่วย"><select data-t="' + cat.tid + '" data-i="' + it.id + '" data-f="unit">' + unitOpts(it.unit) + '</select></td>'
          + '<td class="w-mon a-mat" data-l="ค่าวัสดุ/หน่วย">' + inp(cat, it, 'mat', 'number', ' min="0" step="0.01" inputmode="decimal"') + '</td>'
          + '<td class="w-mon a-lab" data-l="ค่าแรง/หน่วย">' + inp(cat, it, 'lab', 'number', ' min="0" step="0.01" inputmode="decimal"') + '</td>'
          + '<td class="w-mon a-up" data-l="ราคา/หน่วย">' + inp(cat, it, 'price', 'number', ' min="0" step="0.01" inputmode="decimal" id="p_' + it.id + '"' + (usesCost(it) ? ' disabled' : '')) + '</td>'
          + '<td class="w-tot a-tot"><span class="calc b" id="a_' + it.id + '">' + amtHtml(it) + '</span></td>'
          + del + '</tr>';
      }).join('');
      var n = items.filter(function(i){ return !i.sub; }).length;
      return '<div class="cat">'
        + '<div class="cat-h"><span class="cat-n">หมวด ' + esc(cat.num) + '</span>'
        + '<input class="cat-in" id="cn_' + cat.tid + '" data-cat="' + cat.tid + '" value="' + esc(cat.name) + '" placeholder="ชื่อหมวดงาน"/>'
        + '<span class="cat-sum" id="cs_' + cat.tid + '">' + baht(catSum(cat.tid)) + '</span>'
        + '<button type="button" class="linkbtn danger" data-act="delCat" data-t="' + cat.tid + '">ลบหมวด</button></div>'
        + (items.length
          ? '<div class="tbl-wrap"><table class="et"><thead><tr>'
            + '<th class="w-no">ลำดับ</th><th class="w-code">รหัส</th><th>รายการ</th><th class="w-qty r">จำนวน</th><th class="w-unit">หน่วย</th>'
            + '<th class="w-mon r">ค่าวัสดุ/หน่วย</th><th class="w-mon r">ค่าแรง/หน่วย</th><th class="w-mon r">ราคา/หน่วย</th><th class="w-tot r">รวม</th><th class="w-x"></th>'
            + '</tr></thead><tbody>' + rows + '</tbody></table></div>'
          : '<div class="hint" style="padding:4px 20px 6px;">ยังไม่มีรายการในหมวดนี้</div>')
        + '<div class="cat-f"><button type="button" class="btn btn-sm" data-act="addItem" data-t="' + cat.tid + '">เพิ่มรายการ</button>'
        + '<button type="button" class="btn btn-sm" data-act="addSub" data-t="' + cat.tid + '">เพิ่มแถวรวม</button>'
        + '<span class="hint">' + n + ' รายการ</span></div></div>';
    }).join('');
    updCnt();
  }
  // Row total, with the material / labour split underneath when both are used
  function amtHtml(it) {
    var s = baht(it.amt);
    if (num(it.mat) > 0 && num(it.lab) > 0) s += '<small>วัสดุ ' + fmt(it.matT) + ' · แรง ' + fmt(it.labT) + '</small>';
    return s;
  }
  function findItem(tid, iid) { return (ibc[tid]||[]).find(function(i){ return i.id === iid; }); }
  function refreshSubs(tid) {
    var s = catSum(tid);
    (ibc[tid]||[]).forEach(function(i){ if (i.sub) { i.amt = s; var el = $('a_' + i.id); if (el) el.textContent = baht(s); } });
    var el = $('cs_' + tid); if (el) el.textContent = baht(s);
  }
  var ACT = {
    addCat: function(){
      cc++; var tid = 'c' + cc;
      cats.push({ tid: tid, num: cats.length + 1, name: '' });
      ibc[tid] = [];
      markBOQ(); render();
      var el = $('cn_' + tid); if (el) el.focus();
    },
    delCat: function(b){
      var tid = b.getAttribute('data-t');
      if (!confirm('ลบหมวดงานนี้และรายการทั้งหมดในหมวด?')) return;
      cats = cats.filter(function(c){ return c.tid !== tid; });
      delete ibc[tid];
      cats.forEach(function(c, i){ c.num = i + 1; });
      markBOQ(); render(); recalc();
    },
    addItem: function(b){
      var tid = b.getAttribute('data-t');
      var cat = cats.find(function(c){ return c.tid === tid; });
      var n = (ibc[tid]||[]).filter(function(i){ return !i.sub; }).length;
      ic++; var id = 'i' + ic;
      ibc[tid].push({ id: id, num: cat.num + '.' + (n + 1), code: '', desc: '', qty: 1, unit: 'งาน', price: 0, mat: 0, matT: 0, lab: 0, labT: 0, amt: 0, sub: false });
      markBOQ(); render();
      var el = $('d_' + id); if (el) el.focus();
    },
    addSub: function(b){
      var tid = b.getAttribute('data-t');
      var cat = cats.find(function(c){ return c.tid === tid; });
      ic++;
      ibc[tid].push({ id: 'i' + ic, num: '', code: '', desc: 'รวมราคา' + (cat.name || ''), qty: 0, unit: '', price: 0, amt: catSum(tid), sub: true });
      markBOQ(); render();
    },
    delItem: function(b){
      var tid = b.getAttribute('data-t'), iid = b.getAttribute('data-i');
      ibc[tid] = (ibc[tid]||[]).filter(function(i){ return i.id !== iid; });
      markBOQ(); render(); refreshSubs(tid); recalc();
    }
  };
  document.addEventListener('click', function(e){
    var b = e.target.closest('[data-act]');
    if (b && ACT[b.getAttribute('data-act')]) ACT[b.getAttribute('data-act')](b);
  });
  function onItemInput(el) {
    var tid = el.getAttribute('data-t'), iid = el.getAttribute('data-i'), f = el.getAttribute('data-f');
    var it = findItem(tid, iid); if (!it) return;
    it[f] = el.value;
    markBOQ();
    if (f === 'qty' || f === 'mat' || f === 'lab' || f === 'price') {
      var q = num(it.qty), mc = num(it.mat), lc = num(it.lab);
      if (mc + lc > 0) {
        it.matT = r2(q * mc); it.labT = r2(q * lc);
        it.price = r2(mc + lc); // same as the old edit page: price per unit = material + labour
      } else if (f === 'mat' || f === 'lab') {
        it.matT = 0; it.labT = 0;
      }
      it.amt = amtOf(it);
      var pe = $('p_' + iid);
      if (pe && f !== 'price') { pe.disabled = mc + lc > 0; if (mc + lc > 0) pe.value = it.price; }
      $('a_' + iid).innerHTML = amtHtml(it);
      refreshSubs(tid); recalc(); updCnt();
    }
  }
  $('catsWrap').addEventListener('input', function(e){
    var el = e.target;
    if (el.hasAttribute('data-cat')) {
      var c = cats.find(function(x){ return x.tid === el.getAttribute('data-cat'); });
      if (c) c.name = el.value;
      el.classList.remove('bad');
      markBOQ();
    }
    else if (el.hasAttribute('data-f')) onItemInput(el);
  });
  $('catsWrap').addEventListener('change', function(e){ if (e.target.tagName === 'SELECT') onItemInput(e.target); });
  // Enter in a row's description jumps to a new row, like a spreadsheet
  $('catsWrap').addEventListener('keydown', function(e){
    var el = e.target;
    if (e.key === 'Enter' && el.getAttribute('data-f') === 'desc') { e.preventDefault(); ACT.addItem(el); }
  });

  /* ── Other inputs ── */
  $('dD').addEventListener('input', recalc);
  $('dT').addEventListener('input', recalc);
  $('applyWht').addEventListener('change', recalc);
  $('payCond').addEventListener('input', recalc);
  document.querySelectorAll('[data-preset]').forEach(function(b){
    b.addEventListener('click', function(){ $('payCond').value = b.getAttribute('data-preset').replace(/\\n/g, '\n'); recalc(); markDirty(); });
  });
  document.querySelector('.wrap').addEventListener('input', function(e){ if (!e.target.closest('#custSearch')) markDirty(); });
  document.querySelector('.wrap').addEventListener('change', function(e){ if (e.target.id === 'applyWht') markDirty(); });
  window.addEventListener('beforeunload', function(e){ if (dirty) { e.preventDefault(); e.returnValue = ''; } });

  /* ── Save (same payload as before: saveDocument keeps the status and number) ── */
  function build() {
    var cid = $('custId').value;
    if (!cid) { toast('กรุณาเลือกลูกค้าก่อน', true); $('picker').style.display = ''; $('custSearch').focus(); return null; }
    if (!cats.length && !confirm('ยังไม่มีรายการงาน ต้องการบันทึกโดยไม่มีรายการงานหรือไม่?')) return null;
    if (boqModified) {
      var unnamed = cats.filter(function(c){ return !String(c.name || '').trim(); });
      if (unnamed.length) {
        unnamed.forEach(function(c){ var el = $('cn_' + c.tid); if (el) el.classList.add('bad'); });
        var first = $('cn_' + unnamed[0].tid); if (first) first.focus();
        toast('กรุณาตั้งชื่อหมวดงาน: หมวด ' + unnamed.map(function(c){ return c.num; }).join(', '), true);
        return null;
      }
    }
    var items = [].concat.apply([], cats.map(function(c){
      return (ibc[c.tid]||[]).map(function(i){
        return { item_number: i.num, item_code: i.code, description_th: i.desc,
          quantity: num(i.qty), unit_th: i.unit,
          unit_price: num(i.price),
          material_cost: num(i.mat), material_total: num(i.matT),
          labor_cost: num(i.lab), labor_total: num(i.labT),
          amount: num(i.amt),
          is_subtotal_row: i.sub || false, temp_category_id: c.tid };
      });
    }));
    return {
      document: {
        document_type_id: $('docType').value,
        customer_id: cid, status: 'draft', language: 'th',
        issue_date: $('issueDate').value,
        due_date: $('dueDate').value || null,
        reference_po: $('refPO').value || null,
        payment_condition: $('payCond').value || null,
        notes: $('docNotes').value || null,
        discount_design: num($('dD').value),
        discount_trade: num($('dT').value),
        apply_wht: $('applyWht').checked,
      },
      skipBOQ: !boqModified,
      categories: boqModified ? cats.map(function(c, i){ return { temp_id: c.tid, category_number: c.num, name_th: c.name || 'หมวดที่ ' + c.num, sort_order: i }; }) : [],
      items: boqModified ? items : []
    };
  }
  function setBusy(on) {
    busy = on;
    document.querySelectorAll('[data-save],#mConfirm').forEach(function(b){ b.disabled = on; });
  }
  async function doSave(p) {
    if (busy) return null;
    setBusy(true);
    toast('กำลังบันทึก...', false, true);
    try {
      var res = await fetch(location.pathname, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(p) });
      var data = await res.json();
      if (!res.ok) throw new Error(data.error || 'เกิดข้อผิดพลาด');
      dirty = false; lastSaved = data;
      $('state').className = 'state ok';
      $('stateTxt').textContent = 'บันทึกแล้ว ' + new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
      toast('บันทึกแล้ว ' + data.document_number);
      setBusy(false);
      return data;
    } catch (e) { setBusy(false); toast(e.message, true); return null; }
  }

  /* What changed, for the confirm dialog */
  function changeList() {
    var out = [], seen = {};
    cats.forEach(function(c){
      (ibc[c.tid]||[]).forEach(function(i){
        if (i.sub) return;
        var o = orig[i.id]; seen[i.id] = 1;
        if (!o) { out.push({ k: 'add', t: 'เพิ่ม', d: (i.desc || 'รายการใหม่') + ' · ' + baht(i.amt) }); return; }
        var parts = [];
        if (o.desc !== i.desc) parts.push('ชื่อรายการ');
        if (o.qty !== num(i.qty)) parts.push('จำนวน ' + o.qty + ' เป็น ' + num(i.qty));
        if (o.mat !== num(i.mat)) parts.push('ค่าวัสดุ ' + fmt(o.mat) + ' เป็น ' + fmt(num(i.mat)));
        if (o.lab !== num(i.lab)) parts.push('ค่าแรง ' + fmt(o.lab) + ' เป็น ' + fmt(num(i.lab)));
        if (!usesCost(i) && o.up !== num(i.price)) parts.push('ราคา/หน่วย ' + fmt(o.up) + ' เป็น ' + fmt(num(i.price)));
        if (parts.length) out.push({ k: 'chg', t: 'แก้ไข', d: (i.desc || 'รายการ') + ': ' + parts.join(', ') });
      });
    });
    Object.keys(orig).forEach(function(id){ if (!seen[id]) out.push({ k: 'del', t: 'ลบ', d: (orig[id].desc || 'รายการ') + ' · ' + baht(orig[id].amt) }); });
    return out;
  }
  function openConfirm(mode) {
    var t = totals();
    var pc = $('payCond').value.split('\n').map(function(l){ return l.trim(); }).filter(Boolean);
    var html = '<div class="kv"><span>ยอดรวมเดิม</span><span>' + baht(D.orig.total) + '</span></div>'
      + '<div class="kv"><span>ยอดรวมใหม่</span><span>' + baht(t.tot) + '</span></div>'
      + (t.wht ? '<div class="kv"><span>ยอดโอนสุทธิ</span><span>' + baht(t.net) + '</span></div>' : '')
      + '<div class="kv"><span>เงื่อนไขชำระเงิน</span><span>' + (pc.length ? esc(pc[0]) + (pc.length > 1 ? ' และอีก ' + (pc.length - 1) + ' งวด' : '') : '—') + '</span></div>';
    if (!boqModified) {
      html += '<div class="chg-t">รายการงาน</div><div class="chg">ไม่มีการเปลี่ยนแปลง</div>';
    } else {
      var ch = changeList(), catsChanged = cats.map(function(c){ return c.name; }).join('|') !== origCats;
      html += '<div class="chg-t">รายการงานที่เปลี่ยน</div>';
      if (!ch.length) html += '<div class="chg">' + (catsChanged ? 'เปลี่ยนชื่อหรือลำดับหมวดงาน' : 'ไม่มีการเปลี่ยนแปลงยอด') + '</div>';
      html += ch.slice(0, 8).map(function(c){ return '<div class="chg ' + c.k + '"><span class="k">' + c.t + '</span>' + esc(c.d) + '</div>'; }).join('');
      if (ch.length > 8) html += '<div class="chg">และอีก ' + (ch.length - 8) + ' รายการ</div>';
    }
    $('mBody').innerHTML = html;
    $('mConfirm').setAttribute('data-mode', mode);
    $('confirmModal').classList.add('show');
    $('mConfirm').focus();
  }
  function closeConfirm() { $('confirmModal').classList.remove('show'); }
  $('confirmModal').addEventListener('click', function(e){ if (e.target === this || e.target.closest('[data-close]')) closeConfirm(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeConfirm(); });
  var pending = null;
  $('mConfirm').addEventListener('click', async function(){
    var p = pending; if (!p) { closeConfirm(); return; }
    closeConfirm();
    var r = await doSave(p);
    if (r && r.id) location.href = '/documents/' + r.id;
  });

  async function save(mode) {
    if (busy) return;
    var p = build(); if (!p) return;
    if (mode === 'open') { pending = p; openConfirm(mode); return; }
    var r = await doSave(p);
    if (r && r.id && mode === 'preview') window.open('/documents/' + r.id + '/print', '_blank');
  }
  document.querySelectorAll('[data-save]').forEach(function(b){
    b.addEventListener('click', function(){ save(b.getAttribute('data-save')); });
  });

  var tTimer;
  function toast(msg, err, loading) {
    var t = $('toast');
    $('tMsg').textContent = msg;
    t.className = 'toast show' + (err ? ' err' : '') + (loading ? ' loading' : '');
    clearTimeout(tTimer);
    if (!loading) tTimer = setTimeout(function(){ t.className = 'toast'; }, 3500);
  }

  /* ── Start ── */
  var startBtn = document.querySelector('#typeSeg button.on') || document.querySelector('#typeSeg button');
  if (startBtn) setType(startBtn, false);
  var c0 = custById[$('custId').value];
  if (c0) pickCust(c0, false); else $('picker').style.display = '';
  render();
  cats.forEach(function(c){ refreshSubs(c.tid); }); // subtotal rows always show their category's sum
  recalc();
  dirty = false;
  $('state').className = 'state'; $('stateTxt').textContent = 'ยังไม่มีการเปลี่ยนแปลง';
})();
</script>
</body>
</html>
